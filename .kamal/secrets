# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Option 1: Read secrets from the environment
# KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Option 2: Read secrets via a command
# RAILS_MASTER_KEY=$(cat config/master.key)
# KAMAL_REGISTRY_PASSWORD=$(rails credentials:fetch kamal.registry_password)

# Option 3: Read secrets via kamal secrets helpers
# These will handle logging in and fetching the secrets in as few calls as possible
# There are adapters for 1Password, LastPass + Bitwarden
#
# SECRETS=$(kamal secrets fetch --adapter 1password --account my-account --from MyVault/MyItem KAMAL_REGISTRY_PASSWORD RAILS_MASTER_KEY)
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
# RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)

# Use a GITHUB_TOKEN if private repositories are needed for the image
GITHUB_TOKEN=$(gh config get -h github.com oauth_token)

KAMAL_SECRETS=$(kamal secrets fetch --adapter bitwarden-sm $BWS_PROJECT_ID/all)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${KAMAL_SECRETS})

RAILS_MASTER_KEY=$(cat config/master.key)

SSL_KITCHEF_MX_CERT_FILE=$(cat ssl/kitchef.mx.pem)
SSL_KITCHEF_MX_KEY_FILE=$(cat ssl/kitchef.mx.key)

POSTGRES_HOST=$(kamal secrets extract POSTGRES_HOST ${KAMAL_SECRETS})
POSTGRES_USER=$(kamal secrets extract POSTGRES_USER ${KAMAL_SECRETS})
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD ${KAMAL_SECRETS})
POSTGRES_DB=$(kamal secrets extract POSTGRES_DB ${KAMAL_SECRETS})

DATABASE_URL=$(kamal secrets extract DATABASE_URL ${KAMAL_SECRETS})

VALKEY_URL=$(kamal secrets extract VALKEY_URL ${KAMAL_SECRETS})

IP_INFO_API_KEY=$(kamal secrets extract IP_INFO_API_KEY ${KAMAL_SECRETS})

GOOGLE_API_KEY=$(kamal secrets extract GOOGLE_API_KEY ${KAMAL_SECRETS})

CLOUDFLARE_TOKEN=$(kamal secrets extract CLOUDFLARE_TOKEN ${KAMAL_SECRETS})
CLOUDFLARE_ENDPOINT=$(kamal secrets extract CLOUDFLARE_ENDPOINT ${KAMAL_SECRETS})
CLOUDFLARE_ACCESS_KEY_ID=$(kamal secrets extract CLOUDFLARE_ACCESS_KEY_ID ${KAMAL_SECRETS})
CLOUDFLARE_SECRET_ACCESS_KEY=$(kamal secrets extract CLOUDFLARE_SECRET_ACCESS_KEY ${KAMAL_SECRETS})
CLOUDFLARE_BUCKET=$(kamal secrets extract CLOUDFLARE_BUCKET ${KAMAL_SECRETS})

SMTP_USER_NAME=$(kamal secrets extract SMTP_USER_NAME ${KAMAL_SECRETS})
SMTP_PASSWORD=$(kamal secrets extract SMTP_PASSWORD ${KAMAL_SECRETS})
SMTP_ADDRESS=$(kamal secrets extract SMTP_ADDRESS ${KAMAL_SECRETS})
SMTP_HOST=$(kamal secrets extract SMTP_HOST ${KAMAL_SECRETS})
SMTP_PORT=$(kamal secrets extract SMTP_PORT ${KAMAL_SECRETS})
