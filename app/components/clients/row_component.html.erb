<tr class="border-b border-line last:border-b-0 hover:bg-bg-2/40 transition-colors">
  <td class="px-4 py-3">
    <%= helpers.drawer_link_to name, edit_path,
          class: "text-[14px] font-medium text-ink hover:underline" %>
    <% if client.email.present? %>
      <div class="text-[12px] text-muted truncate"><%= client.email %></div>
    <% end %>
  </td>
  <td class="px-4 py-3 font-mono text-[13px] text-ink-2 whitespace-nowrap">
    <%= phone_display %>
  </td>
  <td class="px-4 py-3 text-[13px] text-ink-2">
    <%= client.colonia.presence %>
    <% if client.city.present? %>
      <span class="text-muted">· <%= client.city %></span>
    <% end %>
  </td>
  <td class="px-4 py-3 font-mono text-[13px] text-muted text-right">
    <%= t("clients.index.orders_count", count: orders_count) %>
  </td>
  <td class="px-4 py-3 text-right">
    <div class="inline-flex items-center gap-1">
      <%= helpers.drawer_link_to edit_path,
            aria: { label: t("clients.row.edit") },
            title: t("clients.row.edit"),
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-ink hover:border-line transition-colors" do %>
        <%= helpers.icon(:pencil, size: :sm) %>
      <% end %>

      <%= button_to helpers.client_path(client),
            method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: t("clients.form.delete_confirm") } },
            aria: { label: t("clients.row.delete") },
            title: t("clients.row.delete"),
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-err hover:border-err/40 transition-colors" do %>
        <%= helpers.icon(:trash_2, size: :sm) %>
      <% end %>
    </div>
  </td>
</tr>
