<div class="flex flex-col gap-2"
     data-controller="combobox"
     data-combobox-create-value="<%= create_json %>"
     data-combobox-csrf-value="<%= form_authenticity_token %>">
  <% if label.present? %>
    <label for="<%= input_id %>-search" class="text-[13px] font-medium text-ink leading-none">
      <%= label %>
      <% if required %><span class="text-err" aria-hidden="true">*</span><% end %>
    </label>
  <% end %>

  <div class="relative">
    <div class="relative flex items-center">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
        <%= helpers.icon(:search, size: :xs) %>
      </span>
      <input type="text"
             id="<%= input_id %>-search"
             data-combobox-target="search"
             data-action="focus->combobox#open input->combobox#filter keydown->combobox#keydown"
             role="combobox"
             aria-autocomplete="list"
             aria-expanded="false"
             aria-controls="<%= list_dom_id %>"
             placeholder="<%= placeholder %>"
             value="<%= selected_label %>"
             autocomplete="off"
             <%= "autofocus" if autofocus %>
             class="w-full bg-surface text-ink placeholder:text-muted border border-line hover:border-line-2 rounded-input pl-9 pr-10 py-2.5 text-[14px] leading-[1.3] transition-[border-color,box-shadow] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
      <button type="button"
              data-action="click->combobox#toggle"
              data-combobox-target="toggle"
              aria-label="<%= t("ui.combobox.toggle") %>"
              class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-7 h-7 rounded-input text-muted hover:text-ink hover:bg-bg-2/60 transition-colors">
        <%= helpers.icon(:chevron_down, size: :xs) %>
      </button>
    </div>

    <input type="hidden"
           name="<%= name %>"
           id="<%= input_id %>"
           data-combobox-target="value"
           value="<%= selected_id %>"
           <%= "required" if required %>>

    <ul id="<%= list_dom_id %>"
        data-combobox-target="list"
        role="listbox"
        hidden
        class="absolute z-20 left-0 right-0 top-full mt-1.5 max-h-64 overflow-y-auto bg-surface border border-line rounded-input shadow-lift kc-scroll">
      <datalist data-combobox-target="options" id="<%= list_dom_id %>-data" hidden>
        <% options.each do |option_label, option_id| %>
          <option value="<%= option_id %>" data-label="<%= option_label %>"><%= option_label %></option>
        <% end %>
      </datalist>
      <% options.each_with_index do |(option_label, option_id), idx| %>
        <li role="option"
            id="<%= list_dom_id %>-opt-<%= option_id %>"
            data-combobox-target="item"
            data-value="<%= option_id %>"
            data-label="<%= option_label %>"
            aria-selected="<%= option_id.to_s == selected_id ? "true" : "false" %>"
            tabindex="-1"
            data-action="mousedown->combobox#pickEvent"
            class="flex items-center justify-between gap-3 px-3.5 py-2.5 text-[14px] text-ink cursor-pointer hover:bg-bg-2/60 aria-selected:bg-accent-soft aria-selected:text-accent data-[highlighted]:bg-accent-soft data-[highlighted]:text-accent">
          <span class="truncate"><%= option_label %></span>
          <span class="hidden aria-selected:inline text-accent">
            <%= helpers.icon(:check, size: :xs) %>
          </span>
        </li>
      <% end %>
      <li data-combobox-target="empty"
          role="option"
          aria-disabled="true"
          hidden
          class="px-3.5 py-2.5 text-[13px] text-muted italic">
        <%= t("ui.combobox.empty") %>
      </li>
      <% if create_path.present? %>
        <li data-combobox-target="create"
            role="option"
            hidden
            data-action="mousedown->combobox#createEvent"
            class="flex items-center justify-between gap-3 px-3.5 py-2.5 text-[14px] text-accent font-medium cursor-pointer hover:bg-accent-soft border-t border-line">
          <span class="flex items-center gap-2">
            <%= helpers.icon(:plus, size: :xs) %>
            <span data-combobox-target="createLabel"><%= t("ui.combobox.create_prefix") %></span>
          </span>
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">↵</span>
        </li>
      <% end %>
    </ul>
  </div>

  <% if error.present? %>
    <span class="text-[12px] text-err font-medium"><%= error %></span>
  <% elsif hint.present? %>
    <span class="text-[12px] text-muted"><%= hint %></span>
  <% end %>
</div>
