<section class="flex flex-col gap-4">
  <header class="flex items-baseline justify-between gap-3">
    <div class="flex flex-col gap-1">
      <span class="font-mono text-[11.5px] font-medium tracking-[0.18em] uppercase text-accent">
        <%= kicker %>
      </span>
      <h2 class="font-serif text-[22px] leading-[1.15] text-ink"><%= headline %></h2>
    </div>

    <% unless empty? %>
      <div data-controller="copy-to-clipboard"
           data-copy-to-clipboard-success-label-value="<%= t("production.handoff_list.share_success") %>"
           data-copy-to-clipboard-value-value="<%= runner_url(helpers) %>"
           class="inline-flex items-center gap-2">
        <button type="button"
                data-action="copy-to-clipboard#copy"
                data-copy-to-clipboard-target="button"
                class="inline-flex items-center gap-2 text-[12.5px] font-medium px-3 py-[7px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors">
          <%= helpers.icon(:share, size: :xs) %>
          <span><%= t("production.handoff_list.share_cta") %></span>
        </button>
      </div>
    <% end %>
  </header>

  <% if empty? %>
    <p class="text-muted text-[14px]"><%= t("production.handoff_list.empty") %></p>
  <% else %>
    <ul class="flex flex-col divide-y divide-line rounded-card border border-line bg-surface">
      <% plan.handoffs.each do |order| %>
        <li class="flex flex-col gap-2 px-4 py-3">
          <div class="flex items-start justify-between gap-3">
            <div class="flex flex-col gap-0.5 min-w-0">
              <div class="flex items-baseline gap-2">
                <span class="text-[15px] text-ink font-medium truncate">
                  <%= order.client&.name.presence || t("dashboard.today_orders.empty_client") %>
                </span>
                <span class="font-mono text-[10px] text-muted/70 tracking-[0.08em]">
                  #<%= order.prefix_id.sub(/\Aord_/, "") %>
                </span>
              </div>
              <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted">
                <% if order.delivery_start_time.present? %>
                  <%= order.delivery_start_time_hhmm %><%= order.delivery_end_time.present? ? "–#{order.delivery_end_time_hhmm}" : "" %>
                <% else %>
                  <%= t("production.handoff_list.no_window") %>
                <% end %>
              </span>
            </div>
            <%= render Orders::StateBadgeComponent.new(state: order.state) %>
          </div>

          <% if order.delivery_address.present? || order.colonia.present? %>
            <p class="text-[13px] text-ink-2 leading-[1.4]">
              <%= [ order.delivery_address, order.colonia, order.city ].compact_blank.join(" · ") %>
            </p>
          <% end %>

          <div class="flex items-center gap-2 pt-1">
            <% if order.geocoded? %>
              <%= link_to directions_url_for(order),
                    target: "_blank",
                    rel: "noopener noreferrer",
                    class: "inline-flex items-center gap-1.5 text-[12px] font-medium px-3 py-[6px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" do %>
                <%= helpers.icon(:navigation, size: :xs) %>
                <span><%= t("orders.map.directions_cta") %></span>
              <% end %>
            <% end %>

            <% if (primary = primary_transition_for(order)) %>
              <%= button_to helpers.public_send("#{primary}_order_path", order),
                    method: :post,
                    form: { class: "inline-flex" },
                    class: "inline-flex items-center gap-1.5 text-[12px] font-semibold px-3 py-[6px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors" do %>
                <span><%= t("orders.transitions.#{primary}") %></span>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
