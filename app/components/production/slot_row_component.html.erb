<article class="flex flex-col gap-3 rounded-card border border-line bg-surface p-4">
  <header class="flex items-baseline justify-between gap-3">
    <span class="font-serif text-[18px] text-ink"><%= day_label %></span>
    <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      <%= capacity_label %>
    </span>
  </header>

  <% if slot %>
    <%= form_with model: slot,
          url: delivery_slot_path(slot),
          method: :patch,
          html: { class: "flex flex-col gap-3" } do |f| %>
      <div class="grid grid-cols-[1fr_1fr_1fr] gap-3">
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.start_time_label") %>
          </span>
          <%= f.time_field :start_time_hhmm,
                value: start_hhmm,
                class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono" %>
        </label>
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.end_time_label") %>
          </span>
          <%= f.time_field :end_time_hhmm,
                value: end_hhmm,
                class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono" %>
        </label>
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.capacity_label") %>
          </span>
          <%= f.number_field :capacity,
                value: capacity,
                min: 1,
                placeholder: t("delivery_slots.form.capacity_placeholder"),
                class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono" %>
        </label>
      </div>
      <div class="flex items-center justify-between gap-3">
        <button type="submit"
                class="inline-flex items-center gap-1.5 text-[12.5px] font-semibold px-3 py-[7px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta">
          <%= t("delivery_slots.form.save") %>
        </button>
        <%= button_to delivery_slot_path(slot),
              method: :delete,
              form: { class: "inline-flex", data: { turbo_confirm: t("delivery_slots.form.destroy_confirm", day: day_label) } },
              class: "inline-flex items-center gap-1 text-[12px] text-muted hover:text-err transition-colors" do %>
          <%= t("delivery_slots.form.close_day") %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= form_with url: delivery_slots_path,
          method: :post,
          html: { class: "flex flex-col gap-3" } do |f| %>
      <%= f.hidden_field :day_of_week, value: day_of_week %>
      <div class="grid grid-cols-[1fr_1fr_1fr] gap-3">
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.start_time_label") %>
          </span>
          <input type="time"
                 name="delivery_slot[start_time_hhmm]"
                 value="09:00"
                 class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono">
        </label>
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.end_time_label") %>
          </span>
          <input type="time"
                 name="delivery_slot[end_time_hhmm]"
                 value="13:00"
                 class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono">
        </label>
        <label class="flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("delivery_slots.form.capacity_label") %>
          </span>
          <input type="number"
                 name="delivery_slot[capacity]"
                 min="1"
                 placeholder="<%= t("delivery_slots.form.capacity_placeholder") %>"
                 class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono">
        </label>
      </div>
      <button type="submit"
              class="inline-flex items-center gap-1.5 text-[12.5px] font-semibold px-3 py-[7px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta self-start">
        <%= t("delivery_slots.form.create_for_day", day: day_label) %>
      </button>
    <% end %>
  <% end %>
</article>
