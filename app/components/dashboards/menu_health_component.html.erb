<%= link_to recipes_path,
      class: "block p-5 rounded-card bg-surface border border-line shadow-card hover:border-line-2 transition" do %>
  <div class="flex flex-col gap-3">
    <div class="flex items-start justify-between gap-3">
      <%= render Ui::KickerComponent.new(text: t("dashboard.menu_health.kicker")) %>
      <span class="font-mono text-[12px] font-medium text-accent whitespace-nowrap pt-1">
        <%= t("dashboard.menu_health.see_all") %> <span aria-hidden="true">&rarr;</span>
      </span>
    </div>

    <div class="flex items-baseline gap-3 flex-wrap">
      <h3 class="font-serif text-[20px] leading-[1.2] text-ink">
        <%= t("dashboard.menu_health.title") %>
      </h3>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-accent-soft text-accent text-[11.5px] font-medium">
          <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
          <%= t("dashboard.menu_health.published", count: published_count) %>
        </span>
        <% if draft_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-bg-2 text-muted border border-line text-[11.5px] font-medium">
            <%= t("dashboard.menu_health.drafts", count: draft_count) %>
          </span>
        <% end %>
      </div>
    </div>

    <% if top_sellers.any? %>
      <div class="flex items-center gap-4 flex-wrap pt-1">
        <span class="font-mono text-[11px] text-muted uppercase tracking-[0.14em]">
          <%= t("dashboard.menu_health.top_sellers_label") %>
        </span>
        <div class="flex items-center gap-3 flex-wrap">
          <% top_sellers.each do |recipe, qty| %>
            <span class="inline-flex items-baseline gap-1.5 text-[13px]">
              <span class="text-ink font-medium"><%= recipe.name %></span>
              <span class="font-mono text-[12px] text-muted tabular-nums">(<%= qty %>)</span>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
