<%= link_to production_path,
      class: "block p-5 rounded-card bg-surface border border-line shadow-card hover:border-line-2 transition h-full" do %>
  <div class="flex flex-col gap-3 h-full">
    <div class="flex items-start justify-between gap-3">
      <%= render Ui::KickerComponent.new(text: t("dashboard.today_card.kicker")) %>
      <span class="font-mono text-[12px] font-medium text-accent whitespace-nowrap pt-1">
        <%= t("dashboard.today_card.see_all") %> <span aria-hidden="true">&rarr;</span>
      </span>
    </div>

    <div class="flex items-baseline gap-2">
      <span class="font-serif text-[28px] leading-[1.05] tracking-tight text-ink">
        <%= l(today, format: :long) %>
      </span>
    </div>

    <% if empty? %>
      <p class="text-[13.5px] text-muted flex-1">
        <%= t("dashboard.today_card.empty") %>
      </p>
    <% else %>
      <div class="flex items-baseline gap-2 mb-1">
        <span class="font-mono text-[13px] text-muted tabular-nums">
          <%= t("dashboard.today_card.total", count: total_count) %>
        </span>
      </div>

      <div class="flex flex-wrap gap-2">
        <% if placed_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-[var(--color-status-nuevo-bg)] text-[var(--color-status-nuevo-fg)] text-[11.5px] font-medium">
            <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
            <%= placed_count %> <%= t("dashboard.today_card.placed") %>
          </span>
        <% end %>
        <% if confirmed_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-bg-2 text-ink-2 border border-line text-[11.5px] font-medium">
            <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
            <%= confirmed_count %> <%= t("dashboard.today_card.confirmed") %>
          </span>
        <% end %>
        <% if cooking_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-[var(--color-status-en-produccion-bg)] text-[var(--color-status-en-produccion-fg)] text-[11.5px] font-medium">
            <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
            <%= cooking_count %> <%= t("dashboard.today_card.cooking") %>
          </span>
        <% end %>
        <% if ready_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-accent-soft text-accent text-[11.5px] font-medium">
            <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
            <%= ready_count %> <%= t("dashboard.today_card.ready") %>
          </span>
        <% end %>
        <% if delivered_count.positive? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-pill bg-accent-soft text-accent text-[11.5px] font-medium">
            <span class="w-[5px] h-[5px] rounded-full bg-current"></span>
            <%= delivered_count %> <%= t("dashboard.today_card.delivered") %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
