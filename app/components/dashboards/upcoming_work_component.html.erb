<%= link_to cta_path,
      class: "block p-5 rounded-card bg-surface border border-line shadow-card hover:border-line-2 transition h-full" do %>
  <div class="flex flex-col gap-3 h-full">
    <div class="flex items-start justify-between gap-3">
      <%= render Ui::KickerComponent.new(text: advanced? ? t("dashboard.upcoming_work.kicker_pro") : t("dashboard.upcoming_work.kicker")) %>
      <span class="font-mono text-[12px] font-medium text-accent whitespace-nowrap pt-1">
        <%= t("dashboard.upcoming_work.see_all") %> <span aria-hidden="true">&rarr;</span>
      </span>
    </div>

    <h3 class="font-serif text-[20px] leading-[1.2] text-ink">
      <%= advanced? ? t("dashboard.upcoming_work.title_pro") : t("dashboard.upcoming_work.title") %>
    </h3>

    <% if empty? %>
      <p class="text-[13.5px] text-muted flex-1">
        <%= t("dashboard.upcoming_work.empty") %>
      </p>
    <% else %>
      <%# Top rows — recipe-level or ingredient-level depending on mode %>
      <ul class="flex flex-col gap-1.5 flex-1">
        <% rows.each do |row| %>
          <li class="flex items-baseline justify-between gap-3 <%= row.all_done ? 'opacity-50' : '' %>">
            <span class="text-[13.5px] text-ink truncate">
              <%= advanced? ? row.ingredient_name : row.recipe_name %>
            </span>
            <span class="font-mono text-[12.5px] text-muted shrink-0 tabular-nums">
              <%= row.display_qty %> <%= t("units.#{row.unit}", default: row.unit) %>
            </span>
          </li>
        <% end %>
        <% if remaining_count.positive? %>
          <li class="text-[12.5px] text-muted">
            + <%= remaining_count %> <%= t("dashboard.upcoming_work.more") %>
          </li>
        <% end %>
      </ul>

      <%# Pro: estimated cost + alerts %>
      <% if advanced? %>
        <% cost = estimated_cost_cents %>
        <% if cost && cost.positive? %>
          <div class="flex items-baseline gap-2 pt-2 border-t border-line/60">
            <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
              <%= t("dashboard.upcoming_work.estimated_cost") %>
            </span>
            <span class="font-serif text-[18px] text-ink tabular-nums">
              <%= helpers.humanized_money_with_symbol(Money.new(cost, "MXN")) %>
            </span>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# Inventory alerts (Pro only) %>
    <% if has_alerts? %>
      <div class="flex flex-col gap-1.5 pt-2 border-t border-warn/30">
        <% low_stock_ingredients.first(3).each do |ing| %>
          <div class="flex items-center gap-2 text-[12.5px]">
            <span class="w-[6px] h-[6px] rounded-full bg-warn shrink-0"></span>
            <span class="text-warn-ink truncate">
              <%= ing.name %> — <%= t("dashboard.upcoming_work.low_stock") %>
            </span>
          </div>
        <% end %>
        <% if low_stock_ingredients.size > 3 %>
          <span class="text-[12px] text-muted">
            + <%= low_stock_ingredients.size - 3 %> <%= t("dashboard.upcoming_work.more_alerts") %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
