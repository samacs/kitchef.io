<%
  pro = catalog.pro
  free = catalog.free
%>
<div data-controller="pricing-toggle"
     data-pricing-toggle-default-value="<%= default_period %>"
     class="flex flex-col gap-7">

  <%# ── Mensual / Anual toggle ─────────────────────────────────────── %>
  <div class="mx-auto inline-flex items-center gap-1 p-1 rounded-pill border border-line bg-bg-2">
    <button type="button"
            data-pricing-toggle-target="toggleMonthly"
            data-action="click->pricing-toggle#selectMonthly"
            data-active="<%= default_period == :monthly %>"
            aria-pressed="<%= default_period == :monthly %>"
            class="kc-pricing-toggle px-4 py-1.5 rounded-pill text-[12.5px] font-medium transition-colors">
      <%= t("marketing.pricing_cards.toggle.monthly") %>
    </button>
    <button type="button"
            data-pricing-toggle-target="toggleYearly"
            data-action="click->pricing-toggle#selectYearly"
            data-active="<%= default_period == :yearly %>"
            aria-pressed="<%= default_period == :yearly %>"
            class="kc-pricing-toggle inline-flex items-center gap-1.5 px-4 py-1.5 rounded-pill text-[12.5px] font-medium transition-colors">
      <%= t("marketing.pricing_cards.toggle.yearly") %>
      <span class="font-mono text-[10.5px] uppercase tracking-[0.06em] text-accent">
        <%= t("marketing.pricing_cards.toggle.savings_chip") %>
      </span>
    </button>
  </div>

  <%# ── Cards ──────────────────────────────────────────────────────── %>
  <div class="<%= container_classes %>">
    <%# Free tier %>
    <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5">
      <div class="flex justify-between items-center">
        <div class="font-serif text-[24px] tracking-tight"><%= t("marketing.pricing_cards.free.name") %></div>
      </div>
      <p class="text-[13.5px] text-muted leading-[1.5]"><%= t("marketing.pricing_cards.free.desc") %></p>

      <div class="flex flex-col gap-1 py-2.5 border-t border-b border-line">
        <div class="flex items-baseline gap-1.5">
          <div class="font-serif text-[54px] tracking-tight leading-none"><%= free[:amount] %></div>
          <div class="text-[12px] text-muted font-mono"><%= free[:period] %></div>
        </div>
        <div class="text-[11.5px] text-muted font-mono"><%= free[:billed_note] %></div>
      </div>

      <ul class="flex flex-col gap-2.5 my-1">
        <% free_features.each do |feat| %>
          <li class="flex items-start gap-[9px] text-[13.5px] text-ink-2 leading-[1.4]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <%= feat %>
          </li>
        <% end %>
      </ul>

      <%= link_to t("marketing.pricing_cards.free.cta"), free_cta_path,
            class: "inline-flex items-center justify-center w-full gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-surface text-ink border border-line hover:border-line-2 transition-colors mt-auto" %>
    </div>

    <%# Pro tier %>
    <div class="kc-price-pop border rounded-[16px] p-7 flex flex-col gap-3.5 relative">
      <div class="flex justify-between items-center">
        <div class="font-serif text-[24px] tracking-tight"><%= t("marketing.pricing_cards.pro.name") %></div>
        <span class="font-mono text-[10px] tracking-[0.12em] uppercase px-[9px] py-1 rounded-pill bg-accent text-bg">
          <%= t("marketing.pricing_cards.pro.tag") %>
        </span>
      </div>
      <p class="text-[13.5px] opacity-75 leading-[1.5]"><%= t("marketing.pricing_cards.pro.desc") %></p>

      <div class="flex flex-col gap-1 py-2.5 border-t border-b border-white/15 dark:border-accent/25">
        <div class="flex items-baseline gap-1.5">
          <div class="font-serif text-[54px] tracking-tight leading-none"
               data-pricing-toggle-target="priceAmount"
               data-monthly="<%= pro[:monthly][:amount] %>"
               data-yearly="<%= pro[:yearly][:amount] %>">
            <%= pro[default_period][:amount] %>
          </div>
          <div class="text-[12px] opacity-75 font-mono"
               data-pricing-toggle-target="pricePeriod"
               data-monthly="<%= pro[:monthly][:period] %>"
               data-yearly="<%= pro[:yearly][:period] %>">
            <%= pro[default_period][:period] %>
          </div>
        </div>
        <div class="text-[11.5px] opacity-75 font-mono"
             data-pricing-toggle-target="pricePeriod"
             data-monthly="<%= pro[:monthly][:billed_note] %>"
             data-yearly="<%= pro[:yearly][:billed_note] %>">
          <%= pro[default_period][:billed_note] %>
        </div>
        <div class="<%= "hidden" unless default_period == :yearly %> inline-flex items-center gap-1.5 mt-1 self-start"
             data-pricing-toggle-target="savingsBadge">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.08em] px-2 py-px rounded-pill bg-accent/15 text-accent-2 dark:text-accent">
            <%= t("marketing.pricing_cards.pro.savings_badge", pct: catalog.yearly_savings_pct) %>
          </span>
        </div>
      </div>

      <ul class="flex flex-col gap-2.5 my-1">
        <% pro_features.each do |feat| %>
          <li class="flex items-start gap-[9px] text-[13.5px] opacity-85 leading-[1.4]">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent-2 shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <%= feat %>
          </li>
        <% end %>
      </ul>

      <div class="flex flex-col gap-2 mt-auto">
        <%= link_to t("marketing.pricing_cards.pro.cta"), pro_cta_path,
              class: "inline-flex items-center justify-center w-full gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-bg text-ink border border-bg hover:bg-accent-2 hover:text-bg hover:border-accent-2 transition-colors" %>
        <p class="text-center text-[11.5px] opacity-75 font-mono">
          <%= t("marketing.pricing_cards.pro.no_card_note") %>
        </p>
      </div>
    </div>
  </div>

  <% if show_compare_cta? %>
    <div class="text-center">
      <%= link_to pricing_path,
            class: "inline-flex items-center gap-1.5 text-[13.5px] font-medium text-ink-2 hover:text-ink underline-offset-4 hover:underline" do %>
        <%= t("marketing.pricing_cards.compare_cta") %>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      <% end %>
    </div>
  <% end %>
</div>
