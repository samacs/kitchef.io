<div class="border-b border-warn/40 bg-[color-mix(in_oklab,var(--color-warn)_12%,var(--color-bg))]">
  <div class="mx-auto max-w-[1240px] px-5 py-2.5 flex items-center gap-3">
    <span class="inline-flex h-[24px] w-[24px] items-center justify-center rounded-full bg-warn/25 text-warn-ink shrink-0">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </span>
    <div class="flex flex-col sm:flex-row sm:items-baseline gap-x-3 gap-y-0.5 min-w-0">
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-warn-ink shrink-0">
        <%= title %>
      </span>
      <span class="text-[12.5px] text-ink-2 leading-[1.4]">
        <%= body %>
      </span>
    </div>
  </div>
</div>
