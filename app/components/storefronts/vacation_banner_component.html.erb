<div class="border-b border-warn/30 bg-[color-mix(in_oklab,var(--color-warn)_8%,var(--color-bg))]">
  <div class="mx-auto max-w-[1200px] px-5 py-4 flex items-start gap-3">
    <span class="inline-flex h-[28px] w-[28px] items-center justify-center rounded-full bg-warn/20 text-warn-ink shrink-0">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
    </span>
    <div class="flex flex-col gap-0.5 min-w-0">
      <div class="font-serif text-[18px] sm:text-[20px] text-ink leading-[1.15]">
        <%= heading %>
      </div>
      <div class="text-[13.5px] text-ink-2 leading-[1.5]">
        <%= body %>
      </div>
    </div>
  </div>
</div>
