<section class="mx-auto mt-16 max-w-[1200px] px-5">
  <div class="grid gap-[18px] md:grid-cols-2">
    <%# Horarios card %>
    <div class="rounded-[16px] border border-line bg-surface p-6">
      <div class="mb-4 flex items-center gap-2.5">
        <span class="inline-flex h-[34px] w-[34px] items-center justify-center rounded-[10px]"
              style="background: var(--brand-1-soft); color: var(--brand-1);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
          </svg>
        </span>
        <div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("storefronts.info_strip.hours_kicker") %>
          </div>
          <h3 class="font-serif text-[22px] leading-[1.1] tracking-tight text-ink">
            <%= t("storefronts.info_strip.hours_title") %>
          </h3>
        </div>
      </div>

      <% if schedule_rows %>
        <div>
          <% schedule_rows.each_with_index do |(label, value), idx| %>
            <div class="flex justify-between py-2 <%= 'border-b border-line' if idx < 6 %>">
              <span class="text-[13px] font-medium text-ink"><%= label %></span>
              <span class="text-[13px] font-mono <%= value == 'Cerrado' ? 'text-muted' : 'text-ink-2' %>"><%= value %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-[13px] leading-[1.55] text-ink-2">
          <%= t("storefronts.info_strip.hours_empty") %>
        </p>
      <% end %>

      <% if ordering_hours %>
        <div class="mt-4">
          <%= render Storefronts::OrderingHoursChipComponent.new(result: ordering_hours) %>
        </div>
      <% end %>
    </div>

    <%# Entregas card — uses --brand-2 (secondary palette) to give the
        delivery-zones surface a complementary warm tone against the
        primary-colored hours card. Matches the design prototype's
        two-tone info strip. %>
    <div class="rounded-[16px] border border-line bg-surface p-6">
      <div class="mb-4 flex items-center gap-2.5">
        <span class="inline-flex h-[34px] w-[34px] items-center justify-center rounded-[10px]"
              style="background: var(--brand-2-soft); color: var(--brand-2);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
          </svg>
        </span>
        <div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("storefronts.info_strip.delivery_kicker") %>
          </div>
          <h3 class="font-serif text-[22px] leading-[1.1] tracking-tight text-ink">
            <%= t("storefronts.info_strip.delivery_title") %>
          </h3>
        </div>
      </div>

      <% if any_zones? %>
        <p class="mb-3 text-[13px] leading-[1.55] text-ink-2">
          <%= t("storefronts.info_strip.delivery_lede", city: city.presence || "tu zona") %>
        </p>
        <div class="flex flex-wrap gap-[7px]">
          <% delivery_zones_list.each do |zone| %>
            <span class="rounded-full px-3 py-1 text-[12px] font-medium"
                  style="background: var(--brand-2-soft); color: var(--brand-2); border: 1px solid var(--brand-2-line);">
              <%= zone %>
            </span>
          <% end %>
        </div>
      <% else %>
        <p class="text-[13px] leading-[1.55] text-ink-2">
          <%= t("storefronts.info_strip.delivery_empty") %>
        </p>
      <% end %>

      <% if phone.present? %>
        <div class="mt-4 flex items-center gap-3 rounded-[12px] border border-line bg-bg px-4 py-3">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-muted" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.8 12.8 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.8 12.8 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <div class="flex-1">
            <div class="text-[11px] font-medium uppercase tracking-[0.06em] text-muted">
              <%= t("storefronts.info_strip.call_us") %>
            </div>
            <div class="font-mono text-[14px] font-medium text-ink"><%= phone %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
