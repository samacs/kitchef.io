<ol class="flex flex-col gap-3">
  <% steps.each do |step| %>
    <li class="flex items-start gap-3">
      <% case step.status
         when :done %>
        <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full"
              style="background: var(--brand-1); color: var(--brand-1-ink);">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
        </span>
      <% when :current %>
        <span class="relative mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center">
          <span class="absolute inset-0 animate-ping rounded-full opacity-60"
                style="background: var(--brand-1);" aria-hidden="true"></span>
          <span class="relative h-3 w-3 rounded-full"
                style="background: var(--brand-1);" aria-hidden="true"></span>
        </span>
      <% else %>
        <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line bg-surface"></span>
      <% end %>

      <div class="min-w-0 flex-1">
        <div class="text-[14px] font-semibold <%= step.status == :pending ? 'text-muted' : 'text-ink' %>">
          <%= step.label %>
        </div>
        <% if step.status == :done && step.timestamp.present? %>
          <div class="font-mono text-[11.5px] text-muted">
            <%= l(step.timestamp.in_time_zone("America/Mexico_City"), format: :short) rescue step.timestamp %>
          </div>
        <% end %>
      </div>
    </li>
  <% end %>
</ol>
