<section class="relative bg-bg">
  <%# Cover image with a gradient fade into the page background. If no
      cover is attached, use a branded gradient tinted from --brand-1-soft. %>
  <div class="relative overflow-hidden" style="height: clamp(200px, 32vw, 360px);">
    <% if cover_image %>
      <%= image_tag cover_image.variant(:hero),
        class: "w-full h-full object-cover",
        alt: "" %>
    <% else %>
      <div class="w-full h-full" style="background: linear-gradient(135deg, var(--brand-1-soft), var(--color-bg-2));"></div>
    <% end %>
    <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, transparent 0%, transparent 55%, var(--color-bg) 100%);"></div>
  </div>

  <%# Logo + name + meta row. Logo sits 60px above the fade so it lands
      flush with the kitchen name. %>
  <div class="mx-auto max-w-[1200px] px-5" style="margin-top: -60px; position: relative;">
    <div class="flex flex-wrap items-end gap-5">
      <% if logo_image %>
        <div class="shrink-0 w-[120px] h-[120px] rounded-[18px] overflow-hidden bg-surface border-[3px] border-surface shadow-lift">
          <%= image_tag logo_image.variant(:card), class: "w-full h-full object-cover", alt: "" %>
        </div>
      <% else %>
        <div class="shrink-0 w-[120px] h-[120px] rounded-[18px] bg-surface border-[3px] border-surface shadow-lift inline-flex items-center justify-center"
             style="color: var(--brand-1);">
          <span class="font-serif italic text-[54px] leading-none"><%= name.first.upcase %></span>
        </div>
      <% end %>

      <div class="flex-1 min-w-[260px] mb-2">
        <h1 class="font-serif font-normal leading-[1.05] tracking-tight text-ink"
            style="font-size: clamp(28px, 4.2vw, 44px);">
          <%= name %>
        </h1>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-[13px] text-muted">
          <%= render Storefronts::OrderingHoursChipComponent.new(result: ordering_hours) %>
          <% if tagline.present? %>
            <span class="text-ink-2"><%= tagline %></span>
          <% end %>
          <% if location_line %>
            <span aria-hidden="true">·</span>
            <span><%= location_line %></span>
          <% end %>
          <% if instagram.present? %>
            <span aria-hidden="true">·</span>
            <a href="<%= instagram_url %>" target="_blank" rel="noopener" class="font-mono text-[12px] hover:text-ink">
              @<%= instagram.to_s.strip.sub(/\A@/, "") %>
            </a>
          <% end %>
        </div>
        <% if description.present? %>
          <p class="mt-4 max-w-[620px] text-[15px] leading-[1.55] text-ink-2"><%= description %></p>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-2 mb-2">
        <%# Smooth-scroll to the menu section without pushing `#menu`
            into the URL. The `href="#menu"` fallback keeps the link
            navigable if JS fails; the Stimulus controller
            preventDefaults the default jump. %>
        <a href="#menu"
           data-controller="smooth-scroll"
           data-action="click->smooth-scroll#to"
           class="inline-flex items-center gap-2 rounded-[9px] px-4 py-2.5 text-[14px] font-semibold no-underline"
           style="background: var(--brand-1); color: var(--brand-1-ink); border: 1px solid var(--brand-1);">
          <%= t("storefronts.hero.view_menu_cta") %>
        </a>
        <% if whatsapp_url %>
          <a href="<%= whatsapp_url %>" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 rounded-[9px] px-4 py-2.5 text-[14px] font-semibold no-underline"
             style="background: #25D366; color: #053019; border: 1px solid #25D366;"
             aria-label="WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.5 3.5A11 11 0 0 0 3.6 17.3L2 22l4.9-1.4A11 11 0 1 0 20.5 3.5zM12 20a8 8 0 0 1-4-1.1l-.3-.2-3 .9.9-2.9-.2-.3a8 8 0 1 1 12.4 3.6A7.8 7.8 0 0 1 12 20zm4.4-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.7-.3-1.4-.7-2-1.3-.5-.5-.9-1-1.2-1.7-.1-.2 0-.3.1-.4l.3-.4c.1-.1.2-.3.2-.4 0-.2 0-.3 0-.4 0-.1-.5-1.2-.7-1.7-.2-.4-.4-.4-.5-.4H8.8c-.2 0-.4.1-.6.3-.6.6-1 1.5-.9 2.4.1 1.3.8 2.6 1.8 3.5A8.7 8.7 0 0 0 13.5 17c1.3.5 2.3.5 3.2.4.8-.1 1.5-.6 1.9-1.3.2-.4.2-.9.1-1.3-.1-.1-.2-.2-.3-.3z"/>
            </svg>
            WhatsApp
          </a>
        <% end %>
      </div>
    </div>
  </div>
</section>
