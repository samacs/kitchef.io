<article class="flex flex-col overflow-hidden rounded-[14px] border border-line bg-surface transition-shadow hover:shadow-lift">
  <div class="relative" style="aspect-ratio: 4 / 3; background: var(--color-bg-2);">
    <% if photo_variant %>
      <%= image_tag photo_variant, class: "absolute inset-0 h-full w-full object-cover", alt: name %>
    <% else %>
      <div class="absolute inset-0 flex items-center justify-center font-serif italic text-[56px]"
           style="color: var(--brand-1);">
        <%= name.first.upcase %>
      </div>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col gap-2.5 p-4">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-serif text-[22px] leading-[1.1] tracking-tight text-ink"><%= name %></h3>
      <div class="shrink-0 text-right">
        <div class="font-serif text-[20px] leading-[1.1] text-ink"><%= price_display %></div>
      </div>
    </div>
    <% if description.present? %>
      <p class="text-[13px] leading-[1.55] text-ink-2 line-clamp-3"><%= description %></p>
    <% end %>

    <div class="mt-auto pt-2">
      <button type="button"
              class="inline-flex w-full items-center justify-center gap-1.5 rounded-[9px] px-4 py-2.5 text-[14px] font-semibold transition"
              style="background: var(--brand-1); color: var(--brand-1-ink); border: 1px solid var(--brand-1);"
              data-action="click->storefront-cart#add"
              data-storefront-cart-payload-param="<%= payload %>">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12h14"/>
        </svg>
        <%= t("storefronts.menu.add") %>
      </button>
    </div>
  </div>
</article>
