<% detail_href = helpers.storefront_recipe_path(slug: recipe.account.slug, recipe_slug: recipe.slug) %>
<article class="flex flex-col overflow-hidden rounded-[14px] border <%= card_emphasis_classes.presence || "border-line" %> bg-surface transition-shadow hover:shadow-lift">
  <%# Photo region — single image keeps the existing `<a>` wrap so the
      whole top half is tappable. Multi-image swaps in the carousel
      component (Phase 14, Slice 12); the carousel arrows + dots stop
      click propagation so they don't accidentally deep-link. %>
  <div class="relative overflow-hidden"
       style="aspect-ratio: 4 / 3; background: var(--color-bg-2);">
    <% if recipe.photo_count > 1 %>
      <%= render Storefronts::PhotoCarouselComponent.new(recipe: recipe, variant: :card, alt: name) %>
      <%# Title-anchor over the carousel: only the slide image deep-
          links; arrow buttons sit above and intercept clicks. %>
      <%= link_to detail_href,
            class: "absolute inset-0 z-[1] no-underline",
            aria:  { label: t("storefronts.menu.view_dish_aria", name: name) } %>
    <% else %>
      <%= link_to detail_href,
            class: "group relative block overflow-hidden no-underline w-full h-full",
            aria:  { label: t("storefronts.menu.view_dish_aria", name: name) } do %>
        <% if photo_variant %>
          <%= image_tag photo_variant,
                class: "absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]",
                alt: name %>
        <% else %>
          <div class="absolute inset-0 flex items-center justify-center font-serif italic text-[56px]"
               style="color: var(--brand-1);">
            <%= name.first.upcase %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col gap-2.5 p-4">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-serif text-[22px] leading-[1.1] tracking-tight text-ink">
        <%= link_to name, detail_href, class: "no-underline hover:underline" %>
      </h3>
      <div class="shrink-0 text-right">
        <div class="font-serif text-[20px] leading-[1.1] text-ink"><%= price_display %></div>
      </div>
    </div>
    <% if requires_advance_notice? %>
      <div class="flex items-center gap-1.5 -mt-0.5">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted shrink-0" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span class="font-mono text-[11px] text-muted leading-tight"><%= lead_time_badge %></span>
      </div>
    <% end %>
    <%# Phase 13 — stock badge. Renders only when inventory is enabled
        and there's something worth surfacing (low / last / out). %>
    <%= render Storefronts::MenuStockBadgeComponent.new(recipe: recipe) %>
    <% if description.present? %>
      <div data-controller="reveal"
           data-reveal-collapsed-class="line-clamp-3"
           data-reveal-expanded-class="line-clamp-none">
        <p class="text-[13px] leading-[1.55] text-ink-2 whitespace-pre-line line-clamp-3"
           data-reveal-target="content"><%= description %></p>
        <button type="button"
                class="mt-1 inline-flex items-center gap-1 text-[12px] font-semibold transition-colors hover:underline"
                style="color: var(--brand-1);"
                hidden
                data-reveal-target="toggle"
                data-action="click->reveal#toggle"
                data-label-more="<%= t("storefronts.menu.reveal_more") %>"
                data-label-less="<%= t("storefronts.menu.reveal_less") %>">
          <span data-reveal-target="label"><%= t("storefronts.menu.reveal_more") %></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
               data-reveal-target="chevron"
               class="transition-transform">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>
      </div>
    <% end %>

    <div class="mt-auto flex items-stretch gap-2 pt-2">
      <%# "Ver" takes the customer to the dish detail page. Secondary
          styling so the eye still lands on the primary "Agregar" CTA
          — impulse-add stays one tap away. %>
      <%= link_to helpers.storefront_recipe_path(slug: recipe.account.slug, recipe_slug: recipe.slug),
            class: "inline-flex items-center justify-center gap-1.5 rounded-[9px] border border-line bg-surface px-3 py-2.5 text-[13px] font-medium text-ink-2 no-underline transition hover:border-line-2" do %>
        <%= t("storefronts.menu.view") %>
      <% end %>
      <% if stock_blocked? %>
        <button type="button" disabled
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-[9px] border border-line bg-bg-2 px-4 py-2.5 text-[14px] font-medium text-muted cursor-not-allowed">
          <%= t("storefronts.menu.stock.sold_out") %>
        </button>
      <% elsif customizable? %>
        <button type="button"
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-[9px] px-4 py-2.5 text-[14px] font-semibold transition"
                style="background: var(--brand-1); color: var(--brand-1-ink); border: 1px solid var(--brand-1);"
                data-controller="storefront-customize-trigger"
                data-action="click->storefront-customize-trigger#open"
                data-recipe-slug="<%= recipe.slug %>">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <%= t("storefronts.menu.add") %>
        </button>
      <% else %>
        <button type="button"
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-[9px] px-4 py-2.5 text-[14px] font-semibold transition"
                style="background: var(--brand-1); color: var(--brand-1-ink); border: 1px solid var(--brand-1);"
                data-action="click->storefront-cart#add"
                data-storefront-cart-payload-param="<%= payload %>">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <%= t("storefronts.menu.add") %>
        </button>
      <% end %>
    </div>
  </div>
</article>
