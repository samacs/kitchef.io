<div class="flex flex-col items-end gap-1">
  <span class="font-mono text-[13px] tabular-nums text-ink">
    <%= stock_label %>
  </span>
  <% if out_of_stock? %>
    <span class="inline-flex items-center gap-1 rounded-pill border border-warn/30 bg-[color-mix(in_oklab,var(--color-warn)_10%,var(--color-surface))] px-2 py-px font-mono text-[10.5px] font-medium text-warn uppercase tracking-[0.08em]">
      <%= t("ingredients.stock.empty") %>
    </span>
  <% elsif low_stock? %>
    <span class="inline-flex items-center gap-1 rounded-pill border border-line bg-bg-2 px-2 py-px font-mono text-[10.5px] font-medium text-warn uppercase tracking-[0.08em]">
      <%= t("ingredients.stock.low") %>
    </span>
  <% end %>
</div>
