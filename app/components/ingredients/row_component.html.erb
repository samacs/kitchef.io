<tr id="<%= helpers.dom_id(ingredient) %>" class="border-b border-line last:border-b-0 hover:bg-bg-2/40 transition-colors">
  <td class="px-4 py-3">
    <%= helpers.drawer_link_to edit_path,
          class: "inline-flex flex-col gap-0.5 text-left no-underline" do %>
      <span class="text-[14px] font-medium text-ink hover:underline"><%= ingredient.name %></span>
      <% default_supplier_name = ingredient.default_supplier&.name %>
      <% if default_supplier_name %>
        <span class="text-[12px] text-muted"><%= default_supplier_name %></span>
      <% end %>
    <% end %>
  </td>
  <td class="px-4 py-3 font-mono text-[13px] text-ink-2 whitespace-nowrap tabular-nums">
    <%= price_per_unit_label %>
  </td>
  <% if show_stock %>
    <td class="px-4 py-3 whitespace-nowrap">
      <%= render Ingredients::StockCellComponent.new(ingredient: ingredient) %>
    </td>
  <% end %>
  <td class="px-4 py-3 text-[12px] text-muted whitespace-nowrap">
    <%= updated_at_label || "—" %>
  </td>
  <td class="px-4 py-3 font-mono text-[13px] text-muted text-right whitespace-nowrap">
    <% if used_by_count.positive? %>
      <%= t("ingredients.index.used_by_count", count: used_by_count) %>
    <% else %>
      <span class="text-muted/60">—</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-right">
    <div class="inline-flex items-center gap-1">
      <%= helpers.drawer_link_to edit_path,
            aria: { label: t("ingredients.row.edit") },
            title: t("ingredients.row.edit"),
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-ink hover:border-line transition-colors" do %>
        <%= helpers.icon(:pencil, size: :sm) %>
      <% end %>

      <%= button_to helpers.ingredient_path(ingredient),
            method: :delete,
            form: { class: "inline-flex", data: { turbo_confirm: t("ingredients.row.delete_confirm", name: ingredient.name) } },
            aria: { label: t("ingredients.row.delete") },
            title: t("ingredients.row.delete"),
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-err hover:border-err/40 transition-colors" do %>
        <%= helpers.icon(:trash_2, size: :sm) %>
      <% end %>
    </div>
  </td>
</tr>
