<article class="flex flex-col gap-3 rounded-panel border border-line bg-surface p-4 shadow-card">
  <header class="flex items-start justify-between gap-3">
    <div class="flex flex-col gap-1 min-w-0 flex-1">
      <h3 class="font-serif text-[17px] leading-[1.2] text-ink truncate"><%= name %></h3>
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10.5px] font-mono uppercase tracking-[0.1em] border <%= status_classes %>">
          <%= status_label %>
        </span>
        <span class="inline-flex items-center rounded-full bg-bg-2 px-2 py-0.5 font-mono text-[10.5px] text-muted uppercase tracking-[0.1em]">
          <%= promotion.kind_label %>
        </span>
      </div>
    </div>

    <span class="font-mono text-[20px] font-semibold text-accent shrink-0 tabular-nums">
      <%= discount_display %>
    </span>
  </header>

  <% if code.present? %>
    <div class="flex items-center gap-2 rounded-[8px] border border-line bg-bg-2/40 px-3 py-2">
      <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted"><%= t("promotions.card.code_label") %></span>
      <span class="font-mono text-[14px] font-semibold text-ink tracking-wider"><%= code %></span>
    </div>
  <% end %>

  <div class="flex flex-col gap-1 text-[12px] text-ink-2">
    <div class="flex items-center gap-1.5">
      <%= helpers.icon(:target, size: :xs, class: "text-muted shrink-0") %>
      <span><%= promotion.scope_type_label %></span>
    </div>
    <% if scope_detail %>
      <div class="flex items-start gap-1.5 ml-[18px]">
        <span class="text-[11.5px] text-muted"><%= scope_detail %></span>
      </div>
    <% end %>
    <div class="flex items-center gap-1.5">
      <%= helpers.icon(:repeat, size: :xs, class: "text-muted shrink-0") %>
      <span><%= usage_display %></span>
    </div>
    <div class="flex items-center gap-1.5">
      <%= helpers.icon(:clock, size: :xs, class: "text-muted shrink-0") %>
      <span><%= expiry_display %></span>
    </div>
  </div>

  <footer class="flex items-center justify-between gap-2 pt-3 border-t border-line">
    <span class="font-mono text-[11px] text-muted">
      <%= t("promotions.card.redemptions", count: total_usage_count) %>
    </span>
    <div class="flex items-center gap-1">
      <%= helpers.button_to helpers.toggle_promotion_path(promotion),
            method: :post,
            form: { class: "inline-flex" },
            class: "inline-flex items-center justify-center px-2.5 py-1.5 rounded-input text-[11.5px] font-medium border border-line text-ink-2 hover:border-line-2 hover:text-ink transition-colors cursor-pointer" do %>
        <%= toggle_label %>
      <% end %>

      <%= helpers.link_to helpers.edit_promotion_path(promotion),
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-ink hover:border-line transition-colors" do %>
        <%= helpers.icon(:pencil, size: :sm) %>
      <% end %>

      <%= helpers.button_to helpers.promotion_path(promotion),
            method: :delete,
            form: {
              class: "inline-flex",
              data: { turbo_confirm: t("promotions.card.delete_confirm") }
            },
            class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-err hover:border-err/40 transition-colors cursor-pointer" do %>
        <%= helpers.icon(:trash_2, size: :sm) %>
      <% end %>
    </div>
  </footer>
</article>
