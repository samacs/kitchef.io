<%
  extra_columns = [ show_expenses, show_fixed_costs ].count(true)
  grid_cols =
    case extra_columns
    when 0 then "grid-cols-[minmax(0,1fr)_auto_auto_auto]"
    when 1 then "grid-cols-[minmax(0,1fr)_auto_auto_auto_auto]"
    else        "grid-cols-[minmax(0,1fr)_auto_auto_auto_auto_auto]"
    end
  row_classes = [
    "grid items-baseline gap-4 py-3 px-4 rounded-card-sm",
    grid_cols,
    "border border-line bg-surface",
    empty? ? "opacity-50" : nil
  ].compact.join(" ")
%>
<div class="<%= row_classes %>">
  <div class="flex flex-col min-w-0">
    <span class="font-serif text-[15px] text-ink leading-tight capitalize">
      <%= weekday_label %>
    </span>
    <span class="font-mono text-[11px] text-muted tracking-[0.08em]">
      <%= date_label %>
    </span>
  </div>

  <span class="font-mono text-[13px] text-muted tabular-nums whitespace-nowrap">
    <%= t("reports.finance.day.orders_count", count: day_stats.order_count) %>
  </span>

  <% if day_stats.order_count.zero? %>
    <span class="font-mono text-[13px] text-muted tabular-nums">—</span>
    <span class="font-mono text-[13px] text-muted tabular-nums">—</span>
  <% else %>
    <span class="font-mono text-[14px] font-medium text-ink tabular-nums whitespace-nowrap">
      <%= helpers.humanized_money_with_symbol(revenue) %>
    </span>
    <span class="font-mono text-[13px] text-accent tabular-nums whitespace-nowrap">
      <%= t("reports.finance.day.margin_pct", pct: day_stats.margin_pct || 0) %>
    </span>
  <% end %>

  <% if show_expenses %>
    <% if has_expenses? %>
      <span class="font-mono text-[13px] text-warn tabular-nums whitespace-nowrap">
        −<%= helpers.humanized_money_with_symbol(expenses) %>
      </span>
    <% else %>
      <span class="font-mono text-[13px] text-muted/60 tabular-nums">—</span>
    <% end %>
  <% end %>

  <% if show_fixed_costs %>
    <% if has_fixed? %>
      <span class="font-mono text-[13px] text-muted tabular-nums whitespace-nowrap">
        −<%= helpers.humanized_money_with_symbol(fixed) %>
      </span>
    <% else %>
      <span class="font-mono text-[13px] text-muted/60 tabular-nums">—</span>
    <% end %>
  <% end %>
</div>
