<div class="flex flex-col gap-3"
     data-controller="ordering-hours"
     data-ordering-hours-target="root">
  <%# Hidden field — the single payload serialized by the Stimulus
      controller. Named to nest under account[public_profile][…] so the
      existing strong-param permit list picks it up. %>
  <input type="hidden"
         name="account[public_profile][ordering_hours]"
         data-ordering-hours-target="payload"
         value="<%= account.public_profile.ordering_hours %>">

  <div class="hidden sm:grid grid-cols-[110px_1fr_1fr_auto] gap-3 px-1 font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
    <span>Día</span>
    <span>Abre</span>
    <span>Cierra</span>
    <span class="justify-self-end">Cerrado</span>
  </div>

  <% DAY_LABELS.each do |(wday, label)| %>
    <% entry = entry_for(wday) %>
    <div class="grid grid-cols-2 sm:grid-cols-[110px_1fr_1fr_auto] gap-3 items-center rounded-card-sm border border-line bg-surface p-3"
         data-ordering-hours-target="row"
         data-wday="<%= wday %>"
         data-closed="<%= entry["closed"] %>">
      <div class="col-span-2 sm:col-span-1 text-[13.5px] font-medium text-ink">
        <%= label %>
      </div>
      <label class="flex flex-col gap-1">
        <span class="sm:hidden text-[11px] text-muted">Abre</span>
        <input type="time"
               value="<%= entry["open"] %>"
               data-ordering-hours-target="open"
               data-action="change->ordering-hours#serialize"
               <%= entry["closed"] ? "disabled" : "" %>
               class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono disabled:opacity-50 disabled:cursor-not-allowed">
      </label>
      <label class="flex flex-col gap-1">
        <span class="sm:hidden text-[11px] text-muted">Cierra</span>
        <input type="time"
               value="<%= entry["close"] %>"
               data-ordering-hours-target="close"
               data-action="change->ordering-hours#serialize"
               <%= entry["closed"] ? "disabled" : "" %>
               class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono disabled:opacity-50 disabled:cursor-not-allowed">
      </label>
      <label class="col-span-2 sm:col-span-1 inline-flex items-center gap-2 sm:justify-self-end">
        <input type="checkbox"
               <%= entry["closed"] ? "checked" : "" %>
               data-ordering-hours-target="closedToggle"
               data-action="change->ordering-hours#toggleClosed"
               class="h-4 w-4 accent-accent">
        <span class="text-[12.5px] text-ink-2">Cerrado</span>
      </label>
    </div>
  <% end %>
</div>
