<section class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6"
         data-controller="inventory-settings">
  <div>
    <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
      <%= t("account.inventory.kicker") %>
    </div>
    <h2 class="mt-1 font-serif text-[22px] leading-tight text-ink">
      <%= t("account.inventory.title") %>
    </h2>
    <p class="mt-1 text-[13px] text-ink-2 max-w-[560px]">
      <%= t("account.inventory.lede") %>
    </p>
  </div>

  <div class="rounded-card-sm border border-line bg-bg-2/60">
    <label class="flex items-start gap-3 p-4 cursor-pointer">
      <input type="hidden" name="account[settings][inventory_settings][enabled]" value="0">
      <input type="checkbox"
             name="account[settings][inventory_settings][enabled]"
             value="1"
             <%= "checked" if enabled? %>
             data-action="change->inventory-settings#toggle"
             data-inventory-settings-target="checkbox"
             class="mt-[3px] w-4 h-4 accent-accent">
      <div class="flex-1 flex flex-col gap-1">
        <span class="text-[14px] font-medium text-ink">
          <%= t("account.inventory.toggle_label") %>
        </span>
        <span class="text-[12px] text-muted leading-[1.5]">
          <%= t("account.inventory.toggle_hint") %>
        </span>
      </div>
    </label>

    <div data-inventory-settings-target="details"
         class="<%= "hidden" unless enabled? %> px-4 pb-4">
      <div class="border-t border-line pt-4 flex flex-col gap-4">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
          <%= t("account.inventory.policies_section") %>
        </div>

        <%# Oversell policy — segmented control. %>
        <fieldset class="flex flex-col gap-2">
          <legend class="text-[12px] font-medium text-muted">
            <%= t("account.inventory.oversell_policy_label") %>
          </legend>
          <div class="grid grid-cols-2 gap-2">
            <% Accounts::InventorySettings::OVERSELL_POLICIES.each do |policy| %>
              <label class="flex items-start gap-2.5 rounded-input border border-line bg-surface px-3 py-2.5 cursor-pointer hover:border-line-2 has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
                <input type="radio"
                       name="account[settings][inventory_settings][oversell_policy]"
                       value="<%= policy %>"
                       <%= "checked" if settings.oversell_policy.to_s == policy %>
                       class="mt-[3px] w-4 h-4 accent-accent">
                <span class="flex flex-col gap-0.5">
                  <span class="text-[13px] font-medium text-ink">
                    <%= t("account.inventory.oversell_policies.#{policy}.label") %>
                  </span>
                  <span class="text-[11.5px] text-muted leading-[1.4]">
                    <%= t("account.inventory.oversell_policies.#{policy}.hint") %>
                  </span>
                </span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="account_inventory_low_stock_pct"
                   class="block text-[12px] font-medium text-muted mb-1">
              <%= t("account.inventory.low_stock_threshold_label") %>
            </label>
            <span class="relative flex items-center">
              <input type="number"
                     id="account_inventory_low_stock_pct"
                     name="account[settings][inventory_settings][low_stock_threshold_pct]"
                     value="<%= settings.low_stock_threshold_pct %>"
                     min="0" max="100" step="1" inputmode="numeric"
                     class="w-full bg-surface text-ink border border-line hover:border-line-2 rounded-input px-3 pr-8 py-2 text-[14px] leading-[1.3] font-mono tabular-nums outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
              <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted font-mono text-[13px]">%</span>
            </span>
            <p class="mt-1 text-[11.5px] text-muted">
              <%= t("account.inventory.low_stock_threshold_hint") %>
            </p>
          </div>

          <div>
            <label for="account_inventory_batch_window_days"
                   class="block text-[12px] font-medium text-muted mb-1">
              <%= t("account.inventory.default_batch_window_label") %>
            </label>
            <input type="number"
                   id="account_inventory_batch_window_days"
                   name="account[settings][inventory_settings][default_batch_window_days]"
                   value="<%= settings.default_batch_window_days %>"
                   min="0" max="14" step="1" inputmode="numeric"
                   class="w-full bg-surface text-ink border border-line hover:border-line-2 rounded-input px-3 py-2 text-[14px] leading-[1.3] font-mono tabular-nums outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
            <p class="mt-1 text-[11.5px] text-muted">
              <%= t("account.inventory.default_batch_window_hint") %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
