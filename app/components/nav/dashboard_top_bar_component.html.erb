<header class="kc-chrome sticky top-0 z-30 border-b border-line">
  <div class="px-5 lg:px-7 py-[14px] flex items-center gap-3 lg:gap-4 flex-wrap">
    <%# ---- Mobile: sidebar hamburger + compact user chip ---------- %>
    <div class="lg:hidden flex items-center gap-2">
      <%= render Ui::DropdownComponent.new(placement: :bottom_start, menu_width: "w-[min(300px,calc(100vw-32px))]", menu_class: "p-2") do |d| %>
        <% d.with_trigger do %>
          <%= render Ui::IconButtonComponent.new(icon: :menu, label: t("panel.top_bar.open_sidebar")) %>
        <% end %>
        <% d.with_menu do %>
          <%# Nav definition comes from PanelNavHelper so we don't
              instantiate a throwaway sidebar just to read its sections. %>
          <% helpers.panel_nav_sections.each_with_index do |section, idx| %>
            <div class="<%= idx.zero? ? "pt-1" : "pt-3" %> px-2 pb-1 font-mono text-[10.5px] font-medium tracking-[0.14em] uppercase text-muted">
              <%= section[:kicker] %>
            </div>
            <% section[:items].each do |item| %>
              <%= render Ui::MenuItemComponent.new(label: item.label, icon: item.icon, href: item.href, trailing: item.badge) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# ---- Title + subtitle --------------------------------------- %>
    <div class="min-w-0 flex-1 basis-[220px]">
      <h1 class="font-serif text-[24px] leading-[1.15] tracking-[-0.01em] text-ink truncate">
        <%= display_title %>
      </h1>
      <p class="text-[12px] text-muted truncate mt-0.5">
        <%= display_subtitle %>
      </p>
    </div>

    <%# ---- Search ------------------------------------------------- %>
    <div class="relative flex-[0_1_280px] min-w-[180px] order-last sm:order-none w-full sm:w-auto">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
        <%= helpers.icon(:search, size: :xs) %>
      </span>
      <input type="search"
             placeholder="<%= t("panel.top_bar.search_placeholder") %>"
             class="w-full pl-9 pr-3 py-2 bg-surface border border-line rounded-[8px] text-[13px] text-ink placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-colors">
    </div>

    <%# ---- Actions ------------------------------------------------ %>
    <div class="flex items-center gap-2 shrink-0">
      <%= render Ui::ThemeToggleComponent.new(size: :sm) %>
      <%= render Ui::IconButtonComponent.new(icon: :bell, label: t("panel.top_bar.notifications"), size: :sm, badge: true) %>

      <%# Primary action — pages override via content_for :page_action. %>
      <% if content_for?(:page_action) %>
        <%= yield :page_action %>
      <% else %>
        <%= link_to helpers.new_order_path,
              class: "hidden sm:inline-flex items-center gap-2 text-[13px] font-semibold px-3.5 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
          <%= helpers.icon(:plus, size: :xs) %>
          <span><%= t("panel.top_bar.new_order") %></span>
        <% end %>
      <% end %>

      <%# Compact user chip (desktop has it in sidebar, mobile here). %>
      <div class="lg:hidden">
        <%= render Nav::UserMenuComponent.new(
              current_user: current_user,
              current_account: current_account,
              variant: :chip,
              placement: :bottom_end) %>
      </div>
    </div>
  </div>
</header>
