<header class="kc-chrome sticky top-0 z-30 border-b border-line"
        data-controller="top-bar-search">
  <div class="px-4 sm:px-5 lg:px-7 py-[14px] flex items-center gap-3 lg:gap-4">
    <%# ---- Mobile drawer trigger --------------------------------- %>
    <div class="lg:hidden">
      <%= render Ui::IconButtonComponent.new(
            icon: :menu,
            label: t("panel.top_bar.open_sidebar"),
            data: { action: "click->drawer#open" }) %>
    </div>

    <%# ---- Title + subtitle --------------------------------------- %>
    <div class="min-w-0 flex-1 order-none">
      <h1 class="font-serif text-[24px] leading-[1.15] tracking-[-0.01em] text-ink truncate">
        <%= display_title %>
      </h1>
      <p class="text-[12px] text-muted truncate mt-0.5">
        <%= display_subtitle %>
      </p>
    </div>

    <%# ---- Desktop search trigger ---- %>
    <button type="button"
            data-action="click->top-bar-search#open"
            class="hidden sm:flex items-center gap-2 pl-3 pr-2.5 py-2
                   flex-[0_1_280px] min-w-[180px]
                   bg-surface border border-line rounded-[8px]
                   text-[13px] text-muted hover:border-line-2 hover:text-ink transition-colors cursor-pointer">
      <%= helpers.icon(:search, size: :xs) %>
      <span class="flex-1 text-left truncate"><%= t("search.palette.trigger") %></span>
      <kbd class="font-mono text-[10.5px] text-muted border border-line rounded-[4px] px-1.5 py-px" data-kbd-shortcut>Ctrl+K</kbd>
    </button>

    <%# ---- Actions ---- %>
    <div class="flex items-center gap-2 shrink-0 order-none">
      <div class="hidden md:inline-flex">
        <%= render Ui::ThemeToggleComponent.new(size: :sm) %>
      </div>

      <%= render Nav::NotificationBellComponent.new(current_user: current_user) %>

      <%# Mobile search icon — sits inline with bell + user chip %>
      <div class="sm:hidden">
        <%= render Ui::IconButtonComponent.new(
              icon: :search,
              label: t("search.palette.trigger"),
              data: { action: "click->top-bar-search#open" }) %>
      </div>

      <div class="hidden sm:flex items-center shrink-0">
        <% if helpers.content_for?(:page_action) %>
          <%= helpers.content_for(:page_action) %>
        <% else %>
          <%= link_to helpers.new_order_path,
                class: "inline-flex items-center gap-2 text-[13px] font-semibold px-3.5 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
            <%= helpers.icon(:plus, size: :xs) %>
            <span><%= t("panel.top_bar.new_order") %></span>
          <% end %>
        <% end %>
      </div>

      <div class="lg:hidden">
        <%= render Nav::UserMenuComponent.new(
              current_user: current_user,
              current_account: current_account,
              variant: :chip,
              placement: :bottom_end) %>
      </div>
    </div>
  </div>
</header>
