<footer class="border-t border-line pt-14 pb-7 mt-24">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="grid grid-cols-1 md:grid-cols-[1.6fr_repeat(3,1fr)] gap-10 mb-9">
      <div class="flex flex-col gap-3.5 max-w-[320px]">
        <%= render Ui::LogoComponent.new(href: helpers.root_path) %>
        <p class="text-[13.5px] leading-[1.55] text-muted">
          <%= t("marketing.footer.tagline") %>
        </p>
      </div>

      <% columns.each do |col| %>
        <div class="flex flex-col">
          <h5 class="text-[12px] font-semibold text-ink uppercase tracking-[0.1em] mb-3.5">
            <%= col[:title] %>
          </h5>
          <% col[:links].each do |link| %>
            <%= link_to link[:label], link[:href],
                  class: "block text-[13.5px] text-ink-2 hover:text-accent py-1 transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 pt-5 border-t border-line text-[12px] text-muted">
      <div><%= t("marketing.footer.copy", year: year) %></div>
      <div class="font-mono"><%= t("marketing.footer.location") %></div>
    </div>
  </div>
</footer>
