<% content_for :title, t("orders.cancellations.title") %>

<%= turbo_frame_tag "drawer_content" do %>
  <div class="max-w-[520px] mx-auto flex flex-col gap-5 p-5 sm:p-6">
    <div class="bg-surface border border-line rounded-panel shadow-card p-6">
      <div class="flex flex-col gap-2 mb-5">
        <%= render Ui::KickerComponent.new(text: t("orders.cancellations.kicker")) %>
        <h2 class="font-serif text-[24px] leading-[1.1] tracking-[-0.01em] text-ink">
          <%= t("orders.cancellations.heading", client: order.client&.name.presence || t("dashboard.today_orders.empty_client")) %>
        </h2>
        <p class="text-[14px] text-ink-2 leading-[1.55]">
          <%= t("orders.cancellations.lede") %>
        </p>
      </div>

      <%= form_with url: order_cancellation_path(order),
            method: :post,
            scope: :order,
            data: { controller: "cancel-reason" },
            class: "flex flex-col gap-5" do |form| %>

        <% if order.errors.any? %>
          <div role="alert"
               class="bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))] text-err border border-err/30 rounded-[10px] px-4 py-3 flex flex-col gap-1.5">
            <span class="text-[12px] font-mono uppercase tracking-[0.14em]">
              <%= t("onboarding.shared.errors_title") %>
            </span>
            <ul class="text-[13px] leading-[1.4] list-disc list-inside">
              <% order.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <label for="order_cancel_reason_code" class="flex flex-col gap-2">
          <span class="text-[13px] font-medium text-ink leading-none">
            <%= t("orders.cancellations.reason_label") %>
          </span>
          <%= form.select :cancel_reason_code,
                Order::CANCEL_REASON_CODES.map { |code| [ t("order.cancel_reasons.#{code}"), code ] },
                { prompt: t("orders.cancellations.reason_prompt") },
                required: true,
                id: "order_cancel_reason_code",
                data: {
                  cancel_reason_target: "code",
                  action: "change->cancel-reason#toggleNote"
                },
                class: "w-full bg-surface text-ink border border-line hover:border-line-2 rounded-input px-3.5 py-2.5 text-[14px] leading-[1.3] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" %>
        </label>

        <label for="order_cancel_reason_note"
               class="flex flex-col gap-2"
               data-cancel-reason-target="noteWrap">
          <span class="flex items-baseline justify-between gap-2">
            <span class="text-[13px] font-medium text-ink leading-none">
              <%= t("orders.cancellations.note_label") %>
            </span>
            <span data-cancel-reason-target="noteRequired"
                  class="hidden text-[11.5px] font-mono text-err uppercase tracking-[0.14em]">
              <%= t("orders.cancellations.note_required") %>
            </span>
          </span>
          <%= form.text_area :cancel_reason_note,
                id: "order_cancel_reason_note",
                rows: 3,
                placeholder: t("orders.cancellations.note_placeholder"),
                data: { cancel_reason_target: "note" },
                class: "w-full bg-surface text-ink placeholder:text-muted border border-line hover:border-line-2 rounded-input px-3.5 py-2.5 text-[14px] leading-[1.5] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 resize-y" %>
          <span class="text-[12px] text-muted"><%= t("orders.cancellations.note_hint") %></span>
        </label>

        <div class="flex items-center justify-between gap-3 pt-2">
          <%= link_to t("orders.cancellations.back"),
                orders_path,
                data: { action: "click->right-drawer#close" },
                class: "inline-flex items-center justify-center gap-2 text-[13px] font-medium px-4 py-[10px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" %>

          <%= form.submit t("orders.cancellations.submit"),
                class: "inline-flex items-center justify-center gap-2 text-[14px] font-semibold px-[22px] py-[10px] rounded-button bg-transparent text-err border border-err/50 hover:bg-err/5 transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
