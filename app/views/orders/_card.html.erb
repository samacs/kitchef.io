<% en_route = order.state == "en_route" %>
<article id="<%= dom_id(order) %>"
         class="kc-highlightable flex flex-col gap-3 p-4 rounded-card bg-bg/60 border border-line hover:border-line-2 transition scroll-mt-[84px]">
  <header class="flex items-start justify-between gap-3">
    <div class="flex flex-col gap-0.5 min-w-0 flex-1">
      <%= drawer_link_to edit_order_path(order),
            class: "font-serif text-[16px] leading-[1.2] text-ink truncate hover:underline" do %>
        <%= order.client&.name.presence || t("dashboard.today_orders.empty_client") %>
      <% end %>
      <%# Short pedido id — makes two otherwise-identical pedidos from the
          same client (same date, same platillos) distinguishable at a
          glance on the kanban. Using the tail so the common `ord_`
          prefix doesn't eat visual space; the full prefix_id lives on
          the drawer and in the URL. %>
      <span class="font-mono text-[10px] text-muted/70 tracking-[0.08em]">
        #<%= order.prefix_id.sub(/\Aord_/, "") %>
      </span>
    </div>
    <%= render Orders::StateBadgeComponent.new(state: order.state) %>
  </header>

  <%# Delivery type + date + window — its own full-width row below the
      header so a long date ("22 de abril de 2026 · 10:00–13:00") flows
      across the whole card instead of wrapping inside a narrow column
      beside the state badge. Icon uses `items-start` + a small
      line-height nudge so it hugs the first line even when the text
      wraps to two. %>
  <div class="flex items-start gap-1.5 font-mono text-[11px] text-muted uppercase tracking-[0.14em]">
    <span class="inline-flex items-center shrink-0 mt-[1px]"
          aria-label="<%= t("order.delivery_types.#{order.delivery_type}") %>"
          title="<%= t("order.delivery_types.#{order.delivery_type}") %>">
      <%= icon(order.delivery? ? :bike : :shopping_bag, size: :xs) %>
    </span>
    <span class="flex-1 leading-[1.4]">
      <%= l(order.delivery_date, format: :long) %><%
        if order.delivery_start_time.present? %> · <%= order.delivery_start_time_hhmm %><%
        if order.delivery_end_time.present? %>–<%= order.delivery_end_time_hhmm %><% end %><% end %>
    </span>
  </div>

  <%# Map thumbnail + Cómo llegar CTA. Reserved for the en_route
      column where the runner needs the map front-and-center; other
      delivery cards expose the same directions link as a compact
      icon in the footer action cluster below. %>
  <% if order.delivery? && order.geocoded? && en_route %>
    <%= render "orders/map_thumbnail", order: order %>
  <% end %>

  <ul class="flex flex-col gap-1">
    <% order.items.each do |item| %>
      <li class="flex flex-col gap-0.5">
        <div class="flex items-baseline justify-between gap-2 text-[13px]">
          <span class="text-ink-2 truncate">
            <span class="font-mono text-muted mr-1"><%= item.quantity.to_s.sub(/\.0+\z/, "") %>×</span>
            <%= item.recipe&.name %>
          </span>
          <span class="font-mono text-[12.5px] text-muted shrink-0">
            <%= humanized_money_with_symbol(item.line_total) %>
          </span>
        </div>
        <% if item.has_customizations? %>
          <div class="flex flex-wrap gap-1 pl-6">
            <% item.display_options.first(3).each do |line| %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded-full bg-bg-2 text-[10px] text-muted font-mono">
                <%= line %>
              </span>
            <% end %>
            <% if item.display_options.size > 3 %>
              <span class="text-[10px] text-muted font-mono">
                <%= t("orders.card.options_overflow", count: item.display_options.size - 3) %>
              </span>
            <% end %>
          </div>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%# Non-en_route delivery cards get a quiet map icon in the footer
      actions row below; keeps cards compact until the runner leg. %>

  <% if order.canceled? && order.cancel_reason_code.present? %>
    <div class="flex flex-col gap-0.5 px-3 py-2 rounded-card bg-err/5 border border-err/20">
      <span class="font-mono text-[11px] text-err uppercase tracking-[0.14em]">
        <%= t("orders.cancellations.reason_kicker") %>
      </span>
      <span class="text-[12.5px] text-ink-2 leading-[1.4]">
        <%= t("order.cancel_reasons.#{order.cancel_reason_code}") %><%
          if order.cancel_reason_note.present? %> · <%= order.cancel_reason_note %><% end %>
      </span>
    </div>
  <% end %>

  <footer class="flex items-center justify-between gap-2 pt-3 border-t border-line">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="font-mono text-[14px] font-medium text-ink">
        <%= humanized_money_with_symbol(order.total) %>
      </span>
      <% if order.packaging_cents.to_i.positive? %>
        <span class="font-mono text-[11px] text-muted tracking-[0.08em]">
          <%= t("orders.card.packaging_suffix", amount: humanized_money_with_symbol(order.packaging)) %>
        </span>
      <% end %>
      <% if order.paid? %>
        <span class="inline-flex items-center gap-1 text-accent"
              aria-label="<%= t("orders.payment_status.paid_aria") %>"
              title="<%= t("orders.payment_status.paid_aria") %>">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span class="font-mono text-[10px] font-medium uppercase tracking-[0.1em]"><%= t("orders.payment_status.paid") %></span>
        </span>
      <% elsif !order.canceled? %>
        <span class="inline-flex items-center gap-1 text-warn/80"
              aria-label="<%= t("orders.payment_status.pending_aria") %>"
              title="<%= t("orders.payment_status.pending_aria") %>">
          <span class="inline-block h-[6px] w-[6px] rounded-full" style="background: var(--color-warn);" aria-hidden="true"></span>
          <span class="font-mono text-[10px] font-medium uppercase tracking-[0.1em]"><%= t("orders.payment_status.pending") %></span>
        </span>
      <% end %>
    </div>
    <div class="inline-flex items-center gap-1">
      <% if order.delivery? && order.geocoded? && !en_route && !order.canceled? %>
        <%= link_to directions_url_for(order),
              target: "_blank",
              rel: "noopener noreferrer",
              aria: { label: t("orders.map.directions_cta") },
              title: t("orders.map.directions_cta"),
              class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-accent hover:border-accent/40 transition-colors" do %>
          <%= icon(:navigation, size: :sm) %>
        <% end %>
      <% end %>

      <% if order.aasm.may_fire_event?(:cancel) %>
        <%= drawer_link_to new_order_cancellation_path(order),
              aria: { label: t("orders.transitions.cancel") },
              title: t("orders.transitions.cancel"),
              class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-err hover:border-err/40 transition-colors" do %>
          <%= icon(:x, size: :sm) %>
        <% end %>
      <% end %>

      <% if order.canceled? %>
        <%= button_to order_duplication_path(order),
              method: :post,
              form: { class: "inline-flex", data: { turbo_frame: "drawer_content" } },
              data: { action: "click->right-drawer#open" },
              aria: { label: t("orders.transitions.duplicate") },
              title: t("orders.transitions.duplicate"),
              class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-ink hover:border-line transition-colors" do %>
          <%= icon(:copy, size: :sm) %>
        <% end %>
      <% elsif !order.immutable? %>
        <%= drawer_link_to edit_order_path(order),
              aria: { label: t("orders.transitions.edit") },
              title: t("orders.transitions.edit"),
              class: "inline-flex items-center justify-center w-8 h-8 rounded-input text-muted border border-transparent hover:text-ink hover:border-line transition-colors" do %>
          <%= icon(:pencil, size: :sm) %>
        <% end %>
      <% end %>
    </div>
  </footer>

  <% if (primary = primary_transition_for(order)) %>
    <%= button_to public_send("#{primary}_order_path", order),
          method: :post,
          form: { class: "block" },
          class: "w-full inline-flex items-center justify-center gap-1.5 text-[13px] font-semibold px-3 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
      <span><%= t("orders.transitions.#{primary}") %></span>
    <% end %>
  <% end %>

  <%# Payment is orthogonal to fulfillment — available at every stage
      except `canceled`, both as a forward-take action ("Marcar pagado")
      and an undo ("Pago recibido ✓ · Deshacer"). The paid chip below
      the Total line on the card covers display; the buttons here are
      the capture action. %>
  <% unless order.canceled? %>
    <% if order.paid? %>
      <%= button_to unmark_paid_order_path(order),
            method: :post,
            form: { class: "block", data: { turbo_confirm: t("orders.transitions.unmark_paid_confirm") } },
            class: "w-full inline-flex items-center justify-center gap-1.5 text-[12px] font-medium px-3 py-[6px] rounded-button bg-transparent text-muted border border-transparent hover:border-line hover:text-ink-2 transition-colors" do %>
        <span><%= t("orders.transitions.unmark_paid") %></span>
      <% end %>
    <% else %>
      <%= button_to mark_paid_order_path(order),
            method: :post,
            form: { class: "block" },
            class: "w-full inline-flex items-center justify-center gap-1.5 text-[12px] font-medium px-3 py-[6px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" do %>
        <span><%= t("orders.transitions.mark_paid") %></span>
      <% end %>
    <% end %>
  <% end %>
</article>
