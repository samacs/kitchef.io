<% content_for :title, t("orders.edit.title") %>
<% content_for :page_title, t("orders.edit.title") %>
<% content_for :page_subtitle, t("orders.edit.subtitle") %>

<%# The turbo-frame wrapper lets this same template render both as a
    full page (direct visit to /orders/:id/edit) and inside the shared
    right drawer — `drawer_link_to` loads just the frame contents. %>
<%= turbo_frame_tag "drawer_content" do %>
  <div class="max-w-[820px] mx-auto flex flex-col gap-6 p-5 sm:p-6">
    <div class="bg-surface border border-line rounded-panel shadow-card p-6 sm:p-7">
      <div class="flex flex-col gap-2 mb-6">
        <%= render Ui::KickerComponent.new(text: t("orders.edit.kicker")) %>
        <h2 class="font-serif text-[24px] sm:text-[28px] leading-[1.1] tracking-[-0.01em] text-ink">
          <%= t("orders.edit.heading", id: order.to_param) %>
        </h2>
      </div>

      <%= render "form", order: order %>
    </div>

    <div class="bg-surface border border-line rounded-card p-5 flex items-center justify-between gap-4">
      <div class="flex flex-col gap-0.5">
        <span class="text-[13.5px] font-medium text-ink">
          <%= t("orders.danger_zone.title") %>
        </span>
        <span class="text-[12.5px] text-muted">
          <%= t("orders.danger_zone.sub") %>
        </span>
      </div>
      <%= button_to t("orders.form.delete"),
            order_path(order),
            method: :delete,
            form: { data: { turbo_confirm: t("orders.form.delete_confirm") } },
            class: "inline-flex items-center gap-2 text-[13px] font-semibold px-4 py-[9px] rounded-button bg-transparent text-err border border-err/40 hover:bg-err/5 transition-colors" %>
    </div>
  </div>
<% end %>
