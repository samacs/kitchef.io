<% content_for :title, t(".seo_title") %>

<div class="w-full max-w-[460px] flex flex-col gap-5">
  <div class="bg-surface border border-line rounded-panel shadow-card p-7 sm:p-9 flex flex-col gap-6">
    <div class="flex flex-col gap-3">
      <%= render Ui::KickerComponent.new(text: t(".kicker")) %>
      <h1 class="font-serif text-[38px] sm:text-[44px] leading-[1.04] tracking-[-0.02em] text-ink pb-[0.1em]">
        <%= t(".title_html").html_safe %>
      </h1>
      <p class="text-[15px] text-ink-2 leading-[1.55] max-w-[38ch]">
        <%= t(".lede") %>
      </p>
    </div>

    <%= form_with url: session_url, class: "flex flex-col gap-4" do |form| %>
      <%= render Ui::TextFieldComponent.new(
            id: "email_address",
            name: "email_address",
            type: :email,
            label: t(".email_label"),
            placeholder: t(".email_placeholder"),
            autocomplete: "username",
            autofocus: true,
            required: true,
            leading_icon: :mail,
            value: params[:email_address]) %>

      <%= render Ui::TextFieldComponent.new(
            id: "password",
            name: "password",
            type: :password,
            label: t(".password_label"),
            placeholder: t(".password_placeholder"),
            autocomplete: "current-password",
            required: true,
            maxlength: 72,
            leading_icon: :lock) %>

      <div class="flex items-center justify-between gap-4 -mt-1">
        <span></span>
        <%= link_to t(".forgot_password"), new_password_path,
              class: "text-[12.5px] font-medium text-ink-2 hover:text-accent transition-colors" %>
      </div>

      <%= form.submit t(".submit"),
            class: "mt-1 inline-flex items-center justify-center gap-2 w-full text-[14px] font-semibold px-[18px] py-[12px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta cursor-pointer" %>
    <% end %>
  </div>

  <div class="text-center text-[13.5px] text-ink-2">
    <%= t(".no_account_html", url: new_registration_path).html_safe %>
  </div>
</div>
