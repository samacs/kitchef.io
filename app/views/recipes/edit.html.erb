<% content_for :title, t("recipes.edit.title", name: recipe.name) %>
<% content_for :page_title, t("recipes.edit.title", name: recipe.name) %>
<% content_for :page_subtitle, t("recipes.edit.subtitle") %>

<div class="max-w-[860px] mx-auto flex flex-col gap-6">
  <div class="bg-surface border border-line rounded-panel shadow-card p-7 sm:p-9">
    <div class="flex flex-col gap-2 mb-6">
      <%= render Ui::KickerComponent.new(text: t("recipes.edit.kicker")) %>
      <h2 class="font-serif text-[28px] leading-[1.1] tracking-[-0.01em] text-ink">
        <%= recipe.name %>
      </h2>
    </div>

    <%= render "form", recipe: recipe %>
  </div>

  <div class="bg-surface border border-line rounded-card p-5 flex items-center justify-between gap-4">
    <div class="flex flex-col gap-0.5">
      <span class="text-[13.5px] font-medium text-ink">
        <%= t("recipes.danger_zone.title") %>
      </span>
      <span class="text-[12.5px] text-muted">
        <%= t("recipes.danger_zone.sub") %>
      </span>
    </div>
    <%= button_to t("recipes.form.delete"),
          recipe_path(recipe),
          method: :delete,
          form: { data: { turbo_confirm: t("recipes.form.delete_confirm") } },
          class: "inline-flex items-center gap-2 text-[13px] font-semibold px-4 py-[9px] rounded-button bg-transparent text-err border border-err/40 hover:bg-err/5 transition-colors" %>
  </div>
</div>
