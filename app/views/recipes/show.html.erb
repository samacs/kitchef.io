<% content_for :title, recipe.name %>
<% content_for :page_title, recipe.name %>
<% content_for :page_subtitle, t("recipes.show.subtitle") %>

<% content_for :page_action do %>
  <%= link_to edit_recipe_path(recipe),
        class: "inline-flex items-center gap-2 text-[13px] font-medium px-3.5 py-[8px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" do %>
    <%= icon(:pencil, size: :xs) %>
    <span><%= t("recipes.show.edit_cta") %></span>
  <% end %>
<% end %>

<div class="max-w-[820px] mx-auto flex flex-col gap-6">
  <%# Phase 13 — quick stock summary + "empezar producción" CTA. Only
      visible when the operator has flipped on the inventory toggle. %>
  <% if Current.account.inventory_enabled? && recipe.is_saleable? %>
    <% available_today = Orders::BatchPicker.available_units(account: Current.account, recipe: recipe, on_date: Date.current) %>
    <% policy = Current.account.inventory_settings.oversell_policy %>
    <% empty = available_today.to_i.zero? %>
    <% emphasis = empty ? (policy == "block" ? "border-err/40 bg-[color-mix(in_oklab,var(--color-err)_6%,var(--color-surface))]" : "border-warn/40 bg-[color-mix(in_oklab,var(--color-warn)_6%,var(--color-surface))]") : "border-line bg-surface" %>
    <section class="rounded-panel border <%= emphasis %> p-5 flex items-center justify-between gap-4 flex-wrap">
      <div class="flex flex-col gap-1.5">
        <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] <%= empty && policy == "block" ? "text-err" : (empty ? "text-warn" : "text-muted") %>">
          <%= t("recipes.show.stock_kicker") %>
        </span>
        <div class="flex items-baseline gap-2">
          <span class="font-mono text-[22px] tabular-nums <%= empty ? "text-ink" : "text-ink" %>"><%= available_today.to_i %></span>
          <span class="text-[12.5px] text-ink-2"><%= t("recipes.show.stock_units_today") %></span>
        </div>
        <% if empty %>
          <p class="text-[12.5px] <%= policy == "block" ? "text-err" : "text-warn" %> max-w-[460px] leading-[1.5]">
            <%= t("recipes.show.stock_empty_explainer.#{policy}") %>
          </p>
        <% end %>
      </div>
      <%= link_to new_batch_path(batch: { recipe_id: recipe.id }),
            class: "inline-flex items-center gap-1.5 rounded-button bg-accent text-bg border border-accent px-3.5 py-2 text-[13px] font-semibold no-underline hover:bg-accent-2" do %>
        <%= icon(:plus, size: :xs) %>
        <%= t("recipes.show.start_batch_cta") %>
      <% end %>
    </section>
  <% end %>

  <section class="bg-surface border border-line rounded-panel shadow-card p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row gap-6 items-start">
      <% if recipe.photos.attached? %>
        <img src="<%= url_for(recipe.photos.first.variant(:card)) %>"
             alt="<%= recipe.name %>"
             class="w-[160px] h-[160px] rounded-card object-cover shadow-card shrink-0" />
      <% end %>

      <div class="flex-1 min-w-0 flex flex-col gap-3">
        <div class="flex flex-col gap-1">
          <%= render Ui::KickerComponent.new(text: recipe.category&.name) %>
          <h1 class="font-serif text-[32px] leading-[1.1] tracking-[-0.01em] text-ink">
            <%= recipe.name %>
          </h1>
          <% if recipe.internal? %>
            <span class="inline-flex items-center gap-1.5 rounded-pill bg-bg-2 text-muted text-[11px] font-medium px-2.5 py-[3px] border border-line self-start mt-1">
              <%= t("recipes.internal_badge") %>
            </span>
          <% end %>
        </div>

        <% if recipe.is_saleable? %>
          <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-baseline gap-2">
              <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted"><%= t("recipes.show.sale_price") %></span>
              <span class="font-mono text-[22px] text-ink tabular-nums"><%= humanized_money_with_symbol(recipe.sale_price) %></span>
            </div>
            <%= render Recipes::MarginChipComponent.new(recipe: recipe) %>
          </div>
        <% end %>

        <% if recipe.description.present? %>
          <p class="text-[14px] text-ink-2 leading-[1.55] whitespace-pre-line max-w-prose">
            <%= recipe.description %>
          </p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="bg-surface border border-line rounded-panel shadow-card p-6 sm:p-8">
    <div class="flex items-baseline justify-between gap-3 mb-4">
      <div class="flex flex-col gap-1">
        <%= render Ui::KickerComponent.new(text: t("recipes.cost_tree.kicker")) %>
        <h2 class="font-serif text-[22px] leading-[1.15] text-ink">
          <%= t("recipes.cost_tree.title") %>
        </h2>
      </div>
      <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-muted">
        <%= t("recipes.cost_tree.per_unit", unit: I18n.t("units.#{recipe.yield_unit}", default: recipe.yield_unit)) %>
      </span>
    </div>

    <% if @cost_tree_root.children.empty? %>
      <p class="text-[13.5px] text-muted py-4">
        <%= t("recipes.cost_tree.empty") %>
      </p>
    <% else %>
      <%= render Recipes::CostTreeComponent.new(node: @cost_tree_root) %>
    <% end %>
  </section>
</div>
