<%# Re-renderable rows section for the decomposition editor. Wrapped in a
    stable DOM id so RecipesController#update can swap it back after autosave
    completes — otherwise newly-added rows have no `id` field and every
    subsequent autosave creates a duplicate component in the DB. %>
<div id="recipe_components_rows" class="flex flex-col gap-3 min-w-0">
  <% components = recipe.components.includes(:componentable).order(:position, :id) %>

  <% if components.empty? %>
    <p class="text-[13px] text-muted italic py-2">
      <%= t("recipes.components.empty") %>
    </p>
  <% else %>
    <ol class="flex flex-col divide-y divide-line rounded-card-sm bg-surface border border-line overflow-x-auto">
      <% components.each_with_index do |component, index| %>
        <% prefix = "recipe[components_attributes][#{index}]" %>
        <li id="component_<%= component.componentable_type.downcase %>_<%= component.componentable_id %>"
            class="flex flex-col gap-2 px-3 py-3 sm:px-4 sm:flex-row sm:items-center sm:gap-3 <%= 'bg-accent-soft/30' if component.is_byproduct? %>"
            data-recipes-components-target="row"
            data-componentable-type="<%= component.componentable_type %>"
            data-componentable-id="<%= component.componentable_id %>">
          <input type="hidden" name="<%= prefix %>[id]" value="<%= component.id %>" />
          <input type="hidden" name="<%= prefix %>[componentable_type]" value="<%= component.componentable_type %>" />
          <input type="hidden" name="<%= prefix %>[componentable_id]" value="<%= component.componentable_id %>" />
          <input type="hidden" name="<%= prefix %>[_destroy]" value="0"
                 data-recipes-components-target="destroyFlag" />
          <input type="hidden" name="<%= prefix %>[is_byproduct]"
                 value="<%= component.is_byproduct? ? '1' : '0' %>"
                 data-field="is_byproduct" />

          <div class="flex items-center justify-between gap-2 sm:contents">
            <div class="flex items-center gap-2">
              <input type="number"
                     name="<%= prefix %>[quantity]"
                     value="<%= component.quantity.to_s.sub(/\.0+\z/, "") %>"
                     step="0.01" min="0"
                     aria-label="<%= t("recipes.components.quantity_label") %>"
                     class="w-16 sm:w-20 bg-surface text-ink border border-line hover:border-line-2 rounded-input px-2 py-1.5 text-[13px] font-mono text-right tabular-nums focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none" />

              <select name="<%= prefix %>[unit]"
                      aria-label="<%= t("recipes.components.unit_label") %>"
                      class="w-20 sm:w-24 bg-surface text-ink border border-line hover:border-line-2 rounded-input px-2 py-1.5 text-[13px] focus:border-accent focus:ring-2 focus:ring-accent/20 outline-none">
                <% Recipes::UnitConverter.compatible_units_for(component.componentable_canonical_unit || component.unit).each do |u| %>
                  <option value="<%= u %>" <%= "selected" if u == component.unit %>>
                    <%= I18n.t("units.#{u}", default: u) %>
                  </option>
                <% end %>
              </select>

              <span class="text-[13.5px] text-ink truncate sm:hidden">
                <%= component.componentable&.name %>
              </span>
            </div>

            <div class="flex items-center gap-2 sm:hidden">
              <span class="font-mono text-[12px] tabular-nums whitespace-nowrap <%= component.is_byproduct? ? 'text-accent line-through' : 'text-muted' %>">
                <%= line_cost_label_for(component) %>
              </span>
              <button type="button"
                      data-action="click->recipes-components#remove"
                      aria-label="<%= t("recipes.components.remove_aria") %>"
                      class="inline-flex items-center justify-center w-7 h-7 rounded-input text-muted hover:text-err hover:bg-err/5 transition-colors">
                <%= icon(:x, size: :sm) %>
              </button>
            </div>
          </div>

          <div class="hidden sm:flex flex-1 min-w-0 flex-col gap-0.5">
            <span class="text-[13.5px] text-ink truncate">
              <%= component.componentable&.name %>
            </span>
            <div class="flex items-center gap-1.5 flex-wrap">
              <% if component.componentable.is_a?(Recipe) && !component.componentable.is_saleable? %>
                <span class="text-[11px] text-muted">
                  <%= t("recipes.components.internal_tag") %>
                </span>
              <% end %>
              <span data-byproduct-badge
                    class="inline-flex items-center gap-1 rounded-full bg-accent-soft px-1.5 py-0.5 text-[10px] font-medium text-accent"
                    <%= "hidden" unless component.is_byproduct? %>>
                <%= t("recipes.components.byproduct_tag") %>
              </span>
              <% if component.componentable.is_a?(Recipe) %>
                <button type="button"
                        data-action="click->recipes-components#toggleByproduct"
                        class="text-[10.5px] font-medium hover:underline <%= component.is_byproduct? ? 'text-accent' : 'text-muted' %>">
                  <%= component.is_byproduct? ? t("recipes.components.byproduct_undo") : t("recipes.components.byproduct_mark") %>
                </button>
              <% end %>
            </div>
          </div>

          <span class="hidden sm:inline font-mono text-[13px] tabular-nums whitespace-nowrap <%= component.is_byproduct? ? 'text-accent line-through' : 'text-ink-2' %>">
            <%= line_cost_label_for(component) %>
          </span>

          <button type="button"
                  data-action="click->recipes-components#remove"
                  aria-label="<%= t("recipes.components.remove_aria") %>"
                  title="<%= t("recipes.components.remove_aria") %>"
                  class="hidden sm:inline-flex items-center justify-center w-7 h-7 rounded-input text-muted hover:text-err hover:bg-err/5 transition-colors">
            <%= icon(:x, size: :sm) %>
          </button>
        </li>
      <% end %>
    </ol>
  <% end %>
</div>
