<% content_for :title, t("recipes.index.title") %>
<% content_for :page_title, t("recipes.index.title") %>
<% content_for :page_subtitle, t("recipes.index.subtitle") %>

<% content_for :page_action do %>
  <%= link_to new_recipe_path,
        class: "inline-flex items-center gap-2 text-[13px] font-semibold px-3.5 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
    <%= icon(:plus, size: :xs) %>
    <span><%= t("recipes.index.cta") %></span>
  <% end %>
<% end %>

<% if flash[:notice].present? %>
  <div class="mb-5">
    <%= render Ui::FlashComponent.new(kind: :notice, message: flash[:notice]) %>
  </div>
<% end %>

<% if recipes.empty? %>
  <%= render Recipes::EmptyStateComponent.new(
        headline_key: "recipes.empty_state.headline",
        sub_key:      "recipes.empty_state.sub",
        cta_label_key: "recipes.empty_state.cta",
        cta_href: new_recipe_path) %>
<% else %>
  <div class="flex flex-col gap-10">
    <% recipes.group_by(&:category).each do |category, group| %>
      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="font-serif text-[22px] leading-[1.15] tracking-[-0.01em] text-ink">
            <%= t("recipe.categories.#{category}") %>
          </h2>
          <span class="font-mono text-[12px] text-muted uppercase tracking-[0.14em]">
            <%= t("recipes.index.count", count: group.size) %>
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
          <% group.each do |item| %>
            <%= render Recipes::CardComponent.new(recipe: item) %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
