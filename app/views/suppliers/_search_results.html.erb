<% if results.empty? %>
  <p class="px-3 py-2 text-[12.5px] text-muted"><%= t("suppliers.search.empty") %></p>
<% else %>
  <ul class="divide-y divide-line">
    <% results.each do |supplier| %>
      <li>
        <button type="button"
                data-action="supplier-picker#pick"
                data-supplier-id="<%= supplier.id %>"
                data-supplier-label="<%= supplier.name %>"
                class="w-full px-3 py-2 text-left text-[13px] text-ink hover:bg-bg-2/40 transition-colors">
          <%= supplier.name %>
          <% if supplier.display_phone %>
            <span class="font-mono text-[11.5px] text-muted ml-2"><%= supplier.display_phone %></span>
          <% end %>
        </button>
      </li>
    <% end %>
  </ul>
<% end %>
