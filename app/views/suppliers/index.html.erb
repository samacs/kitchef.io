<% content_for :title, t("suppliers.index.title") %>
<% content_for :page_title, t("suppliers.index.title") %>
<% content_for :page_subtitle, t("suppliers.index.subtitle") %>
<% content_for :fab_path, new_supplier_path %>

<% content_for :page_action do %>
  <%= link_to new_supplier_path,
        class: "inline-flex items-center gap-2 text-[13px] font-semibold px-3.5 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
    <%= icon(:plus, size: :xs) %>
    <span><%= t("suppliers.index.cta") %></span>
  <% end %>
<% end %>

<% if suppliers.empty? && params[:q].blank? %>
  <%= render Recipes::EmptyStateComponent.new(
        headline_key: "suppliers.empty_state.headline",
        sub_key:      "suppliers.empty_state.sub",
        cta_label_key: "suppliers.empty_state.cta",
        cta_href: new_supplier_path) %>
<% else %>
  <div class="flex flex-col gap-5">
    <%= form_with url: suppliers_path,
          method: :get,
          html: {
            class: "flex items-center gap-3",
            data: {
              controller: "search-debounce",
              action: "input->search-debounce#search submit->search-debounce#search",
              turbo_frame: "suppliers_results",
              turbo_action: "advance"
            }
          } do |form| %>
      <span class="relative flex-1 max-w-[420px]">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted pointer-events-none">
          <%= icon(:search, size: :xs) %>
        </span>
        <%= form.search_field :q,
              value: params[:q],
              autocomplete: "off",
              placeholder: t("suppliers.index.search_placeholder"),
              class: "w-full pl-9 pr-3 py-2 bg-surface border border-line rounded-input text-[13.5px] text-ink placeholder:text-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" %>
      </span>
      <span class="font-mono text-[12px] text-muted uppercase tracking-[0.14em]">
        <%= t("suppliers.index.count", count: suppliers.size) %>
      </span>
    <% end %>

    <%= render "results", suppliers: suppliers %>
  </div>
<% end %>
