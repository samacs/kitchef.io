<%#
  Ubicación panel — renders the cached static map (ActiveStorage
  attachment; regenerated by SupplierStaticMapJob on coord changes)
  with a click-through to Google Maps directions.

  Three states:
    1. Geocoded + static map attached — show the image, click opens
       Google Maps for navigation from the operator's current spot.
    2. Geocoded but no attachment yet — the background job is still
       fetching the tile; show a subtle placeholder with the
       directions link.
    3. Not geocoded — show an empty "agrega dirección para ubicarlo"
       hint (or the "no se pudo ubicar" message when a geocode attempt
       failed).
%>
<section class="flex flex-col gap-3">
  <header class="flex flex-col gap-1">
    <span class="font-mono text-[10.5px] uppercase tracking-[0.18em] text-muted">
      <%= t("suppliers.location.kicker") %>
    </span>
    <p class="text-[12.5px] text-muted leading-[1.45] max-w-[52ch]">
      <%= t("suppliers.location.lede") %>
    </p>
  </header>

  <% if supplier.geocoded? %>
    <% directions = directions_url_for(supplier) %>
    <div class="flex flex-col gap-2">
      <a href="<%= directions %>" target="_blank" rel="noopener"
         class="group relative block rounded-card overflow-hidden border border-line bg-bg-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg">
        <%= static_map_image_tag(supplier,
              variant: :card,
              alt: t("suppliers.location.alt", name: supplier.name),
              loading: "lazy",
              class: "w-full h-auto block") %>
        <span class="absolute inset-0 flex items-end justify-end p-3 bg-gradient-to-t from-ink/60 via-ink/0 to-ink/0 opacity-0 group-hover:opacity-100 transition-opacity">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold px-3 py-[7px] rounded-button bg-surface text-accent border border-line shadow-card">
            <%= icon(:navigation, size: :xs) %>
            <%= t("suppliers.location.open_in_maps") %>
          </span>
        </span>
      </a>

      <a href="<%= directions %>" target="_blank" rel="noopener"
         class="self-start inline-flex items-center gap-1.5 text-[13px] font-medium text-accent hover:underline">
        <%= icon(:map_pin, size: :xs) %>
        <%= t("suppliers.location.open_in_maps") %>
      </a>
    </div>
  <% elsif supplier.geocoding_failed_at.present? %>
    <p class="rounded-card border border-warn/30 bg-[color-mix(in_oklab,var(--color-warn)_10%,var(--color-surface))] text-[12.5px] text-warn leading-[1.5] px-4 py-3">
      <%= t("suppliers.location.geocoding_failed") %>
    </p>
  <% else %>
    <p class="rounded-card border border-dashed border-line bg-bg-2/40 text-[12.5px] text-muted leading-[1.5] px-4 py-3">
      <%= t("suppliers.location.empty") %>
    </p>
  <% end %>
</section>
