<% content_for :title, t("dashboard.title") %>
<% content_for :page_title, t("dashboard.title") %>
<% content_for :page_subtitle, t("dashboard.subtitle") %>

<% if @recipe_count.zero? %>
  <%= render Recipes::EmptyStateComponent.new(
        headline_key: "dashboard.empty_state.headline",
        sub_key:      "dashboard.empty_state.sub",
        cta_label_key: "dashboard.empty_state.cta",
        cta_href: new_recipe_path) %>
<% else %>
  <%# Bento grid: 3 columns on large screens, 2 on medium, stacked on mobile.
      Cards claim space based on content density — not uniform boxes. %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-5">

    <%# Row 1: Summary · Today · Upcoming work %>

    <%# Weekly snapshot — tall, medium-width (revenue, margin, comparison, net profit) %>
    <div class="md:col-span-1">
      <%= render Dashboards::WeeklySnapshotComponent.new(account: @account) %>
    </div>

    <%# Today — compact date + state badges. On medium screens shares
        the row with the snapshot; on large screens gets its own narrow column. %>
    <div class="md:col-span-1 lg:col-span-1">
      <%= render Dashboards::TodayCardComponent.new(plan: @today_plan, today: @today) %>
    </div>

    <%# Upcoming work — tall list of recipes/ingredients + alerts.
        On medium screens drops to its own row spanning full width;
        on large screens fills the 3rd column alongside the first two. %>
    <div class="md:col-span-2 lg:col-span-1">
      <%= render Dashboards::UpcomingWorkComponent.new(
            account: @account,
            weekly_list: @weekly_list,
            low_stock_ingredients: @low_stock_ingredients || []) %>
    </div>

    <%# Row 2: Recent orders (wide) · Menu health (compact) %>

    <%# Recent orders — needs horizontal space for name + badge + price columns %>
    <div class="md:col-span-2 lg:col-span-2">
      <%= render Dashboards::RecentOrdersComponent.new(orders: @recent_orders) %>
    </div>

    <%# Menu health — compact: counts + top sellers %>
    <div class="md:col-span-2 lg:col-span-1">
      <%= render Dashboards::MenuHealthComponent.new(
            account: @account,
            published_count: @published_count,
            draft_count: @draft_count) %>
    </div>
  </div>
<% end %>
