<%= form_with model: client,
      url: client.persisted? ? client_path(client) : clients_path,
      class: "flex flex-col gap-5" do |form| %>

  <% if client.errors.any? %>
    <div role="alert"
         class="bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))] text-err border border-err/30 rounded-[10px] px-4 py-3 flex flex-col gap-1.5">
      <span class="text-[12px] font-mono uppercase tracking-[0.14em]">
        <%= t("onboarding.shared.errors_title") %>
      </span>
      <ul class="text-[13px] leading-[1.4] list-disc list-inside">
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render Ui::TextFieldComponent.new(
          name: "client[first_name]",
          id: "client_first_name",
          label: t("clients.form.first_name_label"),
          placeholder: t("clients.form.first_name_placeholder"),
          value: client.first_name,
          required: true,
          autofocus: client.new_record?) %>
    <%= render Ui::TextFieldComponent.new(
          name: "client[last_name]",
          id: "client_last_name",
          label: t("clients.form.last_name_label"),
          placeholder: t("clients.form.last_name_placeholder"),
          value: client.last_name) %>
  </div>

  <%= render Ui::TextFieldComponent.new(
        name: "client[phone]",
        id: "client_phone",
        type: :tel,
        label: t("clients.form.phone_label"),
        placeholder: t("clients.form.phone_placeholder"),
        value: client.phone,
        hint: t("clients.form.phone_hint")) %>

  <%= render Ui::TextFieldComponent.new(
        name: "client[email]",
        id: "client_email",
        type: :email,
        label: t("clients.form.email_label"),
        placeholder: t("clients.form.email_placeholder"),
        value: client.email) %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render Ui::TextFieldComponent.new(
          name: "client[colonia]",
          id: "client_colonia",
          label: t("clients.form.colonia_label"),
          placeholder: t("clients.form.colonia_placeholder"),
          value: client.colonia) %>
    <%= render Ui::TextFieldComponent.new(
          name: "client[city]",
          id: "client_city",
          label: t("clients.form.city_label"),
          placeholder: t("clients.form.city_placeholder"),
          value: client.city) %>
  </div>

  <%= render Ui::TextFieldComponent.new(
        name: "client[street_address]",
        id: "client_street_address",
        label: t("clients.form.street_address_label"),
        placeholder: t("clients.form.street_address_placeholder"),
        value: client.street_address) %>

  <label for="client_notes" class="flex flex-col gap-2">
    <span class="text-[13px] font-medium text-ink leading-none">
      <%= t("clients.form.notes_label") %>
    </span>
    <%= form.text_area :notes,
          id: "client_notes",
          rows: 3,
          placeholder: t("clients.form.notes_placeholder"),
          class: "w-full bg-surface text-ink placeholder:text-muted border border-line hover:border-line-2 rounded-input px-3.5 py-2.5 text-[14px] leading-[1.5] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 resize-y" %>
  </label>

  <div class="flex items-center justify-between gap-3 pt-2">
    <%= link_to t("clients.form.cancel"),
          clients_path,
          data: { action: "click->right-drawer#close" },
          class: "inline-flex items-center justify-center gap-2 text-[13px] font-medium px-4 py-[10px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" %>

    <%= form.submit(client.persisted? ? t("clients.form.submit_update") : t("clients.form.submit_create"),
          class: "inline-flex items-center justify-center gap-2 text-[14px] font-semibold px-[22px] py-[10px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta") %>
  </div>
<% end %>
