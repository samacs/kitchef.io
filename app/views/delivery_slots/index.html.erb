<% content_for :title, t("delivery_slots.title") %>
<% content_for :page_title, t("delivery_slots.index.title") %>
<% content_for :page_subtitle, t("delivery_slots.index.subtitle") %>

<% if flash[:notice].present? %>
  <div class="mb-5">
    <%= render Ui::FlashComponent.new(kind: :notice, message: flash[:notice]) %>
  </div>
<% end %>
<% if flash[:alert].present? %>
  <div class="mb-5">
    <%= render Ui::FlashComponent.new(kind: :alert, message: flash[:alert]) %>
  </div>
<% end %>

<%# Monday-first weekday grid. One row per weekday — the operator picks
    start/end/capacity, or leaves the day closed by deleting the slot.
    v1 is deliberately one slot per weekday (morning-only, afternoon-only,
    etc.); multi-slot days ship when we hear an operator ask. %>
<section class="grid grid-cols-1 gap-3 lg:grid-cols-2 xl:grid-cols-3">
  <% [ 1, 2, 3, 4, 5, 6, 0 ].each do |dow| %>
    <% slot = @slots_by_day[dow]&.first %>
    <% fill = slot ? @fill_levels[slot.id].to_i : 0 %>
    <%= render Production::SlotRowComponent.new(day_of_week: dow, slot: slot, fill_level: fill) %>
  <% end %>
</section>

<p class="mt-8 text-muted text-[12.5px] max-w-prose">
  <%= t("delivery_slots.capacity.hint") %>
</p>
