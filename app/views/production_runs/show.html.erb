<% content_for :title, @run.recipe.name %>
<% content_for :page_title, @run.recipe.name %>
<% content_for :page_subtitle, l(@run.cooked_on, format: :long) %>

<div class="max-w-[820px] flex flex-col gap-6">
  <section class="rounded-panel border border-line bg-surface p-6 flex items-center justify-between gap-4 flex-wrap">
    <div class="flex flex-col gap-2 min-w-0">
      <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
        <%= t("production.runs.show.title") %>
      </span>
      <div class="flex items-baseline gap-3">
        <span class="font-serif text-[32px] tabular-nums text-ink">
          <%= @run.actual_quantity.to_i %>
        </span>
        <span class="text-[13px] text-ink-2"><%= t("production.runs.show.units_label").downcase %></span>
        <span class="inline-flex items-center rounded-pill border border-line bg-bg-2 px-2.5 py-0.5 font-mono text-[10.5px] uppercase tracking-[0.08em] text-muted">
          <%= t("production.runs.state.#{@run.state}") %>
        </span>
      </div>
      <span class="font-mono text-[12px] text-muted">
        <%= t("production.runs.index.units_remaining", count: [ @run.units_remaining.to_i, 0 ].max) %>
        · <%= t("production.runs.index.sold_count", count: @run.units_consumed.to_i) %>
      </span>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if @run.aasm.may_fire_event?(:complete) %>
        <%= button_to t("production.runs.show.complete_cta"),
              complete_production_run_path(@run),
              method: :post,
              class: "inline-flex items-center gap-1.5 rounded-button border border-line bg-surface px-3 py-1.5 text-[12.5px] font-medium text-ink-2 hover:border-line-2 cursor-pointer" %>
      <% end %>
      <% if @run.aasm.may_fire_event?(:cancel) %>
        <%= button_to t("production.runs.show.cancel_cta"),
              cancel_production_run_path(@run),
              method: :post,
              data: { turbo_confirm: t("production.runs.show.cancel_confirm") },
              class: "inline-flex items-center gap-1.5 rounded-button border border-err/40 bg-transparent px-3 py-1.5 text-[12.5px] font-medium text-err hover:bg-err/5 cursor-pointer" %>
      <% end %>
    </div>
  </section>

  <% if @run.consumptions.any? %>
    <section class="rounded-panel border border-line bg-surface p-6">
      <h3 class="font-serif text-[18px] text-ink mb-4">
        <%= t("production.runs.show.consumption_label") %>
      </h3>
      <ul class="flex flex-col divide-y divide-line">
        <% @run.consumptions.includes(:consumable).each do |consumption| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <span class="text-[13px] text-ink"><%= consumption.consumable&.name || "—" %></span>
            <span class="font-mono text-[13px] tabular-nums text-warn">
              −<%= format("%.3f", consumption.quantity_consumed.to_d).sub(/\.?0+$/, "") %> <%= consumption.unit %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% pedidos = @run.order_items.includes(:order).where.not(order_id: nil) %>
  <% if pedidos.any? %>
    <section class="rounded-panel border border-line bg-surface p-6">
      <h3 class="font-serif text-[18px] text-ink mb-4">
        <%= t("production.runs.show.orders_label") %>
      </h3>
      <ul class="flex flex-col divide-y divide-line">
        <% pedidos.each do |item| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <%= link_to item.order.prefix_id, order_path(item.order),
                  class: "font-mono text-[12.5px] text-ink-2 hover:underline no-underline" %>
            <span class="font-mono text-[13px] tabular-nums text-ink">
              <%= item.consumed_quantity.to_i %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
