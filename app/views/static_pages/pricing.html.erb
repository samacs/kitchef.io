<% content_for :title, t("meta.pages.pricing.title") %>
<% content_for :description, t("meta.pages.pricing.description") %>

<% content_for :json_ld do %>
  <%= json_ld_software_application %>
  <%= json_ld_faq_page(t("marketing.pricing.faq.items")) %>
<% end %>

<%# ── Hero ─────────────────────────────────────────────────────────── %>
<section class="pt-[88px] pb-12">
  <div class="mx-auto max-w-[1240px] px-7 text-center">
    <div class="inline-flex items-center gap-2 font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4 justify-center">
      <span class="w-5 h-px bg-accent"></span>
      <%= t("marketing.pricing.kicker") %>
    </div>
    <h1 class="font-serif text-[clamp(40px,5vw,68px)] leading-[1.02] tracking-tight text-ink mb-5 mx-auto max-w-[820px]">
      <%= t("marketing.pricing.headline_html").html_safe %>
    </h1>
    <p class="text-[17px] leading-[1.55] text-ink-2 mx-auto max-w-[640px]">
      <%= t("marketing.pricing.lede") %>
    </p>
  </div>
</section>

<%# ── Cards + toggle ──────────────────────────────────────────────── %>
<section class="pb-12">
  <div class="mx-auto max-w-[1240px] px-7">
    <%= render Marketing::PricingCardsComponent.new(variant: :wide, default_period: :yearly) %>
  </div>
</section>

<%# ── No-card-during-trial reassurance row ─────────────────────────── %>
<section class="pb-16">
  <div class="mx-auto max-w-[820px] px-7">
    <div class="rounded-card border border-line bg-surface px-6 py-5 flex items-start gap-4">
      <span class="inline-flex h-[40px] w-[40px] items-center justify-center rounded-full bg-accent-soft text-accent shrink-0">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="6" width="18" height="13" rx="2"/>
          <path d="M3 10h18"/>
          <line x1="7" y1="15" x2="11" y2="15"/>
        </svg>
      </span>
      <div class="flex flex-col gap-1 min-w-0">
        <div class="text-[14px] font-semibold text-ink">
          <%= t("marketing.pricing.no_card.title") %>
        </div>
        <div class="text-[13.5px] text-ink-2 leading-[1.5]">
          <%= t("marketing.pricing.no_card.body") %>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Trust strip ─────────────────────────────────────────────────── %>
<section class="pb-20">
  <div class="mx-auto max-w-[1100px] px-7">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 text-center">
      <% t("marketing.pricing.trust_strip").each do |item| %>
        <div class="rounded-card border border-line bg-surface px-3 py-4 flex flex-col gap-1">
          <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-accent">
            <%= item[:kicker] %>
          </span>
          <span class="text-[13px] text-ink-2 leading-[1.4]">
            <%= item[:body] %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── Feature comparison ──────────────────────────────────────────── %>
<section class="pb-20">
  <div class="mx-auto max-w-[920px] px-7">
    <div class="text-center mb-8">
      <h2 class="font-serif text-[clamp(28px,3.4vw,40px)] leading-[1.1] tracking-tight text-ink mb-2">
        <%= t("marketing.feature_comparison.headline") %>
      </h2>
      <p class="text-[14.5px] leading-[1.55] text-ink-2 mx-auto max-w-[560px]">
        <%= t("marketing.feature_comparison.lede") %>
      </p>
    </div>
    <%= render Marketing::FeatureComparisonComponent.new %>
  </div>
</section>

<%# ── FAQ ─────────────────────────────────────────────────────────── %>
<section class="pb-24">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-14 items-start">
      <div>
        <h2 class="font-serif text-[clamp(28px,3.4vw,44px)] leading-[1.05] tracking-tight text-ink mb-3.5">
          <%= t("marketing.pricing.faq.headline_html").html_safe %>
        </h2>
        <p class="text-[15px] leading-[1.55] text-ink-2">
          <%= t("marketing.pricing.faq.lede") %>
        </p>
      </div>
      <div class="flex flex-col border border-line rounded-card overflow-hidden bg-surface">
        <% t("marketing.pricing.faq.items").each_with_index do |item, idx| %>
          <details class="border-b border-line last:border-b-0 group" <%= "open" if idx == 0 %>>
            <summary class="flex items-center justify-between gap-4 px-6 py-5 text-[16px] font-medium text-ink leading-[1.4] select-none">
              <%= item[:q] %>
              <span class="w-[22px] h-[22px] rounded-full bg-bg-2 text-ink-2 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-45 group-open:bg-accent group-open:text-bg">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-5 text-[15px] leading-[1.6] text-ink-2 max-w-[680px]">
              <%= item[:a] %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </div>
</section>
