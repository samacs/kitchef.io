<% content_for :title, t("marketing.home.title") %>

<%# ── Hero ──────────────────────────────────────────────────────────── %>
<section class="py-11 lg:py-16">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-9 lg:gap-14 items-center">
      <%# Left column: headline + CTAs %>
      <div>
        <div class="inline-flex items-center gap-2.5 mb-6">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-medium px-2.5 py-1 rounded-pill border border-transparent bg-accent-soft text-accent">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <%= t("marketing.home.trust.no_commission") %>
          </span>
        </div>

        <h1 class="font-serif text-[clamp(44px,6.2vw,78px)] leading-[1.15] tracking-tight text-ink mb-10 pb-[.15em]">
          <%= t("marketing.home.headline_html").html_safe %>
        </h1>

        <p class="text-[18px] leading-[1.55] text-ink-2 max-w-[520px] mb-8">
          <%= t("marketing.home.lede") %>
        </p>

        <div class="flex flex-wrap gap-2.5 items-center">
          <%= link_to t("marketing.home.cta_primary"), new_registration_path,
                class: "inline-flex items-center gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" %>
          <%= link_to t("marketing.home.cta_secondary"), "#producto",
                class: "inline-flex items-center gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-surface text-ink border border-line hover:border-line-2 transition-colors" %>
        </div>

        <div class="flex flex-wrap gap-5 items-center mt-8 pt-6 border-t border-line">
          <% %w[no_card cancel_anytime no_commission].each do |key| %>
            <div class="flex items-center gap-[7px] text-[12.5px] text-muted">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <%= t("marketing.home.trust.#{key}") %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Right column: hero visual — photo plate + floating dashboard %>
      <div class="kc-hero-visual">
        <%# Photo plate (bottom-left) %>
        <div class="kc-photo-plate">
          <div class="absolute left-4 top-4 z-[2] font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/80 bg-[rgba(14,23,20,0.4)] backdrop-blur-[6px] px-2.5 py-[5px] rounded-pill">
            Cocina de Elena · CDMX
          </div>
          <div class="absolute inset-0 flex items-end justify-center">
            <svg viewBox="0 0 200 240" preserveAspectRatio="xMidYMax slice" class="w-full h-[85%] opacity-45" aria-hidden="true">
              <defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#2A1B10" stop-opacity=".35"/><stop offset="100%" stop-color="#0E0906" stop-opacity=".55"/></linearGradient></defs>
              <path fill="url(#sg)" d="M100 60 C 130 60 140 85 138 105 C 136 120 128 125 125 130 C 125 140 130 145 135 150 L 170 160 C 185 165 195 180 195 200 L 195 240 L 5 240 L 5 200 C 5 180 15 165 30 160 L 65 150 C 70 145 75 140 75 130 C 72 125 64 120 62 105 C 60 85 70 60 100 60 Z"/>
            </svg>
          </div>
          <div class="absolute left-4 bottom-4 right-4 z-[2] text-white">
            <div class="font-serif italic text-[22px] leading-[1.1]">"Mis tamales ahora cuestan lo que deben."</div>
            <div class="font-mono text-[11px] tracking-[0.1em] uppercase opacity-85 mt-1">— Elena M. · Tamalería casera</div>
          </div>
        </div>

        <%# Dashboard card (top-right, floats) %>
        <div class="kc-dash kc-float">
          <div class="flex items-center gap-2.5 px-4 py-3 border-b border-line bg-bg-2 text-[12.5px] text-muted">
            <div class="flex gap-[5px]">
              <i class="block w-[9px] h-[9px] rounded-full bg-line-2"></i>
              <i class="block w-[9px] h-[9px] rounded-full bg-line-2"></i>
              <i class="block w-[9px] h-[9px] rounded-full bg-line-2"></i>
            </div>
            <div class="flex-1 text-center font-mono text-[11.5px] text-muted">kitchef.mx/elena</div>
          </div>
          <div class="p-[22px]">
            <%# Header %>
            <div class="flex justify-between items-start mb-[18px] gap-3">
              <div class="min-w-0 flex-1">
                <h3 class="font-serif text-[22px] text-ink tracking-tight truncate">Esta semana</h3>
                <div class="text-[12px] text-muted mt-0.5 truncate">Lun 13 – Dom 19 abr</div>
              </div>
              <div class="font-mono text-[11px] bg-bg-2 text-ink-2 px-2.5 py-[5px] rounded-input shrink-0">7D</div>
            </div>
            <%# Stats %>
            <div class="grid grid-cols-3 gap-2.5 mb-[18px]">
              <div class="p-3 border border-line rounded-card-sm bg-surface">
                <div class="text-[11px] text-muted font-medium tracking-[0.04em] uppercase mb-[5px]">Ventas</div>
                <div class="font-serif text-[24px] leading-none text-ink flex items-baseline gap-1.5 tracking-tight">$13,400 <span class="font-mono text-[11px] text-accent font-medium">↑ 18%</span></div>
              </div>
              <div class="p-3 border border-line rounded-card-sm bg-surface">
                <div class="text-[11px] text-muted font-medium tracking-[0.04em] uppercase mb-[5px]">Margen</div>
                <div class="font-serif text-[24px] leading-none text-ink flex items-baseline gap-1.5 tracking-tight">62% <span class="font-mono text-[11px] text-accent font-medium">↑ 4pp</span></div>
              </div>
              <div class="p-3 border border-line rounded-card-sm bg-surface max-sm:hidden">
                <div class="text-[11px] text-muted font-medium tracking-[0.04em] uppercase mb-[5px]">Pedidos</div>
                <div class="font-serif text-[24px] leading-none text-ink flex items-baseline gap-1.5 tracking-tight">28 <span class="font-mono text-[11px] text-accent font-medium">↑ 6</span></div>
              </div>
            </div>
            <%# Chart %>
            <div class="kc-dash-chart mb-[18px]">
              <svg viewBox="0 0 280 100" preserveAspectRatio="none" class="w-full h-full block" aria-hidden="true">
                <defs><linearGradient id="gg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--color-accent)" stop-opacity=".25"/><stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0"/></linearGradient></defs>
                <polygon fill="url(#gg)" points="0,75 40,65 80,55 120,62 160,45 200,35 240,22 280,18 280,100 0,100"/>
                <polyline fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" points="0,75 40,65 80,55 120,62 160,45 200,35 240,22 280,18"/>
                <circle cx="280" cy="18" r="4" fill="var(--color-accent)"/>
                <circle cx="280" cy="18" r="8" fill="var(--color-accent)" opacity=".2" class="kc-pulse-dot"/>
              </svg>
            </div>
            <%# Orders list %>
            <div class="flex flex-col border border-line rounded-card-sm overflow-hidden">
              <div class="grid [grid-template-columns:minmax(0,1fr)_auto_auto] gap-2.5 items-center px-3.5 py-2.5 border-b border-line text-[13px]">
                <div class="min-w-0"><div class="font-semibold text-ink truncate">Doña Carmen</div><div class="text-[11.5px] text-muted mt-px truncate">Tamales verdes · 2kg</div></div>
                <div><span class="kc-status kc-status-ok"><i class="w-[5px] h-[5px] rounded-full bg-current"></i>Listo</span></div>
                <div class="font-mono text-[12.5px] text-ink font-medium shrink-0">$650</div>
              </div>
              <div class="grid [grid-template-columns:minmax(0,1fr)_auto_auto] gap-2.5 items-center px-3.5 py-2.5 border-b border-line text-[13px]">
                <div class="min-w-0"><div class="font-semibold text-ink truncate">Lupita H.</div><div class="text-[11.5px] text-muted mt-px truncate">Pastel 3 leches</div></div>
                <div><span class="kc-status kc-status-wait"><i class="w-[5px] h-[5px] rounded-full bg-current"></i>Producción</span></div>
                <div class="font-mono text-[12.5px] text-ink font-medium shrink-0">$850</div>
              </div>
              <div class="grid [grid-template-columns:minmax(0,1fr)_auto_auto] gap-2.5 items-center px-3.5 py-2.5 text-[13px]">
                <div class="min-w-0"><div class="font-semibold text-ink truncate">Marisol V.</div><div class="text-[11.5px] text-muted mt-px truncate">15 meal preps</div></div>
                <div><span class="kc-status kc-status-new"><i class="w-[5px] h-[5px] rounded-full bg-current"></i>Nuevo</span></div>
                <div class="font-mono text-[12.5px] text-ink font-medium shrink-0">$2,100</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Integrations strip ────────────────────────────────────────────── %>
<section class="py-7 border-t border-b border-line">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="flex flex-wrap items-center justify-between gap-7">
      <div class="text-[12px] text-muted font-medium"><%= t("marketing.home.integrations") %></div>
      <div class="flex flex-wrap gap-9 items-center opacity-70">
        <% %w[SPEI WhatsApp Efectivo].each do |name| %>
          <span class="flex items-center gap-1.5 font-semibold text-ink-2 text-[16px] tracking-tight">
            <span class="w-[18px] h-[18px] bg-ink-2 rounded-[5px] opacity-25"></span>
            <%= name %>
          </span>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── Features bento ────────────────────────────────────────────────── %>
<section class="py-24" id="producto">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="max-w-[720px] mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4">
        <span class="w-5 h-px bg-accent"></span>
        <%= t("marketing.home.features.kicker") %>
      </div>
      <h2 class="font-serif text-[clamp(34px,4.2vw,52px)] leading-[1.04] tracking-tight text-ink mb-4">
        <%= t("marketing.home.features.headline_html").html_safe %>
      </h2>
      <p class="text-[17px] leading-[1.55] text-ink-2 max-w-[620px]">
        <%= t("marketing.home.features.lede") %>
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-3.5">
      <%# Pedidos card %>
      <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5 min-h-[280px] overflow-hidden">
        <div class="flex justify-between items-start gap-4">
          <div class="w-[34px] h-[34px] rounded-button bg-accent-soft text-accent flex items-center justify-center shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          </div>
          <span class="inline-flex items-center gap-1.5 text-[10.5px] font-medium px-2.5 py-1 rounded-pill border border-transparent bg-accent-soft text-accent">
            <%= t("marketing.home.features.orders.badge") %>
          </span>
        </div>
        <div class="font-mono text-[11px] tracking-[0.14em] uppercase text-muted"><%= t("marketing.home.features.orders.kicker") %></div>
        <h3 class="font-serif text-[28px] leading-[1.1] tracking-tight text-ink"><%= t("marketing.home.features.orders.headline_html").html_safe %></h3>
        <p class="text-[14.5px] leading-[1.55] text-ink-2"><%= t("marketing.home.features.orders.body") %></p>
        <div class="flex flex-col border border-line rounded-card-sm overflow-hidden mt-2">
          <% [
            { name: "Sofía C.", dish: "Pastel cumpleaños", status: "new", label: "Nuevo", amount: "$1,400" },
            { name: "Don José R.", dish: "3 kg tamales dulces", status: "wait", label: "Pendiente", amount: "$540" },
            { name: "Marisol V.", dish: "15 meal preps", status: "ok", label: "Confirmado", amount: "$2,100" },
          ].each do |row| %>
            <div class="grid [grid-template-columns:1fr_auto_auto] gap-2.5 items-center px-3 py-[9px] border-b border-line last:border-b-0 text-[12.5px]">
              <div><b class="font-semibold text-ink"><%= row[:name] %></b><br><span class="text-[11px] text-muted"><%= row[:dish] %></span></div>
              <span class="kc-status kc-status-<%= row[:status] %>"><i class="w-[5px] h-[5px] rounded-full bg-current"></i><%= row[:label] %></span>
              <span class="font-mono text-[12px] text-ink"><%= row[:amount] %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Cobros card %>
      <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5 min-h-[280px] overflow-hidden">
        <div class="w-[34px] h-[34px] rounded-button bg-accent-soft text-accent flex items-center justify-center shrink-0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8M14 7h7v7"/></svg>
        </div>
        <div class="font-mono text-[11px] tracking-[0.14em] uppercase text-muted"><%= t("marketing.home.features.payments.kicker") %></div>
        <h3 class="font-serif text-[28px] leading-[1.1] tracking-tight text-ink"><%= t("marketing.home.features.payments.headline_html").html_safe %></h3>
        <p class="text-[14.5px] leading-[1.55] text-ink-2"><%= t("marketing.home.features.payments.body") %></p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 mt-2">
          <% [
            { name: "SPEI", sub: "Inmediato" },
            { name: "Tarjeta", sub: "Por link" },
            { name: "Efectivo", sub: "Manual" },
          ].each do |rail| %>
            <div class="border border-line rounded-card-sm p-3 flex flex-col gap-1 bg-bg-2">
              <b class="text-[13px] text-ink"><%= rail[:name] %></b>
              <span class="text-[11px] text-muted font-mono tracking-[0.04em]"><%= rail[:sub] %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Producción card %>
      <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5 min-h-[280px] overflow-hidden">
        <div class="w-[34px] h-[34px] rounded-button bg-accent-soft text-accent flex items-center justify-center shrink-0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3v4M16 3v4M3 9h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/></svg>
        </div>
        <div class="font-mono text-[11px] tracking-[0.14em] uppercase text-muted"><%= t("marketing.home.features.production.kicker") %></div>
        <h3 class="font-serif text-[28px] leading-[1.1] tracking-tight text-ink"><%= t("marketing.home.features.production.headline_html").html_safe %></h3>
        <p class="text-[14.5px] leading-[1.55] text-ink-2"><%= t("marketing.home.features.production.body") %></p>
        <div class="grid grid-cols-7 gap-1 mt-2">
          <% [
            { day: "L", n: "2", active: false },
            { day: "M", n: "4", active: true },
            { day: "M", n: "3", active: true },
            { day: "J", n: "5", active: true },
            { day: "V", n: "7", active: true },
            { day: "S", n: "9", active: true },
            { day: "D", n: "1", active: false },
          ].each do |d| %>
            <div class="kc-cal-day<%= " kc-cal-day--active" if d[:active] %>">
              <%= d[:day] %><span class="text-[9px] font-semibold"><%= d[:n] %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Márgenes card %>
      <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5 min-h-[280px] overflow-hidden">
        <div class="w-[34px] h-[34px] rounded-button bg-accent-soft text-accent flex items-center justify-center shrink-0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M23 6l-9.5 9.5-5-5L1 18M17 6h6v6"/></svg>
        </div>
        <div class="font-mono text-[11px] tracking-[0.14em] uppercase text-muted"><%= t("marketing.home.features.margins.kicker") %></div>
        <h3 class="font-serif text-[28px] leading-[1.1] tracking-tight text-ink"><%= t("marketing.home.features.margins.headline_html").html_safe %></h3>
        <p class="text-[14.5px] leading-[1.55] text-ink-2"><%= t("marketing.home.features.margins.body") %></p>
        <div class="flex flex-col gap-[9px] mt-1.5" data-controller="data-width">
          <% [
            { name: "Tamales verdes", pct: 66, warn: false },
            { name: "Pastel 3 leches", pct: 58, warn: false },
            { name: "Meal prep pollo", pct: 42, warn: true },
          ].each do |m| %>
            <div class="grid [grid-template-columns:1fr_auto] gap-2.5 items-center text-[13px] text-ink-2">
              <span><%= m[:name] %></span>
              <b class="font-mono text-[12px] font-medium text-accent"><%= m[:pct] %>%</b>
              <div class="kc-mgr-bar [grid-column:1/3]">
                <span class="<%= m[:warn] ? "!bg-warn" : "" %>" data-width="<%= m[:pct] %>%"></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Showcase: dashboard deep-dive ──────────────────────────────── %>
    <div class="bg-surface border border-line rounded-panel p-9 mt-5" id="como">
      <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-9 items-stretch">
        <div>
          <div class="font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-3">
            <%= t("marketing.home.showcase.kicker") %>
          </div>
          <h4 class="font-serif text-[28px] leading-[1.08] tracking-tight text-ink mb-3.5">
            <%= t("marketing.home.showcase.headline_html").html_safe %>
          </h4>
          <p class="text-[14.5px] leading-[1.55] text-ink-2 mb-5">
            <%= t("marketing.home.showcase.body") %>
          </p>
          <ul class="flex flex-col gap-[9px]">
            <% t("marketing.home.showcase.checks").each do |check| %>
              <li class="flex items-start gap-[9px] text-[13.5px] text-ink-2 leading-[1.4]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <%= check %>
              </li>
            <% end %>
          </ul>
        </div>

        <%# Mini dashboard mock %>
        <div class="bg-bg-2 border border-line rounded-card p-5 flex flex-col gap-3.5 min-h-[440px]">
          <div class="flex justify-between items-center pb-3.5 border-b border-line">
            <div class="font-serif text-[20px] tracking-tight">Panel de Elena</div>
            <div class="flex gap-1">
              <span class="text-[11px] font-sans px-2.5 py-[5px] rounded-[6px] bg-surface text-ink border border-line">Hoy</span>
              <span class="text-[11px] font-sans px-2.5 py-[5px] rounded-[6px] text-muted">7D</span>
              <span class="text-[11px] font-sans px-2.5 py-[5px] rounded-[6px] text-muted">30D</span>
            </div>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-2">
            <% [
              { label: "Ventas", val: "$3,600", delta: "↑ 18%" },
              { label: "Pedidos", val: "12", delta: "↑ 3" },
              { label: "Margen", val: "62%", delta: "↑ 4pp" },
              { label: "Por cobrar", val: "$1,850", delta: "2 atr.", warn: true },
            ].each do |s| %>
              <div class="p-[10px_12px] bg-surface border border-line rounded-button">
                <div class="text-[10.5px] text-muted font-medium tracking-[0.04em] uppercase"><%= s[:label] %></div>
                <div class="font-serif text-[22px] tracking-tight mt-[3px]"><%= s[:val] %></div>
                <div class="font-mono text-[10.5px] font-medium mt-0.5 <%= s[:warn] ? "text-warn" : "text-accent" %>"><%= s[:delta] %></div>
              </div>
            <% end %>
          </div>
          <%# Bar chart %>
          <div class="flex-1 bg-surface border border-line rounded-card-sm p-3.5 flex items-end gap-1.5 min-h-[140px]" data-controller="data-width">
            <% [
              { label: "L", h: 32 },
              { label: "M", h: 48 },
              { label: "M", h: 66 },
              { label: "J", h: 42 },
              { label: "V", h: 74 },
              { label: "S", h: 95, active: true },
              { label: "D", h: 24 },
            ].each do |bar| %>
              <div class="kc-sm-bar<%= " kc-sm-bar--active" if bar[:active] %>" data-label="<%= bar[:label] %>" data-height="<%= bar[:h] %>%"></div>
            <% end %>
          </div>
          <%# Mini table %>
          <div class="bg-surface border border-line rounded-card-sm overflow-hidden">
            <div class="grid [grid-template-columns:1fr_auto_auto_auto] gap-3.5 px-3.5 py-[9px] bg-bg-2 text-[10.5px] text-muted uppercase tracking-[0.06em] font-medium border-b border-line">
              <b>Cliente</b><span>Platillo</span><span>Estado</span><span>Total</span>
            </div>
            <div class="grid [grid-template-columns:1fr_auto_auto_auto] gap-3.5 px-3.5 py-[9px] text-[12.5px] items-center border-b border-line">
              <b class="font-semibold">Doña Carmen R.</b><code class="font-mono text-[12px] text-ink-2">Tamales verdes</code><span class="kc-status kc-status-ok"><i class="w-[5px] h-[5px] rounded-full bg-current"></i>Listo</span><code class="font-mono text-[12px]">$650</code>
            </div>
            <div class="grid [grid-template-columns:1fr_auto_auto_auto] gap-3.5 px-3.5 py-[9px] text-[12.5px] items-center">
              <b class="font-semibold">Lupita H.</b><code class="font-mono text-[12px] text-ink-2">Pastel 3 leches</code><span class="kc-status kc-status-wait"><i class="w-[5px] h-[5px] rounded-full bg-current"></i>Producción</span><code class="font-mono text-[12px]">$850</code>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Pricing ───────────────────────────────────────────────────────── %>
<section class="py-24 pt-0" id="precios">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="max-w-[720px] mx-auto text-center mb-14">
      <div class="inline-flex items-center gap-2 font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4 justify-center">
        <span class="w-5 h-px bg-accent"></span>
        <%= t("marketing.home.pricing.kicker") %>
      </div>
      <h2 class="font-serif text-[clamp(34px,4.2vw,52px)] leading-[1.04] tracking-tight text-ink mb-4">
        <%= t("marketing.home.pricing.headline_html").html_safe %>
      </h2>
      <p class="text-[17px] leading-[1.55] text-ink-2 mx-auto text-center">
        <%= t("marketing.home.pricing.lede") %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 max-w-[720px] mx-auto">
      <%# Free tier %>
      <div class="bg-surface border border-line rounded-[16px] p-7 flex flex-col gap-3.5">
        <div class="flex justify-between items-center">
          <div class="font-serif text-[24px] tracking-tight"><%= t("marketing.home.pricing.free.name") %></div>
        </div>
        <p class="text-[13.5px] text-muted leading-[1.5]"><%= t("marketing.home.pricing.free.desc") %></p>
        <div class="flex items-baseline gap-1.5 py-2.5 border-t border-b border-line">
          <div class="font-serif text-[54px] tracking-tight leading-none"><%= t("marketing.home.pricing.free.price") %></div>
          <div class="text-[12px] text-muted font-mono"><%= t("marketing.home.pricing.free.per") %></div>
        </div>
        <ul class="flex flex-col gap-2.5 my-1">
          <% t("marketing.home.pricing.free.features").each do |feat| %>
            <li class="flex items-start gap-[9px] text-[13.5px] text-ink-2 leading-[1.4]">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <%= feat %>
            </li>
          <% end %>
        </ul>
        <%= link_to t("marketing.home.pricing.free.cta"), new_registration_path,
              class: "inline-flex items-center justify-center w-full gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-surface text-ink border border-line hover:border-line-2 transition-colors mt-auto" %>
      </div>

      <%# Pro tier %>
      <div class="kc-price-pop border rounded-[16px] p-7 flex flex-col gap-3.5 relative">
        <div class="flex justify-between items-center">
          <div class="font-serif text-[24px] tracking-tight"><%= t("marketing.home.pricing.pro.name") %></div>
          <span class="font-mono text-[10px] tracking-[0.12em] uppercase px-[9px] py-1 rounded-pill bg-accent text-bg"><%= t("marketing.home.pricing.pro.tag") %></span>
        </div>
        <p class="text-[13.5px] opacity-75 leading-[1.5]"><%= t("marketing.home.pricing.pro.desc") %></p>
        <div class="flex items-baseline gap-1.5 py-2.5 border-t border-b border-white/15 dark:border-accent/25">
          <div class="font-serif text-[54px] tracking-tight leading-none"><%= t("marketing.home.pricing.pro.price") %></div>
          <div class="text-[12px] opacity-75 font-mono"><%= t("marketing.home.pricing.pro.per") %></div>
        </div>
        <ul class="flex flex-col gap-2.5 my-1">
          <% t("marketing.home.pricing.pro.features").each do |feat| %>
            <li class="flex items-start gap-[9px] text-[13.5px] opacity-85 leading-[1.4]">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-accent-2 shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <%= feat %>
            </li>
          <% end %>
        </ul>
        <%= link_to t("marketing.home.pricing.pro.cta"), new_registration_path,
              class: "inline-flex items-center justify-center w-full gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-bg text-ink border border-bg hover:bg-accent-2 hover:text-bg hover:border-accent-2 transition-colors mt-auto" %>
      </div>
    </div>
  </div>
</section>

<%# ── FAQ ───────────────────────────────────────────────────────────── %>
<section class="py-24 pt-0">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-14 items-start">
      <div>
        <h2 class="font-serif text-[44px] leading-[1.05] tracking-tight text-ink mb-3.5">
          <%= t("marketing.home.faq.headline_html").html_safe %>
        </h2>
        <p class="text-[15px] leading-[1.55] text-ink-2">
          <%= t("marketing.home.faq.lede") %>
        </p>
      </div>
      <div class="flex flex-col border border-line rounded-card overflow-hidden bg-surface">
        <% t("marketing.home.faq.items").each_with_index do |item, idx| %>
          <details class="border-b border-line last:border-b-0 group" <%= "open" if idx == 0 %>>
            <summary class="flex items-center justify-between gap-4 px-6 py-5 text-[16px] font-medium text-ink leading-[1.4] select-none">
              <%= item[:q] %>
              <span class="w-[22px] h-[22px] rounded-full bg-bg-2 text-ink-2 flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-45 group-open:bg-accent group-open:text-bg">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-5 text-[15px] leading-[1.6] text-ink-2 max-w-[680px]">
              <%= item[:a] %>
            </div>
          </details>
        <% end %>
      </div>
    </div>
  </div>
</section>

<%# ── Final CTA ─────────────────────────────────────────────────────── %>
<section class="py-24 pt-0">
  <div class="mx-auto max-w-[1240px] px-7">
    <div class="kc-cta-block rounded-panel-lg p-[48px_32px] lg:p-[72px_56px] grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-12 items-center overflow-hidden relative">
      <div>
        <h2 class="font-serif text-[clamp(36px,5vw,60px)] leading-[1.02] tracking-tight mb-5">
          <%= t("marketing.home.final_cta.headline_html").html_safe %>
        </h2>
        <p class="text-[16px] leading-[1.55] opacity-75 max-w-[440px] mb-7">
          <%= t("marketing.home.final_cta.body") %>
        </p>
        <div class="flex flex-wrap gap-2.5">
          <%= link_to t("marketing.home.final_cta.primary"), new_registration_path,
                class: "inline-flex items-center gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-bg text-ink border border-bg hover:bg-accent-2 hover:text-bg hover:border-accent-2 transition-colors" %>
          <%= link_to t("marketing.home.final_cta.secondary"), "#precios",
                class: "inline-flex items-center gap-2 text-[14px] font-semibold px-[18px] py-2.5 rounded-button bg-transparent border border-white/25 dark:border-accent/30 hover:border-white/60 dark:hover:border-accent/60 hover:bg-white/[0.08] transition-colors" %>
        </div>
      </div>
      <%# 3-step onboarding %>
      <div class="flex flex-col gap-5">
        <% [
          { step: "1", icon: "user-plus", title: "Crea tu cuenta", desc: "Nombre, cocina y listo. Sin tarjeta." },
          { step: "2", icon: "book-open", title: "Sube tu menú", desc: "Fotos, precios y descripción de tus platillos." },
          { step: "3", icon: "shopping-bag", title: "Recibe pedidos", desc: "Tus clientes piden desde tu menú y tú los confirmas." },
        ].each do |s| %>
          <div class="flex items-start gap-4 bg-white/[0.07] dark:bg-accent/[0.08] border border-white/15 dark:border-accent/20 rounded-[12px] px-5 py-4">
            <div class="w-9 h-9 rounded-full bg-white/15 dark:bg-accent/15 flex items-center justify-center shrink-0 font-serif text-[18px]">
              <%= s[:step] %>
            </div>
            <div>
              <div class="font-semibold text-[15px] mb-0.5"><%= s[:title] %></div>
              <div class="text-[13.5px] opacity-70 leading-[1.4]"><%= s[:desc] %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
