<% content_for :title, t("meta.pages.how_it_works.title") %>
<% content_for :description, t("meta.pages.how_it_works.description") %>

<%# Phase 14, Slice 9 — three-step explainer replacing the
    placeholder copy. Mirrors the bone palette + Instrument Serif
    treatment of the rest of the marketing site. %>
<section class="pt-[88px] pb-12">
  <div class="mx-auto max-w-[1240px] px-7 text-center">
    <div class="inline-flex items-center gap-2 font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4 justify-center">
      <span class="w-5 h-px bg-accent"></span>
      <%= t("marketing.how_it_works.kicker") %>
    </div>
    <h1 class="font-serif text-[clamp(40px,5vw,68px)] leading-[1.02] tracking-tight text-ink mb-5 mx-auto max-w-[820px]">
      <%= t("marketing.how_it_works.headline_html").html_safe %>
    </h1>
    <p class="text-[17px] leading-[1.55] text-ink-2 mx-auto max-w-[620px]">
      <%= t("marketing.how_it_works.lede") %>
    </p>
  </div>
</section>

<section class="pb-20">
  <div class="mx-auto max-w-[920px] px-7">
    <ol class="flex flex-col gap-5">
      <% t("marketing.how_it_works.steps").each_with_index do |step, idx| %>
        <li class="rounded-panel border border-line bg-surface p-6 sm:p-7 flex flex-col sm:flex-row gap-5 sm:items-start">
          <div class="shrink-0">
            <span class="inline-flex h-[56px] w-[56px] items-center justify-center rounded-full bg-accent text-bg font-serif text-[24px] leading-none">
              <%= idx + 1 %>
            </span>
          </div>
          <div class="flex flex-col gap-2 min-w-0">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-muted">
              <%= step[:kicker] %>
            </span>
            <h2 class="font-serif text-[24px] sm:text-[28px] leading-[1.15] tracking-[-0.01em] text-ink">
              <%= step[:title] %>
            </h2>
            <p class="text-[14.5px] leading-[1.55] text-ink-2 max-w-prose">
              <%= step[:body] %>
            </p>
            <% if step[:tip] %>
              <p class="text-[12.5px] leading-[1.5] text-muted italic mt-1">
                <%= step[:tip] %>
              </p>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<section class="pb-24">
  <div class="mx-auto max-w-[1100px] px-7 text-center flex flex-col gap-4">
    <h2 class="font-serif text-[clamp(28px,3.6vw,42px)] leading-[1.1] tracking-tight text-ink">
      <%= t("marketing.how_it_works.cta.headline") %>
    </h2>
    <p class="text-[15px] text-ink-2 max-w-[520px] mx-auto">
      <%= t("marketing.how_it_works.cta.body") %>
    </p>
    <div class="inline-flex flex-wrap items-center justify-center gap-3 mt-2">
      <%= link_to t("marketing.how_it_works.cta.primary"), new_registration_path,
            class: "inline-flex items-center gap-2 text-[14px] font-semibold px-5 py-2.5 rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta no-underline" %>
      <%= link_to t("marketing.how_it_works.cta.secondary"), product_path,
            class: "inline-flex items-center gap-2 text-[14px] font-medium px-5 py-2.5 rounded-button bg-surface text-ink-2 border border-line hover:border-line-2 transition-colors no-underline" %>
    </div>
  </div>
</section>
