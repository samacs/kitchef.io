<% content_for :title, t("meta.pages.product.title") %>
<% content_for :description, t("meta.pages.product.description") %>

<% content_for :json_ld do %>
  <%= json_ld_software_application %>
<% end %>

<%# Phase 14, Slice 9 — real feature page replacing the old
    Producto-points-at-how-it-works placeholder. Six surfaces the
    operator actually uses every day, plus the KDS teaser to set
    expectations for Phase 15. Each tile mirrors the design tokens
    + DESIGN.md card pattern. %>
<section class="pt-[88px] pb-12">
  <div class="mx-auto max-w-[1240px] px-7 text-center">
    <div class="inline-flex items-center gap-2 font-mono text-[11.5px] tracking-[0.18em] uppercase text-accent mb-4 justify-center">
      <span class="w-5 h-px bg-accent"></span>
      <%= t("marketing.product.kicker") %>
    </div>
    <h1 class="font-serif text-[clamp(40px,5vw,68px)] leading-[1.02] tracking-tight text-ink mb-5 mx-auto max-w-[820px]">
      <%= t("marketing.product.headline_html").html_safe %>
    </h1>
    <p class="text-[17px] leading-[1.55] text-ink-2 mx-auto max-w-[620px]">
      <%= t("marketing.product.lede") %>
    </p>
  </div>
</section>

<section class="pb-20">
  <div class="mx-auto max-w-[1100px] px-7">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% t("marketing.product.features").each do |feature| %>
        <article class="rounded-card border border-line bg-surface p-6 flex flex-col gap-3 relative">
          <% if feature[:badge] %>
            <span class="absolute top-4 right-4 inline-flex items-center gap-1 rounded-pill bg-accent-soft text-accent border border-accent/20 px-2 py-px font-mono text-[10px] uppercase tracking-[0.08em]">
              <%= feature[:badge] %>
            </span>
          <% end %>
          <div class="flex items-center gap-3">
            <span class="inline-flex h-[40px] w-[40px] items-center justify-center rounded-card-sm bg-accent-soft text-accent">
              <%= icon(feature[:icon].to_sym, size: :md) %>
            </span>
            <h2 class="font-serif text-[19px] text-ink leading-[1.2]">
              <%= feature[:title] %>
            </h2>
          </div>
          <p class="text-[13.5px] leading-[1.55] text-ink-2">
            <%= feature[:body] %>
          </p>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# Closing hook: explicit non-goals so prospective operators know
    what we DON'T do (per PRD: not a marketplace, not delivery,
    not payment processor). Keeps expectations honest. %>
<section class="pb-24">
  <div class="mx-auto max-w-[820px] px-7">
    <div class="rounded-panel border border-line bg-bg-2 p-7 sm:p-9 flex flex-col gap-4">
      <h2 class="font-serif text-[24px] leading-[1.15] tracking-tight text-ink">
        <%= t("marketing.product.not_goals.headline") %>
      </h2>
      <p class="text-[14.5px] leading-[1.6] text-ink-2">
        <%= t("marketing.product.not_goals.body") %>
      </p>
    </div>
  </div>
</section>

<section class="pb-24">
  <div class="mx-auto max-w-[1100px] px-7 text-center flex flex-col gap-4">
    <h2 class="font-serif text-[clamp(28px,3.6vw,42px)] leading-[1.1] tracking-tight text-ink">
      <%= t("marketing.product.cta.headline") %>
    </h2>
    <p class="text-[15px] text-ink-2 max-w-[540px] mx-auto">
      <%= t("marketing.product.cta.body") %>
    </p>
    <div class="inline-flex flex-wrap items-center justify-center gap-3 mt-2">
      <%= link_to t("marketing.product.cta.primary"), new_registration_path,
            class: "inline-flex items-center gap-2 text-[14px] font-semibold px-5 py-2.5 rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta no-underline" %>
      <%= link_to t("marketing.product.cta.secondary"), pricing_path,
            class: "inline-flex items-center gap-2 text-[14px] font-medium px-5 py-2.5 rounded-button bg-surface text-ink-2 border border-line hover:border-line-2 transition-colors no-underline" %>
    </div>
  </div>
</section>
