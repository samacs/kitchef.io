<% content_for :title, t("storefronts.confirmation.title_short") %>

<%# Per-order Turbo stream — morphs this page when the operator advances
    state. Scoped to [order, :status] so the customer never subscribes to
    unrelated pedidos from the same kitchen. %>
<%= turbo_stream_from @order, :status %>

<%# Fire-and-forget: wipes the session cart so the header badge +
    drawer don't keep showing the just-placed items. Self-closing div
    is fine — the controller's only job is to dispatch on connect. %>
<div data-controller="storefront-cart-clear" hidden></div>

<main class="mx-auto max-w-[760px] px-5 py-10">
  <% lede_key =
    if @order.state == "placed"
      "storefronts.confirmation.lede"
    else
      "storefronts.confirmation.lede_#{@order.state}"
    end
  %>
  <div class="mb-6">
    <div class="font-mono text-[11px] uppercase tracking-[0.18em]" style="color: var(--brand-1);">
      <%= t("storefronts.confirmation.kicker") %>
    </div>
    <h1 class="mt-2 font-serif text-[40px] leading-[1.05] tracking-tight text-ink">
      <%= t("storefronts.confirmation.heading", first_name: @order.client&.first_name.presence || "") %>
    </h1>
    <p class="mt-3 text-[15px] leading-[1.55] text-ink-2 max-w-[620px]">
      <%= t(lede_key, kitchen: @storefront.name, default: t("storefronts.confirmation.lede", kitchen: @storefront.name)) %>
    </p>
  </div>

  <% if @order.state == "placed" && !@email_verified %>
    <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
        <%= t("storefronts.confirmation.inbox.kicker") %>
      </div>
      <h2 class="mt-2 font-serif text-[22px] leading-[1.2] text-ink">
        <%= t("storefronts.confirmation.inbox.headline") %>
      </h2>
      <p class="mt-2 text-[14px] leading-[1.5] text-ink-2 max-w-[560px]">
        <%= t("storefronts.confirmation.inbox.lede", email: @order.client&.email) %>
      </p>
      <p class="mt-3 text-[12.5px] leading-[1.5] text-muted max-w-[560px]">
        <%= t("storefronts.confirmation.inbox.nudge") %>
      </p>
    </section>
  <% end %>

  <% if @email_verified %>
    <section class="mb-6 rounded-[16px] border-2 p-6"
             style="border-color: var(--brand-1); background: var(--brand-1-soft);">
      <div class="font-mono text-[11px] uppercase tracking-[0.14em]" style="color: var(--brand-1);">
        <%= t("storefronts.confirmation.review.kicker") %>
      </div>
      <h2 class="mt-2 font-serif text-[26px] leading-[1.15] text-ink">
        <%= t("storefronts.confirmation.review.headline") %>
      </h2>
      <p class="mt-2 text-[14px] leading-[1.5] text-ink-2 max-w-[560px]">
        <%= t("storefronts.confirmation.review.lede") %>
      </p>

      <%= form_with url: confirm_storefront_order_path(slug: @storefront.slug, id: @order.prefix_id),
                    method: :post,
                    local: true,
                    html: { class: "mt-5 flex flex-col gap-4" } do %>
        <%# Round-trip the token so POST /confirm can re-verify on the server. %>
        <input type="hidden" name="t" value="<%= params[:t] %>">

        <% if @order.delivery_type_delivery? %>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block">
              <span class="block text-[12px] font-medium text-muted mb-1"><%= t("storefronts.checkout.colonia") %></span>
              <input type="text" name="review[colonia]" value="<%= @order.colonia %>"
                     class="kc-sf-input w-full rounded-[7px] border border-line bg-surface px-3 py-2 text-[14px] text-ink">
            </label>
            <label class="block">
              <span class="block text-[12px] font-medium text-muted mb-1"><%= t("storefronts.checkout.city") %></span>
              <input type="text" name="review[city]" value="<%= @order.city %>"
                     class="kc-sf-input w-full rounded-[7px] border border-line bg-surface px-3 py-2 text-[14px] text-ink">
            </label>
          </div>
          <label class="block">
            <span class="block text-[12px] font-medium text-muted mb-1"><%= t("storefronts.checkout.address") %></span>
            <input type="text" name="review[delivery_address]" value="<%= @order.delivery_address %>" required
                   class="kc-sf-input w-full rounded-[7px] border border-line bg-surface px-3 py-2 text-[14px] text-ink">
          </label>
        <% end %>

        <label class="block">
          <span class="block text-[12px] font-medium text-muted mb-1"><%= t("storefronts.confirmation.review.notes_label") %></span>
          <textarea name="review[delivery_notes]" rows="2"
                    placeholder="<%= t("storefronts.confirmation.review.notes_placeholder") %>"
                    class="kc-sf-input w-full rounded-[7px] border border-line bg-surface px-3 py-2 text-[14px] text-ink"><%= @order.delivery_notes %></textarea>
        </label>

        <button type="submit"
                class="mt-1 inline-flex items-center justify-center gap-2 rounded-[10px] px-6 py-3 text-[15px] font-semibold"
                style="background: var(--brand-1); color: var(--brand-1-ink); border: 1px solid var(--brand-1); box-shadow: 0 2px 10px rgba(10, 90, 60, 0.18);">
          <%= t("storefronts.confirmation.review.confirm_cta") %>
        </button>
      <% end %>
    </section>
  <% end %>

  <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
    <h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      <%= t("storefronts.confirmation.status_section") %>
    </h2>
    <%= render Storefronts::StatusTimelineComponent.new(steps: @status_timeline) %>
  </section>

  <section class="mb-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-[14px] border border-line bg-surface p-5">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted"><%= t("storefronts.confirmation.when_label") %></div>
      <% if @order.dispatch_asap? %>
        <div class="mt-1 font-serif text-[20px] text-ink">
          <%= t("storefronts.confirmation.asap_label") %>
        </div>
        <div class="font-mono text-[12.5px] text-muted mt-1">
          <%= t("storefronts.confirmation.asap_sub") %>
        </div>
      <% else %>
        <div class="mt-1 font-serif text-[20px] text-ink">
          <%= l(@order.delivery_date, format: :long) rescue @order.delivery_date %>
        </div>
        <% if @order.delivery_start_time && @order.delivery_end_time %>
          <div class="font-mono text-[13px] text-ink-2">
            <%= @order.delivery_start_time_hhmm %>–<%= @order.delivery_end_time_hhmm %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="rounded-[14px] border border-line bg-surface p-5">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted"><%= t("storefronts.confirmation.where_label") %></div>
      <div class="mt-1 font-serif text-[20px] text-ink">
        <%= t("storefronts.fulfillment_types.#{@order.delivery_type}.label") %>
      </div>
      <% if @order.delivery_address.present? %>
        <div class="text-[13px] text-ink-2 mt-1">
          <%= [ @order.delivery_address, @order.colonia, @order.city ].compact_blank.join(", ") %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
    <h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      <%= t("storefronts.confirmation.items_section") %>
    </h2>
    <div class="divide-y divide-line">
      <% @order.items.each do |item| %>
        <div class="flex items-start justify-between gap-4 py-3">
          <div>
            <div class="text-[14px] font-semibold text-ink"><%= item.recipe&.name || "Platillo" %></div>
            <div class="font-mono text-[11.5px] text-muted">× <%= item.quantity %></div>
            <% if item.has_customizations? %>
              <div class="mt-1 flex flex-wrap gap-1">
                <% item.display_options.each do |line| %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-mono"
                        style="background: color-mix(in oklab, var(--brand-1) 8%, var(--color-surface)); color: var(--brand-1);">
                    <%= line %>
                  </span>
                <% end %>
              </div>
            <% end %>
            <% if item.notes.present? %>
              <div class="mt-1 text-[12px] text-ink-2 italic"><%= item.notes %></div>
            <% end %>
          </div>
          <div class="font-mono text-[13px] text-ink">
            <%= humanized_money_with_symbol(Money.new(item.unit_price_cents.to_i * item.quantity.to_d, "MXN")) %>
          </div>
        </div>
      <% end %>
    </div>

    <% if @order.tip_cents.to_i.positive? || @order.packaging_cents.to_i.positive? || @order.discount_cents.to_i.positive? %>
      <div class="mt-4 flex flex-col gap-1 border-t border-line pt-3 text-[13px]">
        <div class="flex justify-between">
          <span class="text-ink-2"><%= t("storefronts.confirmation.subtotal_label") %></span>
          <span class="font-mono text-ink"><%= humanized_money_with_symbol(@order.subtotal) %></span>
        </div>
        <% if @order.packaging_cents.to_i.positive? %>
          <div class="flex justify-between">
            <span class="text-ink-2"><%= t("storefronts.confirmation.packaging_label") %></span>
            <span class="font-mono text-ink"><%= humanized_money_with_symbol(@order.packaging) %></span>
          </div>
        <% end %>
        <% if @order.discount_cents.to_i.positive? %>
          <div class="flex justify-between" style="color: var(--brand-1);">
            <span class="flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              <%= @order.discount_label.presence || t("storefronts.confirmation.discount_label") %>
            </span>
            <span class="font-mono font-medium">−<%= humanized_money_with_symbol(@order.discount) %></span>
          </div>
        <% end %>
        <% if @order.tip_cents.to_i.positive? %>
          <div class="flex justify-between">
            <span class="text-ink-2"><%= t("storefronts.confirmation.tip_label") %></span>
            <span class="font-mono text-ink"><%= humanized_money_with_symbol(@order.tip) %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 flex items-baseline justify-between gap-4 border-t border-line pt-4 flex-wrap">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[14px] font-semibold text-ink"><%= t("storefronts.cart.total") %></span>
        <% if @order.paid? %>
          <span class="inline-flex items-center gap-1 rounded-pill px-2.5 py-1 font-mono text-[10.5px] font-semibold uppercase tracking-[0.12em]"
                style="background: color-mix(in oklab, #0A5A3C 14%, var(--color-surface)); color: #0A5A3C; border: 1px solid color-mix(in oklab, #0A5A3C 35%, transparent);"
                aria-label="<%= t("storefronts.confirmation.payment_status.paid_aria") %>">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <%= t("storefronts.confirmation.payment_status.paid") %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 rounded-pill px-2.5 py-1 font-mono text-[10.5px] font-semibold uppercase tracking-[0.12em]"
                style="background: color-mix(in oklab, #B04E0E 14%, var(--color-surface)); color: #B04E0E; border: 1px solid color-mix(in oklab, #B04E0E 35%, transparent);"
                aria-label="<%= t("storefronts.confirmation.payment_status.pending_aria") %>">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 8v4M12 16h.01"/>
            </svg>
            <%= t("storefronts.confirmation.payment_status.pending") %>
          </span>
        <% end %>
      </div>
      <span class="font-serif text-[24px] tracking-tight text-ink"><%= humanized_money_with_symbol(@order.total) %></span>
    </div>
  </section>

  <%# Pickup address — only for pickup orders. The customer needs to
      know where to drive. Always shown regardless of the public opt-in
      because the order already binds the customer to this kitchen. %>
  <% if @order.delivery_type_pickup? %>
    <div class="mb-6">
      <%= render Storefronts::PickupAddressComponent.new(account: @storefront) %>
    </div>
  <% end %>

  <% if @order.payment_method.present? %>
    <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
      <div class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted mb-2">
        <%= t("storefronts.confirmation.payment_method_label") %>
      </div>
      <div class="text-[14px] text-ink font-medium">
        <%= t("storefronts.checkout.payment.#{@order.payment_method}_label") %>
      </div>
      <% if @order.payment_cash? && @order.cash_payment_amount_cents.to_i.positive? %>
        <p class="mt-1 text-[13px] text-ink-2">
          <%= t("storefronts.confirmation.cash_pays_with", amount: humanized_money_with_symbol(@order.cash_payment_amount)) %>
        </p>
      <% end %>
      <% if @order.payment_transfer? %>
        <% ps = @storefront.payment_settings %>
        <% if ps.transfer_clabe.present? %>
          <div class="mt-3 rounded-[10px] border border-line bg-bg/60 p-4 flex flex-col gap-2">
            <% if ps.transfer_holder.present? %>
              <div>
                <div class="text-[11px] font-mono uppercase tracking-[0.14em] text-muted"><%= t("storefronts.checkout.payment.transfer_holder") %></div>
                <div class="text-[14px] text-ink"><%= ps.transfer_holder %></div>
              </div>
            <% end %>
            <% if ps.transfer_bank.present? %>
              <div>
                <div class="text-[11px] font-mono uppercase tracking-[0.14em] text-muted"><%= t("storefronts.checkout.payment.transfer_bank") %></div>
                <div class="text-[14px] text-ink"><%= ps.transfer_bank %></div>
              </div>
            <% end %>
            <div class="flex items-center justify-between gap-2">
              <div>
                <div class="text-[11px] font-mono uppercase tracking-[0.14em] text-muted"><%= t("storefronts.checkout.payment.transfer_clabe") %></div>
                <div class="text-[14px] text-ink font-mono tabular-nums"><%= ps.transfer_clabe %></div>
              </div>
              <button type="button"
                      data-controller="copy-to-clipboard"
                      data-copy-to-clipboard-value-value="<%= ps.transfer_clabe %>"
                      data-copy-to-clipboard-success-label-value="<%= t("storefronts.checkout.payment.copied") %>"
                      data-action="click->copy-to-clipboard#copy"
                      data-copy-to-clipboard-target="button"
                      class="inline-flex items-center gap-1 rounded-[7px] border border-line bg-surface px-2.5 py-1 text-[12px] font-medium text-ink-2 hover:border-line-2">
                <span><%= t("storefronts.checkout.payment.copy_cta") %></span>
              </button>
            </div>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if @storefront.public_profile.payment_notes.present? %>
    <section class="mb-6 rounded-[14px] px-5 py-4"
             style="background: var(--brand-1-soft); color: var(--brand-1);">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em]"><%= t("storefronts.confirmation.payment_note_label") %></div>
      <p class="mt-1 text-[14px] leading-[1.5]"><%= @storefront.public_profile.payment_notes %></p>
    </section>
  <% end %>

  <% whatsapp = @storefront.public_profile.whatsapp.presence || @storefront.public_profile.phone %>
  <% if whatsapp.present? && (normalized = Phone::NormalizeMx.call(raw: whatsapp)) %>
    <%# The pre-filled message bundles a deep-link the operator opens back
        in her panel — `/orders#order_<id>` lands on the kanban and
        target_highlight flashes the matching card so she doesn't have
        to hunt for the pedido when a customer writes in. URL is fully
        qualified so it works when the customer taps from WhatsApp's
        in-app browser. %>
    <% kanban_deep_link = orders_url(anchor: dom_id(@order)) %>
    <% whatsapp_body = t("storefronts.confirmation.whatsapp_message",
                         kitchen: @storefront.name,
                         id:      @order.prefix_id,
                         link:    kanban_deep_link) %>
    <section class="mt-8 flex flex-col items-stretch gap-2 sm:items-center">
      <a href="https://wa.me/<%= normalized.sub(/\A\+/, "") %>?text=<%= ERB::Util.url_encode(whatsapp_body) %>"
         target="_blank" rel="noopener"
         class="inline-flex w-full items-center justify-center gap-2 rounded-[12px] px-6 py-4 text-[15px] font-semibold no-underline sm:w-auto"
         style="background: #25D366; color: #053019; border: 1px solid #25D366; box-shadow: 0 2px 10px rgba(37, 211, 102, 0.25);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <%= t("storefronts.confirmation.whatsapp_cta", kitchen: @storefront.name) %>
      </a>
      <p class="text-center text-[12px] text-muted">
        <%= t("storefronts.confirmation.whatsapp_hint") %>
      </p>
    </section>
  <% end %>
</main>
