<% content_for :title, t("storefronts.confirmation.title_short") %>

<%# Per-order Turbo stream — morphs this page when the operator advances
    state. Scoped to [order, :status] so the customer never subscribes to
    unrelated pedidos from the same kitchen. %>
<%= turbo_stream_from @order, :status %>

<%# Fire-and-forget: wipes the session cart so the header badge +
    drawer don't keep showing the just-placed items. Self-closing div
    is fine — the controller's only job is to dispatch on connect. %>
<div data-controller="storefront-cart-clear" hidden></div>

<main class="mx-auto max-w-[760px] px-5 py-10">
  <% if flash[:notice] %>
    <div class="mb-6">
      <%= render Ui::FlashComponent.new(kind: :notice, message: flash[:notice]) %>
    </div>
  <% end %>

  <% client = @order.client %>
  <% lede_key =
    case @order.state
    when "placed"
      if client&.phone_normalized.blank? && client&.email.present?
        "storefronts.confirmation.lede_email_only"
      elsif client&.phone_normalized.present? && client&.email.blank?
        "storefronts.confirmation.lede_whatsapp_only"
      else
        "storefronts.confirmation.lede"
      end
    else
      "storefronts.confirmation.lede_#{@order.state}"
    end
  %>
  <div class="mb-6">
    <div class="font-mono text-[11px] uppercase tracking-[0.18em]" style="color: var(--brand-1);">
      <%= t("storefronts.confirmation.kicker") %>
    </div>
    <h1 class="mt-2 font-serif text-[40px] leading-[1.05] tracking-tight text-ink">
      <%= t("storefronts.confirmation.heading", first_name: @order.client&.first_name.presence || "") %>
    </h1>
    <p class="mt-3 text-[15px] leading-[1.55] text-ink-2 max-w-[620px]">
      <%= t(lede_key, kitchen: @storefront.name, default: t("storefronts.confirmation.lede", kitchen: @storefront.name)) %>
    </p>
  </div>

  <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
    <h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      <%= t("storefronts.confirmation.status_section") %>
    </h2>
    <%= render Storefronts::StatusTimelineComponent.new(steps: @status_timeline) %>
  </section>

  <section class="mb-6 grid gap-4 sm:grid-cols-2">
    <div class="rounded-[14px] border border-line bg-surface p-5">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted"><%= t("storefronts.confirmation.when_label") %></div>
      <div class="mt-1 font-serif text-[20px] text-ink">
        <%= l(@order.delivery_date, format: :long) rescue @order.delivery_date %>
      </div>
      <% if @order.delivery_start_time && @order.delivery_end_time %>
        <div class="font-mono text-[13px] text-ink-2">
          <%= @order.delivery_start_time_hhmm %>–<%= @order.delivery_end_time_hhmm %>
        </div>
      <% end %>
    </div>

    <div class="rounded-[14px] border border-line bg-surface p-5">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted"><%= t("storefronts.confirmation.where_label") %></div>
      <div class="mt-1 font-serif text-[20px] text-ink">
        <%= t("storefronts.fulfillment_types.#{@order.delivery_type}.label") %>
      </div>
      <% if @order.delivery_address.present? %>
        <div class="text-[13px] text-ink-2 mt-1">
          <%= [ @order.delivery_address, @order.colonia, @order.city ].compact_blank.join(", ") %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="mb-6 rounded-[16px] border border-line bg-surface p-6">
    <h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
      <%= t("storefronts.confirmation.items_section") %>
    </h2>
    <div class="divide-y divide-line">
      <% @order.items.each do |item| %>
        <div class="flex items-start justify-between gap-4 py-3">
          <div>
            <div class="text-[14px] font-semibold text-ink"><%= item.recipe&.name || "Platillo" %></div>
            <div class="font-mono text-[11.5px] text-muted">× <%= item.quantity %></div>
            <% if item.notes.present? %>
              <div class="mt-1 text-[12px] text-ink-2 italic"><%= item.notes %></div>
            <% end %>
          </div>
          <div class="font-mono text-[13px] text-ink">
            <%= humanized_money_with_symbol(Money.new(item.unit_price_cents.to_i * item.quantity.to_d, "MXN")) %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-4 flex items-baseline justify-between border-t border-line pt-4">
      <span class="text-[14px] font-semibold text-ink"><%= t("storefronts.cart.total") %></span>
      <span class="font-serif text-[24px] tracking-tight text-ink"><%= humanized_money_with_symbol(@order.total) %></span>
    </div>
  </section>

  <% if @storefront.public_profile.payment_notes.present? %>
    <section class="mb-6 rounded-[14px] px-5 py-4"
             style="background: var(--brand-1-soft); color: var(--brand-1);">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.14em]"><%= t("storefronts.confirmation.payment_note_label") %></div>
      <p class="mt-1 text-[14px] leading-[1.5]"><%= @storefront.public_profile.payment_notes %></p>
    </section>
  <% end %>

  <% whatsapp = @storefront.public_profile.whatsapp.presence || @storefront.public_profile.phone %>
  <% if whatsapp.present? && (normalized = Phone::NormalizeMx.call(raw: whatsapp)) %>
    <section class="mt-8 flex flex-col items-stretch gap-2 sm:items-center">
      <a href="https://wa.me/<%= normalized.sub(/\A\+/, "") %>?text=<%= ERB::Util.url_encode(t("storefronts.confirmation.whatsapp_message", kitchen: @storefront.name, id: @order.prefix_id)) %>"
         target="_blank" rel="noopener"
         class="inline-flex w-full items-center justify-center gap-2 rounded-[12px] px-6 py-4 text-[15px] font-semibold no-underline sm:w-auto"
         style="background: #25D366; color: #053019; border: 1px solid #25D366; box-shadow: 0 2px 10px rgba(37, 211, 102, 0.25);">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <%= t("storefronts.confirmation.whatsapp_cta", kitchen: @storefront.name) %>
      </a>
      <p class="text-center text-[12px] text-muted">
        <%= t("storefronts.confirmation.whatsapp_hint") %>
      </p>
    </section>
  <% end %>
</main>
