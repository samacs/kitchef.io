<% content_for :title, t("subscriptions.invoices.index.title") %>
<% content_for :page_title, t("subscriptions.invoices.index.title") %>
<% content_for :page_subtitle, t("subscriptions.invoices.index.subtitle") %>

<%# CFDI handoff lives here as a mailto until Stripe Tax MX
    automation lands. The link pre-fills with kitchen + RFC fields
    so the operator only types her RFC. %>
<%
  cfdi_subject = "Solicitud CFDI · #{Current.account.name}"
  cfdi_body    = <<~BODY
    Hola Kitchef,

    Solicito mi CFDI 4.0 con los siguientes datos fiscales:

    Cocina:        #{Current.account.name}
    RFC:           [completa aquí]
    Razón social:  [completa aquí]
    Uso CFDI:      [G03 — gastos en general, por defecto]

    Periodo a facturar: [mes / mes]

    Gracias.
  BODY
  cfdi_mailto = "mailto:no-reply@kitchef.mx?subject=#{ERB::Util.url_encode(cfdi_subject)}&body=#{ERB::Util.url_encode(cfdi_body)}"
%>

<div class="flex flex-col gap-6 max-w-[820px]">

  <div class="flex items-center justify-between gap-3 flex-wrap">
    <%= link_to subscription_path,
          class: "inline-flex items-center gap-1.5 text-[13px] font-medium text-ink-2 hover:text-ink no-underline" do %>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <%= t("subscriptions.invoices.index.back") %>
    <% end %>

    <%= link_to cfdi_mailto,
          class: "inline-flex items-center gap-1.5 text-[12.5px] font-medium px-3 py-[7px] rounded-button bg-bg-2 text-ink-2 border border-line hover:border-line-2 transition-colors no-underline" do %>
      <%= icon(:file_text, size: :xs) %>
      <%= t("subscriptions.invoices.index.cfdi_cta") %>
    <% end %>
  </div>

  <% if @invoices.any? %>
    <article class="rounded-card border border-line bg-surface overflow-hidden">
      <ul class="flex flex-col">
        <% @invoices.each do |inv| %>
          <li class="flex items-center justify-between gap-4 px-5 py-4 border-b border-line last:border-b-0">
            <div class="flex flex-col gap-0.5 min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-mono text-[13px] text-ink truncate">
                  <%= inv.number || inv.id %>
                </span>
                <%= render "status_chip", status: inv.status %>
              </div>
              <% if inv.created_at %>
                <span class="font-mono text-[11.5px] text-muted">
                  <%= l(inv.created_at.to_date, format: :long) %>
                </span>
              <% end %>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <span class="font-mono text-[14px] font-semibold text-ink tabular-nums">
                <%= number_to_currency(inv.amount_cents.to_f / 100, unit: "$", precision: 2) %>
                <span class="text-[10.5px] text-muted ml-1"><%= inv.currency %></span>
              </span>

              <% if inv.invoice_pdf %>
                <%= link_to inv.invoice_pdf,
                      class: "inline-flex items-center gap-1.5 text-[12px] font-medium px-3 py-[6px] rounded-button bg-surface text-ink-2 border border-line hover:border-line-2 transition-colors no-underline",
                      target: "_blank",
                      rel: "noopener" do %>
                  <%= icon(:download, size: :xs) %>
                  <%= t("subscriptions.invoices.index.download_pdf") %>
                <% end %>
              <% elsif inv.hosted_invoice_url %>
                <%= link_to t("subscriptions.invoices.index.view_online"),
                      inv.hosted_invoice_url,
                      class: "inline-flex items-center gap-1.5 text-[12px] font-medium px-3 py-[6px] rounded-button bg-surface text-ink-2 border border-line hover:border-line-2 transition-colors no-underline",
                      target: "_blank",
                      rel: "noopener" %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    </article>
  <% else %>
    <article class="rounded-card border border-line bg-surface px-6 py-10 flex flex-col items-center text-center gap-3">
      <span class="inline-flex h-[56px] w-[56px] items-center justify-center rounded-full bg-bg-2 text-muted">
        <%= icon(:file_text, size: :lg) %>
      </span>
      <div class="flex flex-col gap-1">
        <h3 class="font-serif text-[20px] text-ink leading-[1.2]">
          <%= t("subscriptions.invoices.index.empty_title") %>
        </h3>
        <p class="text-[13.5px] text-ink-2 leading-[1.5] max-w-[440px]">
          <%= t("subscriptions.invoices.index.empty_body") %>
        </p>
      </div>
    </article>
  <% end %>

  <%# CFDI explainer card — surfaces the manual workflow until
      Stripe Tax MX is wired. Same copy as the FAQ on /pricing
      so operators see one consistent message. %>
  <div class="rounded-card border border-line bg-bg-2 px-5 py-4 flex items-start gap-3">
    <span class="inline-flex h-[28px] w-[28px] items-center justify-center rounded-full bg-surface text-muted shrink-0 border border-line">
      <%= icon(:info, size: :xs) %>
    </span>
    <div class="flex flex-col gap-1 min-w-0">
      <div class="text-[13px] font-semibold text-ink"><%= t("subscriptions.invoices.index.cfdi_title") %></div>
      <div class="text-[12.5px] text-ink-2 leading-[1.5]">
        <%= t("subscriptions.invoices.index.cfdi_body") %>
      </div>
    </div>
  </div>
</div>
