<% content_for :title, t("subscriptions.cancellations.new.title") %>
<% content_for :page_title, t("subscriptions.cancellations.new.title") %>
<% content_for :page_subtitle, t("subscriptions.cancellations.new.subtitle") %>

<%# 4-step cancel save-flow, step 1 of 4 — single-question exit
    survey. Submitting routes to the matched save offer (POST
    /subscription/cancel). %>
<div class="max-w-[640px] flex flex-col gap-6">
  <article class="rounded-card border border-line bg-surface p-6 flex flex-col gap-5">
    <div class="flex flex-col gap-1">
      <%= render Ui::KickerComponent.new(text: t("subscriptions.cancellations.new.kicker")) %>
      <h2 class="font-serif text-[26px] leading-[1.1] tracking-[-0.01em] text-ink">
        <%= t("subscriptions.cancellations.new.headline") %>
      </h2>
      <p class="text-[14px] text-ink-2 leading-[1.5]">
        <%= t("subscriptions.cancellations.new.lede") %>
      </p>
    </div>

    <%= form_with url: cancel_subscription_path,
                  method: :post,
                  data:   { turbo: false },
                  class:  "flex flex-col gap-3" do %>
      <% Subscriptions::CancellationsController::REASONS.each_with_index do |reason, idx| %>
        <label class="kc-plan-card flex items-center gap-3 rounded-card border bg-bg-2 px-4 py-3 cursor-pointer">
          <%= radio_button_tag :reason, reason, idx == 0,
                class: "h-4 w-4 accent-accent shrink-0" %>
          <span class="flex flex-col gap-0.5 min-w-0">
            <span class="text-[14px] font-medium text-ink leading-[1.3]">
              <%= t("subscriptions.cancellations.reasons.#{reason}.label") %>
            </span>
            <span class="text-[12.5px] text-ink-2 leading-[1.4]">
              <%= t("subscriptions.cancellations.reasons.#{reason}.body") %>
            </span>
          </span>
        </label>
      <% end %>

      <div class="flex items-center justify-between gap-3 pt-3 border-t border-line">
        <%= link_to t("subscriptions.cancellations.new.back"),
              subscription_path,
              class: "inline-flex items-center gap-1.5 text-[13px] font-medium text-ink-2 hover:text-ink transition-colors no-underline" %>
        <%= submit_tag t("subscriptions.cancellations.new.continue_cta"),
              class: "inline-flex items-center justify-center gap-2 text-[13px] font-semibold px-4 py-2 rounded-button bg-ink text-bg border border-ink hover:bg-ink-2 hover:border-ink-2 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </article>
</div>
