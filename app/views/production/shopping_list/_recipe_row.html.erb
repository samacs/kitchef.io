<li class="kc-print-row flex items-start gap-4 px-4 py-4 print:gap-2 print:px-0 print:py-[3px]">
  <span class="mt-[3px] inline-block w-5 h-5 rounded-sm border border-ink-2 shrink-0 print:w-[11px] print:h-[11px] print:mt-[4px] print:border-[#555]" aria-hidden="true"></span>
  <div class="flex-1 flex flex-col gap-1 print:gap-0">
    <div class="flex items-baseline justify-between gap-3 print:gap-2">
      <span class="text-[17px] text-ink font-medium print:text-[11.5px] print:font-normal"><%= row.recipe_name %></span>
      <span class="font-mono text-[14px] text-ink-2 shrink-0 tabular-nums print:text-[11px]">
        <%= row.display_qty %> <%= t("units.#{row.unit}", default: row.unit) %>
      </span>
    </div>
    <% unless row.prep_notes.empty? %>
      <p class="text-[12.5px] text-muted leading-[1.4] print:hidden">
        <%= row.prep_notes.uniq.join(" · ") %>
      </p>
    <% end %>
  </div>
</li>
