<% content_for :title, t("production.shopping_list.title") %>
<% content_for :page_title, t("production.shopping_list.title") %>
<% content_for :page_subtitle, t("production.shopping_list.subtitle") %>

<% content_for :page_action do %>
  <%= link_to production_path,
        class: "inline-flex items-center gap-2 text-[13px] font-medium px-3.5 py-[8px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors print:hidden" do %>
    <%= icon(:arrow_left, size: :xs) %>
    <span><%= t("production.shopping_list.back_cta") %></span>
  <% end %>
<% end %>

<article class="kc-print-shopping-list">
  <section class="mb-6 flex items-baseline justify-between gap-3 print:mb-3 print:gap-2">
    <div class="flex flex-col gap-1 print:gap-0">
      <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted print:hidden">
        <%= t("production.shopping_list.kicker") %>
      </span>
      <h1 class="font-serif text-[28px] leading-[1.1] text-ink tracking-tight print:text-[16px] print:font-sans print:font-semibold print:leading-tight">
        <%= t("production.shopping_list.headline") %>
        <span class="hidden print:inline font-normal text-ink-2 font-mono text-[10.5px] ml-2">
          · <%= t("production.shopping_list.window", from: l(@list.starting, format: :short), to: l(@list.ending, format: :short)) %>
        </span>
      </h1>
      <p class="font-mono text-[11.5px] text-muted uppercase tracking-[0.14em] pt-1 print:hidden">
        <%= t("production.shopping_list.window", from: l(@list.starting, format: :long), to: l(@list.ending, format: :long)) %>
      </p>
    </div>
    <button type="button"
            onclick="window.print(); return false;"
            class="hidden sm:inline-flex items-center gap-2 text-[12.5px] font-medium px-3 py-[7px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors print:hidden">
      <%= icon(:printer, size: :xs) %>
      <span><%= t("production.shopping_list.print_cta") %></span>
    </button>
  </section>

  <% if @weekly_spent_cents.to_i.positive? %>
    <aside class="mb-5 rounded-card border border-accent/30 bg-accent-soft px-4 py-3 flex items-center justify-between gap-3 print:hidden">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-accent">
          <%= t("production.shopping_list.week_totals.kicker") %>
        </span>
        <span class="font-serif text-[22px] text-accent-2 tabular-nums">
          <%= humanized_money_with_symbol(Money.new(@weekly_spent_cents, "MXN")) %>
        </span>
      </div>
      <span class="font-mono text-[11.5px] uppercase tracking-[0.14em] text-accent-2">
        <%= t("production.shopping_list.week_totals.marked_count", count: @weekly_marked_count) %>
      </span>
    </aside>
  <% end %>

  <% if @list.empty? %>
    <section class="rounded-panel border border-line bg-surface/60 px-6 py-10 text-center print:hidden">
      <p class="font-serif text-[20px] text-ink"><%= t("production.shopping_list.empty.headline") %></p>
      <p class="mt-2 text-muted text-[13.5px] max-w-prose mx-auto"><%= t("production.shopping_list.empty.sub") %></p>
    </section>
  <% elsif @list.advanced? %>
    <div class="flex flex-col gap-6 print:gap-2">
      <% @list.rows.group_by(&:category).sort_by { |cat, _| cat&.position || 999 }.each do |category, group| %>
        <section class="flex flex-col gap-2 print:gap-0">
          <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted print:text-[9.5px] print:tracking-[0.12em] print:mb-0.5 print:mt-2 print:first:mt-0">
            <%= category&.name || t("ingredients.index.uncategorized") %>
          </h2>
          <ul class="flex flex-col divide-y divide-line rounded-card border border-line bg-surface print:border-0 print:rounded-none print:divide-[#d4d4d4]">
            <% group.each do |row| %>
              <%= render partial: "production/shopping_list/ingredient_row",
                    locals: { row: row, marked_summary: (@marked_by_ingredient[row.ingredient&.id] if @marked_by_ingredient) } %>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  <% else %>
    <ul class="flex flex-col divide-y divide-line rounded-card border border-line bg-surface print:border-0 print:rounded-none print:divide-[#d4d4d4]">
      <%= render partial: "production/shopping_list/recipe_row", collection: @list.rows, as: :row %>
    </ul>
  <% end %>

  <% if !@list.empty? && !@list.advanced? %>
    <p class="mt-6 text-muted text-[12.5px] max-w-prose print:hidden">
      <%= t("production.shopping_list.decomposition_nudge") %>
    </p>
  <% end %>
</article>
