<% content_for :title, t("onboarding.decomposition.title") %>
<% content_for :page_title, t("onboarding.decomposition.title") %>
<% content_for :page_subtitle, t("onboarding.decomposition.subtitle") %>

<div class="max-w-[820px] mx-auto flex flex-col gap-6">
  <section class="bg-surface border border-line rounded-panel shadow-card p-7 sm:p-9">
    <div class="flex flex-col gap-3 mb-6">
      <%= render Ui::KickerComponent.new(text: t("onboarding.decomposition.kicker")) %>
      <h1 class="font-serif text-[28px] leading-[1.1] tracking-[-0.01em] text-ink">
        <%= t("onboarding.decomposition.headline", name: @recipe.name) %>
      </h1>
      <p class="text-[14px] text-ink-2 leading-[1.55] max-w-prose">
        <%= t("onboarding.decomposition.lede") %>
      </p>
    </div>

    <%= form_with url: onboarding_decomposition_path(@recipe), method: :post, class: "flex flex-col gap-5" do |form| %>
      <% if @recipe.errors.any? %>
        <div role="alert"
             class="bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))] text-err border border-err/30 rounded-[10px] px-4 py-3 flex flex-col gap-1.5">
          <span class="text-[12px] font-mono uppercase tracking-[0.14em]">
            <%= t("onboarding.shared.errors_title") %>
          </span>
          <ul class="text-[13px] leading-[1.4] list-disc list-inside">
            <% @recipe.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= fields_for :recipe, @recipe do |rf| %>
        <%= render Recipes::ComponentsEditorComponent.new(recipe: @recipe, form: rf) %>
      <% end %>

      <div class="flex items-center justify-between gap-3 pt-2">
        <%= link_to t("onboarding.decomposition.skip"),
              recipes_path,
              class: "inline-flex items-center justify-center gap-2 text-[13px] font-medium px-4 py-[10px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" %>
        <%= form.submit t("onboarding.decomposition.submit"),
              class: "inline-flex items-center justify-center gap-2 text-[14px] font-semibold px-[22px] py-[10px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" %>
      </div>
    <% end %>
  </section>
</div>
