<% content_for :title, t("onboarding.welcome.seo_title") %>

<div class="mx-auto w-full max-w-[640px]" data-step-transition-target="step">
  <div class="bg-surface border border-line rounded-panel shadow-card p-8 sm:p-12 flex flex-col gap-6">
    <div class="flex flex-col gap-3">
      <%= render Ui::KickerComponent.new(text: t("onboarding.welcome.kicker")) %>
      <h1 class="font-serif text-[40px] sm:text-[48px] leading-[1.04] tracking-[-0.02em] text-ink pb-[0.1em]">
        <%= t("onboarding.welcome.title_greeting") %>, <em><%= Current.user.first_name %></em><%= t("onboarding.welcome.title_suffix") %>
      </h1>
      <p class="text-[15.5px] text-ink-2 leading-[1.55] max-w-[52ch]">
        <%= t("onboarding.welcome.lede") %>
      </p>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% Onboarding::StepperComponent::STEPS.each_with_index do |key, idx| %>
        <li class="flex items-start gap-3 p-3 rounded-card-sm bg-bg-2/60 border border-line">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-accent-soft text-accent font-mono text-[12px] shrink-0">
            <%= idx + 1 %>
          </span>
          <span class="text-[14px] text-ink font-medium leading-[1.35]">
            <%= t("onboarding.stepper.#{key}") %>
          </span>
        </li>
      <% end %>
    </ol>

    <div class="flex justify-end pt-2">
      <%= link_to t("onboarding.welcome.cta"),
            onboarding_kitchen_path,
            class: "inline-flex items-center justify-center gap-2 text-[14px] font-semibold px-[22px] py-[12px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" %>
    </div>
  </div>
</div>
