<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <title><%= content_for(:title) || @storefront&.name || "Kitchef" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="<%= Storefronts::Palette.primary_color_for(@storefront) %>" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="<%= Storefronts::Palette.primary_color_for(@storefront, dark: true) %>" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Pre-paint theme boot — seeds the storefront from the customer's
        `prefers-color-scheme` and respects any customer override stored
        in localStorage. We do NOT let the operator force a theme on
        visitors; respecting the customer's system preference is the
        accessible default. The localStorage key is slug-scoped so a
        customer's preference on Elena's storefront doesn't leak onto
        Mario's. %>
    <script>
      (function() {
        var slug = <%= raw (@storefront&.slug || "").to_json %>;
        var key = "kitchef_sf_theme_" + slug;
        var stored = localStorage.getItem(key);
        var mode = stored || "auto";
        var sys = matchMedia("(prefers-color-scheme: dark)").matches;
        var dark = mode === "dark" || (mode === "auto" && sys);
        if (dark) document.documentElement.classList.add("dark");
        document.documentElement.dataset.themeMode = mode;
      })();
    </script>

    <%# Brand palette — inline per-request. Light variables live on :root;
        dark variables live on .dark. The customer's toggle just flips the
        .dark class; no server round-trip. The operator app never reads
        these variables (it uses the Tailwind `accent` token).

        The dark-mode chrome block overrides the operator-app defaults
        (warm-green-tinted near-black) with a PALETTE-NEUTRAL near-black
        so every kitchen's chosen palette — rosa, cobalto, bosque, etc. —
        sits on a background that doesn't clash with its hue. Operator
        app dark mode stays warm-green-tinted because its own palette is
        already green. %>
    <style id="storefront-palette">
      :root {
        <%= raw Storefronts::Palette.css_vars_for(@storefront, dark: false) %>
      }
      html.dark {
        <%= raw Storefronts::Palette.css_vars_for(@storefront, dark: true) %>

        /* Palette-neutral dark chrome (overrides app.css `.dark`).
           Slight cool-neutral — close to black but not pure — so all
           10 brand palettes harmonize against it. */
        --color-bg:        #0F1013;
        --color-bg-2:      #17181C;
        --color-surface:   #1C1D22;
        --color-line:      #2B2D33;
        --color-line-2:    #3A3C43;
        --color-ink:       #ECECEF;
        --color-ink-2:     #BCBDC3;
        --color-muted:     #82848C;
      }
    </style>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-bg text-ink-2 font-sans antialiased"
        data-controller="<%= "storefront-cart" if @storefront %>"
        <% if @storefront %>data-storefront-cart-slug-value="<%= @storefront.slug %>"<% end %>>
    <%= render Storefronts::HeaderComponent.new(storefront: @storefront) if @storefront %>

    <%= yield %>

    <%= render Storefronts::FooterComponent.new(storefront: @storefront) if @storefront %>

    <%# Cart drawer — owned by the layout so the header's "Carrito"
        button works on every storefront page (show, menu, checkout,
        confirmation), not just on `/:slug` where the component used
        to live inside `<main>`. %>
    <%= render Storefronts::CartDrawerComponent.new(storefront: @storefront) if @storefront %>

    <%# Customize modal — reused for quick-add from menu + edit from cart %>
    <% if @storefront %>
      <dialog id="customize-modal"
              class="fixed inset-0 z-[250] m-0 hidden open:flex h-full w-full max-w-none items-end justify-center bg-transparent p-0 sm:items-center backdrop:bg-[rgba(14,23,20,0.5)] backdrop:backdrop-blur-sm"
              data-controller="storefront-customize-modal"
              data-storefront-customize-modal-slug-value="<%= @storefront.slug %>">
        <div class="w-full max-w-[480px] max-h-[92vh] overflow-hidden rounded-t-[20px] sm:rounded-[20px] border border-line bg-bg shadow-2xl flex flex-col">
          <div class="flex items-center justify-between border-b border-line px-5 py-3.5">
            <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted"
                  data-storefront-customize-modal-target="title">
              <%= t("storefronts.recipe.order_kicker") %>
            </span>
            <button type="button"
                    data-action="click->storefront-customize-modal#close"
                    class="inline-flex h-8 w-8 items-center justify-center rounded-[8px] border border-line bg-surface text-ink-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div class="flex-1 overflow-y-auto px-5 py-4 kc-scroll"
               data-storefront-customize-modal-target="body">
            <turbo-frame id="customize-modal-content"
                         data-storefront-customize-modal-target="frame">
              <div class="flex items-center justify-center py-12">
                <div class="h-6 w-6 animate-spin rounded-full border-2 border-line border-t-[var(--brand-1)]"></div>
              </div>
            </turbo-frame>
          </div>
        </div>
      </dialog>
    <% end %>

    <%= render "shared/flash_region" %>
  </body>
</html>
