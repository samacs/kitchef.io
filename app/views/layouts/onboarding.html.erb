<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <title><%= content_for(:title) || "Kitchef" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t('marketing.meta.default_description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_include_tag "theme_bootstrap" %>
    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-bg text-ink-2 font-sans antialiased">
    <header class="border-b border-line">
      <div class="mx-auto max-w-[1240px] px-5 sm:px-7 py-[14px] flex items-center justify-between gap-4">
        <%= render Ui::LogoComponent.new(href: onboarding_root_path) %>

        <div class="flex items-center gap-2">
          <%= render Ui::ThemeToggleComponent.new %>
          <%= button_to t("onboarding.shared.sign_out", default: "Cerrar sesión"),
                destroy_session_path,
                method: :delete,
                class: "hidden sm:inline-flex items-center gap-1.5 text-[13px] font-medium text-ink-2 hover:text-ink transition-colors px-3 py-[8px] rounded-[7px] hover:bg-bg-2 bg-transparent border-0",
                form: { class: "contents" } %>
        </div>
      </div>
    </header>

    <% if content_for?(:onboarding_step) %>
      <div class="mx-auto max-w-[1100px] px-5 sm:px-7 pt-6 sm:pt-9">
        <%= render Onboarding::StepperComponent.new(current: content_for(:onboarding_step).to_i) %>
      </div>
    <% end %>

    <main class="mx-auto max-w-[1100px] px-5 sm:px-7 py-8 sm:py-12">
      <div class="flex flex-col gap-5" data-controller="step-transition">
        <%= render Ui::FlashComponent.new(kind: :alert,  message: flash[:alert]) %>
        <%= render Ui::FlashComponent.new(kind: :notice, message: flash[:notice]) %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
