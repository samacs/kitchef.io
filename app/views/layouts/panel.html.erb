<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <title><%= content_for(:title) || "Kitchef" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= javascript_include_tag "theme_bootstrap" %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <%= render "shared/favicon" %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-bg text-ink-2 font-sans antialiased"
        data-controller="target-highlight">
    <%# Single drawer controller wrapping both the drawer (rendered
        first so its fixed backdrop+panel sit outside the top-bar's
        backdrop-filter stacking context) and the main layout. The
        hamburger trigger inside the top bar uses
        `data-action="click->drawer#open"` — Stimulus walks up from the
        trigger and finds this wrapper. `class: "contents"` keeps the
        wrapper invisible to layout. %>
    <div data-controller="drawer" class="contents">
      <%= render Nav::DashboardDrawerComponent.new(
            current_user: Current.user,
            current_account: Current.account,
            current_path: request.path) %>

      <div class="flex min-h-screen">
        <%= render Nav::DashboardSidebarComponent.new(
              current_user: Current.user,
              current_account: Current.account,
              current_path: request.path) %>

        <div class="flex-1 min-w-0 flex flex-col">
          <%# Phase 14, Slice 11 — demo banner. Renders nothing for
              non-demo accounts so the production layout is identical. %>
          <%= render Demo::BannerComponent.new(account: Current.account, context: :operator) %>

          <%= render Nav::DashboardTopBarComponent.new(
                current_user: Current.user,
                current_account: Current.account,
                title: content_for(:page_title),
                subtitle: content_for(:page_subtitle)) %>

          <main class="flex-1 px-4 sm:px-5 lg:px-7 py-6 lg:py-8"><%= yield %></main>

          <% if content_for?(:fab_path) %>
            <%= link_to content_for(:fab_path),
                  class: "sm:hidden fixed bottom-5 right-5 z-40 flex items-center justify-center w-14 h-14 rounded-full bg-accent text-bg shadow-cta active:scale-95 transition-transform",
                  aria: { label: content_for(:fab_label).presence || t("ui.fab.add") } do %>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Skip the drawer shell when the response would otherwise end up
        with two `id="drawer_content"` elements. Two triggers:
        1. The request carries a `Turbo-Frame: drawer_content` header
           (a real frame navigation — shell already lives in the open
           drawer, no need to re-emit).
        2. The view opts out via `content_for(:drawer_only)` — covers
           the case where the browser hits the URL without the Turbo-
           Frame header (Turbo link prefetch on hover, page reload,
           shared link, any `Accept: */*` fetch). The view is a pure
           drawer fragment, so rendering the shell again would
           duplicate the frame id and Turbo sometimes snaps the empty
           one into the drawer, leaving "Content missing". %>
    <% unless turbo_frame_request_id == "drawer_content" || content_for?(:drawer_only) %>
      <%= render "shared/right_drawer" %>
    <% end %>

    <%= render Nav::CommandPaletteComponent.new %>
    <%= render "shared/flash_region" %>
  </body>
</html>
