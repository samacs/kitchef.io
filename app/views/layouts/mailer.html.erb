<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:mail_subject).presence || "Kitchef" %></title>
  </head>
  <%# Shared chrome for every outbound platform mail. Per-mailer templates
      supply just the body content; optional per-mail overrides:
        content_for :mail_cover_image_url → full-bleed hero on top
        content_for :mail_kitchen_name    → subtle "De: Cocina X" tag line
        content_for :mail_footer          → replaces the default disclaimer
      Everything here is inlined-style + table-based so Outlook/Gmail/iOS
      render consistently. %>
  <body style="margin:0;padding:0;background-color:#F8F6F1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#0E1714;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#F8F6F1;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;width:100%;background-color:#FFFFFF;border:1px solid #E6E1D8;border-radius:16px;overflow:hidden;">
            <% if content_for?(:mail_cover_image_url) %>
              <tr>
                <td>
                  <img src="<%= content_for(:mail_cover_image_url) %>"
                       alt=""
                       width="560"
                       style="display:block;width:100%;max-width:560px;height:auto;">
                </td>
              </tr>
            <% end %>

            <tr>
              <td>
                <%= yield %>
              </td>
            </tr>
          </table>

          <% if content_for?(:mail_footer) %>
            <%= content_for(:mail_footer) %>
          <% else %>
            <p style="margin:18px auto 0 auto;font-size:12px;color:#6B7670;text-align:center;max-width:520px;">
              <%= content_for?(:mail_kitchen_name) ?
                  t("mailer.footer.from_kitchen", kitchen_name: content_for(:mail_kitchen_name)) :
                  t("mailer.footer.generic") %>
            </p>
          <% end %>
        </td>
      </tr>
    </table>
  </body>
</html>
