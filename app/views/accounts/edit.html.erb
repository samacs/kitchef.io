<% content_for :title, t("account.title") %>
<% content_for :page_title, t("account.page_title") %>
<% content_for :page_subtitle, t("account.page_subtitle") %>

<%# Autosave uses a per-page inline indicator rather than flashes on
    every keystroke save. Any one-off flash (destroy-logo, destroy-
    cover button_to posts) surfaces through the shared flash region. %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
  <%# ================================================================
      LEFT — form (spans 2 of 3 columns on lg+)
      ================================================================ %>
  <div class="lg:col-span-2 min-w-0">
    <%= form_with model: @account,
                  url: account_path,
                  method: :patch,
                  html: {
                    multipart: true,
                    class: "flex flex-col gap-6",
                    data: {
                      controller: "live-preview-source form-autosave",
                      action: "change->form-autosave#save input->form-autosave#save"
                    }
                  } do |f| %>

      <%# Identity — name, tagline, description, logo, cover, palettes.
          Everything that the public storefront hero shows. %>
      <section class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
              <%= t("account.sections.identity_kicker") %>
            </div>
            <h2 class="mt-1 font-serif text-[22px] leading-tight text-ink">
              <%= t("account.sections.identity_title") %>
            </h2>
            <p class="mt-1 text-[13px] text-ink-2"><%= t("account.sections.identity_lede") %></p>
          </div>
          <%# Autosave indicator — hidden by default, pops up on any
              save attempt. `data-form-autosave-target="status"` is the
              hook the controller writes to. %>
          <span
            data-form-autosave-target="status"
            data-label-saving="<%= t("account.autosave.saving") %>"
            data-label-saved="<%= t("account.autosave.saved") %>"
            data-label-error="<%= t("account.autosave.error") %>"
            class="hidden shrink-0 inline-flex items-center gap-1.5 rounded-full border border-line bg-bg-2 px-2.5 py-1 font-mono text-[11px] font-medium
                   data-[state=saving]:text-muted
                   data-[state=saved]:text-accent data-[state=saved]:border-accent/30 data-[state=saved]:bg-accent-soft
                   data-[state=error]:text-err data-[state=error]:border-err/30 data-[state=error]:bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))]"
            role="status"
            aria-live="polite"
          ></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <%= f.label :name, t("account.fields.name"), class: "block text-[12px] font-medium text-muted mb-1" %>
            <%= f.text_field :name,
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink",
                  data: {
                    action: "input->live-preview-source#emit",
                    live_preview_source_field_param: "name"
                  } %>
          </div>

          <%= f.fields_for :public_profile, @account.public_profile do |p| %>
            <div>
              <%= p.label :tagline, t("account.fields.tagline"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :tagline,
                    placeholder: t("account.fields.tagline_placeholder"),
                    class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink",
                    data: {
                      action: "input->live-preview-source#emit",
                      live_preview_source_field_param: "tagline"
                    } %>
            </div>
          <% end %>
        </div>

        <%= f.fields_for :public_profile, @account.public_profile do |p| %>
          <div>
            <%= p.label :description, t("account.fields.description"), class: "block text-[12px] font-medium text-muted mb-1" %>
            <%= p.text_area :description, rows: 3, maxlength: Accounts::PublicProfile::DESCRIPTION_MAX,
                  placeholder: t("account.fields.description_placeholder"),
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink leading-[1.55]",
                  data: {
                    action: "input->live-preview-source#emit",
                    live_preview_source_field_param: "description"
                  } %>
            <p class="mt-1 text-[11.5px] text-muted">
              <%= t("account.fields.description_hint", max: Accounts::PublicProfile::DESCRIPTION_MAX) %>
            </p>
          </div>
        <% end %>

        <%# Logo + cover — both with live preview on file pick. %>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.fields.logo") %></label>
            <div class="flex items-center gap-3">
              <div class="h-[72px] w-[72px] shrink-0 overflow-hidden rounded-[10px] border border-line bg-bg-2">
                <% if @account.logo.attached? %>
                  <%= image_tag @account.logo.variant(:thumb), class: "h-full w-full object-cover", alt: "" %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center font-serif italic text-[28px] text-muted">
                    <%= @account.name.first&.upcase %>
                  </div>
                <% end %>
              </div>
              <div class="flex flex-1 flex-col gap-2">
                <%= f.file_field :logo,
                      accept: "image/jpeg,image/png,image/webp,image/heic",
                      class: "text-[12px]",
                      data: {
                        action: "change->live-preview-source#emit",
                        live_preview_source_field_param: "logo"
                      } %>
                <% if @account.logo.attached? %>
                  <%# Anchor with `data-turbo-method` instead of
                      button_to — button_to emits a nested <form>
                      which HTML5 doesn't allow, so the browser
                      silently closes the outer autosave form at
                      this point and any field below stops saving. %>
                  <%= link_to t("account.fields.logo_remove"),
                        logo_account_path,
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: t("account.fields.logo_remove_confirm"),
                          form_autosave_skip: true
                        },
                        class: "self-start text-[12px] text-muted hover:text-err no-underline" %>
                <% end %>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.fields.cover") %></label>
            <div class="flex items-center gap-3">
              <div class="h-[72px] w-[120px] shrink-0 overflow-hidden rounded-[10px] border border-line bg-bg-2">
                <% if @account.cover_photo.attached? %>
                  <%= image_tag @account.cover_photo.variant(:card), class: "h-full w-full object-cover", alt: "" %>
                <% end %>
              </div>
              <div class="flex flex-1 flex-col gap-2">
                <%= f.file_field :cover_photo,
                      accept: "image/jpeg,image/png,image/webp,image/heic",
                      class: "text-[12px]",
                      data: {
                        action: "change->live-preview-source#emit",
                        live_preview_source_field_param: "cover"
                      } %>
                <% if @account.cover_photo.attached? %>
                  <%= link_to t("account.fields.cover_remove"),
                        cover_account_path,
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: t("account.fields.cover_remove_confirm"),
                          form_autosave_skip: true
                        },
                        class: "self-start text-[12px] text-muted hover:text-err no-underline" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <%# Palettes + theme. %>
        <%= f.fields_for :branding, @account.branding do |b| %>
          <div>
            <label class="mb-2 block text-[13px] font-medium text-ink">
              <%= t("account.branding.primary_label") %>
            </label>
            <%= render Accounts::PalettePickerComponent.new(
                  form: b,
                  attribute: :palette,
                  selected: @account.branding.palette,
                  live_preview_field: "palette") %>
          </div>

          <div>
            <label class="mb-2 block text-[13px] font-medium text-ink">
              <%= t("account.branding.secondary_label") %>
            </label>
            <%= render Accounts::PalettePickerComponent.new(
                  form: b,
                  attribute: :secondary_palette,
                  selected: @account.branding.secondary_palette,
                  live_preview_field: "secondary_palette") %>
          </div>

        <% end %>
      </section>

      <%# Contact — phone/WA/IG/location/zones/payment. %>
      <section class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6">
        <div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("account.sections.contact_kicker") %>
          </div>
          <h2 class="mt-1 font-serif text-[22px] leading-tight text-ink">
            <%= t("account.sections.contact_title") %>
          </h2>
          <p class="mt-1 text-[13px] text-ink-2"><%= t("account.sections.contact_lede") %></p>
        </div>

        <%= f.fields_for :public_profile, @account.public_profile do |p| %>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <%= p.label :phone, t("account.fields.phone"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :phone, placeholder: "+52 55 1234 5678",
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono" %>
            </div>
            <div>
              <%= p.label :whatsapp, t("account.fields.whatsapp"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :whatsapp, placeholder: "+52 55 1234 5678",
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono" %>
            </div>
            <div>
              <%= p.label :instagram, t("account.fields.instagram"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :instagram, placeholder: "cocinadeelena",
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
            </div>
            <div>
              <%= p.label :colonia, t("account.fields.colonia"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :colonia,
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
            </div>
            <div>
              <%= p.label :city, t("account.fields.city"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :city,
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
            </div>
            <div>
              <%= p.label :delivery_zones, t("account.fields.delivery_zones"), class: "block text-[12px] font-medium text-muted mb-1" %>
              <%= p.text_field :delivery_zones, placeholder: "Condesa, Del Valle, Roma",
                  class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
              <p class="mt-1 text-[11.5px] text-muted"><%= t("account.fields.delivery_zones_hint") %></p>
            </div>
          </div>

          <div>
            <%= p.label :payment_notes, t("account.fields.payment_notes"), class: "block text-[12px] font-medium text-muted mb-1" %>
            <%= p.text_area :payment_notes, rows: 2,
                placeholder: t("account.fields.payment_notes_placeholder"),
                class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
            <p class="mt-1 text-[11.5px] text-muted"><%= t("account.fields.payment_notes_hint") %></p>
          </div>
        <% end %>

        <div class="rounded-card border border-line bg-bg/60 p-4">
          <div class="flex items-baseline justify-between gap-3">
            <div>
              <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
                <%= t("account.fields.ordering_hours_label") %>
              </div>
              <p class="mt-1 text-[13px] text-ink-2 max-w-[440px]">
                <%= t("account.fields.ordering_hours_moved_hint") %>
              </p>
            </div>
            <%= link_to schedule_path,
                  class: "inline-flex items-center gap-1.5 rounded-button border border-line bg-surface px-3 py-1.5 text-[12.5px] font-medium text-ink-2 hover:border-line-2 no-underline" do %>
              <%= icon(:calendar, size: :xs) %>
              <%= t("account.fields.ordering_hours_edit_cta") %>
            <% end %>
          </div>
        </div>

        <%# ---- Packaging default ------------------------------------- %>
        <% default_pkg_cents = @account.settings.default_packaging_cents.to_i %>
        <% default_pkg_display = default_pkg_cents.zero? ? "" : format("%.2f", default_pkg_cents / 100.0) %>
          <div class="rounded-card border border-line bg-bg/60 p-4">
            <div class="flex items-baseline justify-between gap-3 flex-wrap">
              <div class="max-w-[420px]">
                <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-muted">
                  <%= t("account.fields.default_packaging.label") %>
                </div>
                <p class="mt-1 text-[13px] text-ink-2">
                  <%= t("account.fields.default_packaging.hint") %>
                </p>
              </div>
              <span class="relative flex items-center">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted font-mono text-[13px]">$</span>
                <input type="text"
                       inputmode="decimal"
                       name="account[settings][default_packaging]"
                       value="<%= default_pkg_display %>"
                       placeholder="0.00"
                       step="0.01"
                       min="0"
                       class="w-[140px] bg-surface text-ink border border-line hover:border-line-2 rounded-input pl-7 pr-3 py-2 text-[14px] leading-[1.3] font-mono tabular-nums outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" />
              </span>
            </div>
            <p class="mt-2 text-[11.5px] text-muted"><%= t("account.fields.default_packaging.pesos_hint") %></p>
          </div>
      </section>

      <%# Recolección — kitchen pickup address + interactive map %>
      <section class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6"
               data-controller="kitchen-address-map"
               data-kitchen-address-map-api-key-value="<%= ENV["GOOGLE_API_KEY"].to_s %>"
               data-kitchen-address-map-initial-lat-value="<%= @account.latitude || 0 %>"
               data-kitchen-address-map-initial-lon-value="<%= @account.longitude || 0 %>">
        <div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("account.sections.pickup_kicker") %>
          </div>
          <h2 class="mt-1 font-serif text-[22px] leading-tight text-ink">
            <%= t("account.sections.pickup_title") %>
          </h2>
          <p class="mt-1 text-[13px] text-ink-2"><%= t("account.sections.pickup_lede") %></p>
        </div>

        <%# Show-publicly toggle, in the same canonical pattern as the
            Pagos checkboxes below (mt-[3px] w-4 h-4 accent-accent + label/hint). %>
        <%= f.fields_for :public_profile, @account.public_profile do |p| %>
          <div class="rounded-card-sm border border-line bg-bg-2/60">
            <label class="flex items-start gap-3 p-4 cursor-pointer">
              <input type="hidden" name="account[public_profile][show_pickup_address]" value="0">
              <%= p.check_box :show_pickup_address,
                    {
                      checked: @account.public_profile.show_pickup_address,
                      class: "mt-[3px] w-4 h-4 accent-accent"
                    },
                    "1", "0" %>
              <div class="flex-1 flex flex-col gap-1">
                <span class="text-[14px] font-medium text-ink"><%= t("account.pickup.show_publicly_label") %></span>
                <span class="text-[12px] text-muted"><%= t("account.pickup.show_publicly_hint") %></span>
              </div>
            </label>
          </div>
        <% end %>

        <%# Address input + suggestions popover %>
        <div class="flex flex-col gap-2 relative">
          <label class="block text-[12px] font-medium text-muted" for="kitchen_street_address">
            <%= t("account.pickup.address_label") %>
          </label>
          <%= f.text_field :street_address,
                id: "kitchen_street_address",
                placeholder: t("account.pickup.address_placeholder"),
                autocomplete: "off",
                data: {
                  kitchen_address_map_target: "input",
                  action: "input->kitchen-address-map#search focus->kitchen-address-map#search blur->kitchen-address-map#hideSuggestionsSoon"
                },
                class: "w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink" %>
          <p class="text-[11.5px] text-muted"><%= t("account.pickup.address_hint") %></p>

          <%# Suggestions render below the input. The controller toggles
              `hidden` on this container — never inserts content into the
              input itself, so the operator stays in control of what she
              typed. %>
          <div data-kitchen-address-map-target="suggestions"
               class="hidden absolute left-0 right-0 top-full mt-1 z-20 rounded-input border border-line bg-surface shadow-lift overflow-hidden"></div>

          <%= f.hidden_field :latitude,
                value: @account.latitude,
                data: { kitchen_address_map_target: "lat" } %>
          <%= f.hidden_field :longitude,
                value: @account.longitude,
                data: { kitchen_address_map_target: "lon" } %>
        </div>

        <%# Map — full-width inside the card %>
        <div class="rounded-card-sm overflow-hidden border border-line bg-bg-2 relative">
          <div data-kitchen-address-map-target="map" class="w-full h-[280px]"></div>

          <%# Fallback shown when GOOGLE_API_KEY is unset (local dev w/o
              key, prod misconfig). The form still works — the operator
              just doesn't get the visual map. Kept inside the same card
              border so the layout doesn't shift. %>
          <div data-kitchen-address-map-target="fallback"
               class="hidden absolute inset-0 flex items-center justify-center text-center px-6 text-[13px] text-muted">
            <%= t("account.pickup.map_unavailable") %>
          </div>
        </div>

        <%# Open in Google Maps deep-link — only visible when coords exist. %>
        <a data-kitchen-address-map-target="directionsLink"
           href="#"
           target="_blank" rel="noopener"
           class="<%= "hidden" unless @account.geocoded? %> self-start inline-flex items-center gap-1.5 rounded-button border border-line bg-surface px-3 py-1.5 text-[12.5px] font-medium text-ink-2 hover:border-line-2 no-underline">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <%= t("account.pickup.open_in_google_maps") %>
        </a>

        <%# Geocoding error banner — shown when the server-side fallback
            tried to resolve the address and Google returned ZERO_RESULTS
            or a quota error. Operator can re-type to retry; cooldown is
            1 hour by default to avoid burning quota on a typo. %>
        <% if @account.geocoding_failed? %>
          <div class="rounded-card-sm border border-warn/30 bg-[color-mix(in_oklab,var(--color-warn)_8%,var(--color-surface))] p-3 flex items-start gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warn shrink-0 mt-0.5" aria-hidden="true">
              <path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            </svg>
            <div class="text-[12.5px] text-ink-2 leading-[1.45]">
              <strong class="text-warn"><%= t("account.pickup.geocoding_failed_title") %></strong>
              <span class="block mt-0.5"><%= t("account.pickup.geocoding_failed_hint") %></span>
            </div>
          </div>
        <% end %>
      </section>

      <%# Pagos — accepted methods, SPEI details, tip presets %>
      <section class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6"
               data-controller="payment-settings">
        <div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
            <%= t("account.sections.payment_kicker") %>
          </div>
          <h2 class="mt-1 font-serif text-[22px] leading-tight text-ink">
            <%= t("account.sections.payment_title") %>
          </h2>
          <p class="mt-1 text-[13px] text-ink-2"><%= t("account.sections.payment_lede") %></p>
        </div>

        <% ps = @account.payment_settings %>

        <div class="flex flex-col gap-3">
          <%# ── Efectivo ─────────────────────────────────────────── %>
          <div class="rounded-card-sm border border-line bg-bg-2/60">
            <label class="flex items-start gap-3 p-4 cursor-pointer">
              <input type="hidden" name="account[settings][payment_settings][accepts_cash]" value="0">
              <input type="checkbox" name="account[settings][payment_settings][accepts_cash]" value="1"
                     <%= "checked" if ps.accepts_cash %>
                     class="mt-[3px] w-4 h-4 accent-accent">
              <div class="flex-1 flex flex-col gap-1">
                <span class="text-[14px] font-medium text-ink"><%= t("account.payment.accepts_cash") %></span>
                <span class="text-[12px] text-muted"><%= t("account.payment.accepts_cash_hint") %></span>
              </div>
            </label>
          </div>

          <%# ── Transferencia ─────────────────────────────────────── %>
          <div class="rounded-card-sm border border-line bg-bg-2/60"
               data-payment-settings-target="transferGroup">
            <label class="flex items-start gap-3 p-4 cursor-pointer">
              <input type="hidden" name="account[settings][payment_settings][accepts_transfer]" value="0">
              <input type="checkbox" name="account[settings][payment_settings][accepts_transfer]" value="1"
                     <%= "checked" if ps.accepts_transfer %>
                     data-action="change->payment-settings#toggleTransfer"
                     data-payment-settings-target="transferToggle"
                     class="mt-[3px] w-4 h-4 accent-accent">
              <div class="flex-1 flex flex-col gap-1">
                <span class="text-[14px] font-medium text-ink"><%= t("account.payment.accepts_transfer") %></span>
                <span class="text-[12px] text-muted"><%= t("account.payment.accepts_transfer_hint") %></span>
              </div>
            </label>

            <div data-payment-settings-target="transferFields" class="<%= "hidden" unless ps.accepts_transfer %> px-4 pb-4 flex flex-col gap-3">
              <div class="border-t border-line pt-4 flex flex-col gap-3">
                <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
                  <%= t("account.payment.transfer_section") %>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div>
                    <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.payment.transfer_holder") %></label>
                    <input type="text" name="account[settings][payment_settings][transfer_holder]" value="<%= ps.transfer_holder %>"
                           placeholder="<%= t("account.payment.transfer_holder_placeholder") %>"
                           class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink">
                  </div>
                  <div>
                    <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.payment.transfer_bank") %></label>
                    <input type="text" name="account[settings][payment_settings][transfer_bank]" value="<%= ps.transfer_bank %>"
                           placeholder="<%= t("account.payment.transfer_bank_placeholder") %>"
                           class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink">
                  </div>
                </div>
                <div>
                  <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.payment.transfer_clabe") %></label>
                  <input type="text" name="account[settings][payment_settings][transfer_clabe]" value="<%= ps.transfer_clabe %>"
                         inputmode="numeric" maxlength="18" pattern="\d{18}"
                         placeholder="012345678901234567"
                         class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono tabular-nums">
                  <p class="mt-1 text-[11.5px] text-muted"><%= t("account.payment.clabe_hint") %></p>
                </div>
                <div>
                  <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.payment.transfer_account_number") %></label>
                  <input type="text" name="account[settings][payment_settings][transfer_account_number]" value="<%= ps.transfer_account_number %>"
                         inputmode="numeric"
                         placeholder="<%= t("account.payment.account_number_placeholder") %>"
                         class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink font-mono tabular-nums">
                  <p class="mt-1 text-[11.5px] text-muted"><%= t("account.payment.account_number_hint") %></p>
                </div>
              </div>
            </div>
          </div>

          <%# ── Tarjeta ───────────────────────────────────────────── %>
          <div class="rounded-card-sm border border-line bg-bg-2/60"
               data-payment-settings-target="cardGroup">
            <label class="flex items-start gap-3 p-4 cursor-pointer">
              <input type="hidden" name="account[settings][payment_settings][accepts_card]" value="0">
              <input type="checkbox" name="account[settings][payment_settings][accepts_card]" value="1"
                     <%= "checked" if ps.accepts_card %>
                     data-action="change->payment-settings#toggleCard"
                     data-payment-settings-target="cardToggle"
                     class="mt-[3px] w-4 h-4 accent-accent">
              <div class="flex-1 flex flex-col gap-1">
                <span class="text-[14px] font-medium text-ink"><%= t("account.payment.accepts_card") %></span>
                <span class="text-[12px] text-muted"><%= t("account.payment.accepts_card_hint") %></span>
              </div>
            </label>

            <div data-payment-settings-target="cardFields" class="<%= "hidden" unless ps.accepts_card %> px-4 pb-4">
              <div class="border-t border-line pt-4 flex flex-col gap-3">
                <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted">
                  <%= t("account.payment.card_section") %>
                </div>
                <div>
                  <label class="block text-[12px] font-medium text-muted mb-1"><%= t("account.payment.card_instructions_label") %></label>
                  <textarea name="account[settings][payment_settings][card_instructions]" rows="2"
                            placeholder="<%= t("account.payment.card_instructions_placeholder") %>"
                            class="w-full rounded-input border border-line bg-surface px-3 py-2 text-[14px] text-ink"><%= ps.card_instructions %></textarea>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# ── Propina ─────────────────────────────────────────────
            Toggle to opt out of collecting tips entirely. When OFF,
            the storefront checkout hides the propina card and the
            preset percentages stay persisted (re-enabling restores
            them) so the operator doesn't lose her configuration. %>
        <div class="rounded-card-sm border border-line bg-bg-2/60"
             data-controller="tips-toggle">
          <label class="flex items-start gap-3 p-4 cursor-pointer">
            <input type="hidden" name="account[settings][payment_settings][accepts_tips]" value="0">
            <input type="checkbox"
                   name="account[settings][payment_settings][accepts_tips]"
                   value="1"
                   <%= "checked" if ps.accepts_tips %>
                   data-action="change->tips-toggle#toggle"
                   data-tips-toggle-target="checkbox"
                   class="mt-[3px] w-4 h-4 accent-accent">
            <div class="flex-1 flex flex-col gap-1">
              <span class="text-[14px] font-medium text-ink"><%= t("account.payment.accepts_tips") %></span>
              <span class="text-[12px] text-muted"><%= t("account.payment.accepts_tips_hint") %></span>
            </div>
          </label>

          <div data-tips-toggle-target="presets"
               class="<%= "hidden" unless ps.accepts_tips %> px-4 pb-4">
            <div class="border-t border-line pt-4">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-muted mb-2">
                <%= t("account.payment.tip_presets_label") %>
              </div>
              <div class="grid grid-cols-3 gap-3">
                <% ps.tip_presets_pct.each do |pct| %>
                  <div>
                    <span class="relative flex items-center">
                      <input type="number" inputmode="numeric" min="1" max="100"
                             name="account[settings][payment_settings][tip_presets_pct][]"
                             value="<%= pct %>"
                             class="w-full bg-surface text-ink border border-line hover:border-line-2 rounded-input px-3 pr-8 py-2 text-[14px] leading-[1.3] font-mono tabular-nums outline-none focus:border-accent focus:ring-2 focus:ring-accent/20">
                      <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted font-mono text-[13px]">%</span>
                    </span>
                  </div>
                <% end %>
              </div>
              <p class="mt-2 text-[11.5px] text-muted"><%= t("account.payment.tip_presets_hint") %></p>
            </div>
          </div>
        </div>
      </section>

      <div class="flex items-center justify-start">
        <a href="<%= storefront_path(slug: @account.slug) %>" target="_blank" rel="noopener"
           class="inline-flex items-center gap-1.5 rounded-[9px] border border-line bg-surface px-3 py-1.5 text-[12.5px] font-medium text-ink-2 hover:border-line-2 no-underline">
          <%= t("account.view_storefront") %>
        </a>
      </div>
    <% end %>
  </div>

  <%# ================================================================
      RIGHT — sticky live preview (1 of 3 columns on lg+)
      Offset to clear the sticky panel top bar (~72px tall) plus a
      small gap, otherwise the preview header slides under it when
      the page scrolls.
      ================================================================ %>
  <aside class="lg:col-span-1 lg:sticky lg:top-[84px] w-full">
    <%= render Accounts::StorefrontPreviewComponent.new(account: @account) %>
  </aside>
</div>
