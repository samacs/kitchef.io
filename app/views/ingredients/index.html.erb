<% content_for :title, t("ingredients.index.title") %>
<% content_for :page_title, t("ingredients.index.title") %>
<% content_for :page_subtitle, t("ingredients.index.subtitle") %>

<% content_for :page_action do %>
  <%= link_to new_ingredient_path,
        class: "inline-flex items-center gap-2 text-[13px] font-semibold px-3.5 py-[8px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" do %>
    <%= icon(:plus, size: :xs) %>
    <span><%= t("ingredients.index.cta") %></span>
  <% end %>
<% end %>

<% if flash[:notice].present? %>
  <div class="mb-5">
    <%= render Ui::FlashComponent.new(kind: :notice, message: flash[:notice]) %>
  </div>
<% end %>
<% if flash[:alert].present? %>
  <div class="mb-5">
    <%= render Ui::FlashComponent.new(kind: :alert, message: flash[:alert], dismiss_after_ms: nil) %>
  </div>
<% end %>

<% if ingredients.empty? %>
  <%= render Recipes::EmptyStateComponent.new(
        headline_key: "ingredients.empty_state.headline",
        sub_key:      "ingredients.empty_state.sub",
        cta_label_key: "ingredients.empty_state.cta",
        cta_href: new_ingredient_path) %>
<% else %>
  <div class="flex flex-col gap-10">
    <% ingredients.group_by(&:category).each do |category, group| %>
      <section class="flex flex-col gap-4">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="font-serif text-[22px] leading-[1.15] tracking-[-0.01em] text-ink">
            <%= t("ingredient.categories.#{category}") %>
          </h2>
          <span class="font-mono text-[12px] text-muted uppercase tracking-[0.14em]">
            <%= t("ingredients.index.count", count: group.size) %>
          </span>
        </div>

        <div class="bg-surface border border-line rounded-panel shadow-card overflow-x-auto kc-scroll">
          <table class="w-full min-w-[720px]">
            <thead class="bg-bg-2/40 border-b border-line">
              <tr>
                <th class="px-4 py-2.5 text-left text-[11.5px] font-mono uppercase tracking-[0.14em] text-muted whitespace-nowrap"><%= t("ingredients.index.table.name") %></th>
                <th class="px-4 py-2.5 text-left text-[11.5px] font-mono uppercase tracking-[0.14em] text-muted whitespace-nowrap"><%= t("ingredients.index.table.price") %></th>
                <th class="px-4 py-2.5 text-left text-[11.5px] font-mono uppercase tracking-[0.14em] text-muted whitespace-nowrap"><%= t("ingredients.index.table.updated") %></th>
                <th class="px-4 py-2.5 text-right text-[11.5px] font-mono uppercase tracking-[0.14em] text-muted whitespace-nowrap"><%= t("ingredients.index.table.used_by") %></th>
                <th class="px-4 py-2.5 text-right text-[11.5px] font-mono uppercase tracking-[0.14em] text-muted whitespace-nowrap"></th>
              </tr>
            </thead>
            <tbody>
              <% group.each do |item| %>
                <%= render Ingredients::RowComponent.new(ingredient: item) %>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
