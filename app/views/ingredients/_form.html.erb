<% autosave = ingredient.persisted? %>
<%= form_with model: ingredient,
      url: ingredient.persisted? ? ingredient_path(ingredient) : ingredients_path,
      class: "flex flex-col gap-5",
      data: autosave ? { controller: "form-autosave", action: "change->form-autosave#save input->form-autosave#save" } : {} do |form| %>

  <% if ingredient.errors.any? %>
    <div role="alert"
         class="bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))] text-err border border-err/30 rounded-[10px] px-4 py-3 flex flex-col gap-1.5">
      <span class="text-[12px] font-mono uppercase tracking-[0.14em]">
        <%= t("onboarding.shared.errors_title") %>
      </span>
      <ul class="text-[13px] leading-[1.4] list-disc list-inside">
        <% ingredient.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if autosave %>
    <div class="flex justify-end -mb-2">
      <span
        data-form-autosave-target="status"
        data-label-saving="<%= t("account.autosave.saving") %>"
        data-label-saved="<%= t("account.autosave.saved") %>"
        data-label-error="<%= t("account.autosave.error") %>"
        class="hidden shrink-0 inline-flex items-center gap-1.5 rounded-full border border-line bg-bg-2 px-2.5 py-1 font-mono text-[11px] font-medium
               data-[state=saving]:text-muted
               data-[state=saved]:text-accent data-[state=saved]:border-accent/30 data-[state=saved]:bg-accent-soft
               data-[state=error]:text-err data-[state=error]:border-err/30 data-[state=error]:bg-[color-mix(in_oklab,var(--color-err)_10%,var(--color-surface))]"
        role="status"
        aria-live="polite"
      ></span>
    </div>
  <% end %>

  <%= render Ui::TextFieldComponent.new(
        name: "ingredient[name]",
        id: "ingredient_name",
        label: t("ingredients.form.name_label"),
        placeholder: t("ingredients.form.name_placeholder"),
        value: ingredient.name,
        required: true,
        maxlength: 80,
        autofocus: ingredient.new_record?) %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render Ui::ComboboxComponent.new(
          name: "ingredient[category_id]",
          id: "ingredient_category_id",
          label: t("ingredients.form.category_label"),
          options: Category.picker_options_for(account: Current.account, kind: :ingredient),
          value: ingredient.category_id,
          placeholder: t("ingredients.form.category_placeholder"),
          hint: t("ingredients.form.category_hint"),
          required: true,
          create_path: categories_path,
          create_params: { kind: "ingredient" },
          list_id: "combobox_ingredient_options") %>

    <label for="ingredient_unit" class="flex flex-col gap-2">
      <span class="text-[13px] font-medium text-ink leading-none">
        <%= t("ingredients.form.unit_label") %>
      </span>
      <%= form.select :unit,
            Ingredient::UNITS.map { |key| [ I18n.t("units.#{key}", default: key), key ] },
            {},
            id: "ingredient_unit",
            class: "w-full bg-surface text-ink border border-line hover:border-line-2 rounded-input px-3.5 py-2.5 text-[14px] leading-[1.3] transition-[border-color,box-shadow] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" %>
      <span class="text-[12px] text-muted"><%= t("ingredients.form.unit_hint") %></span>
    </label>
  </div>

  <% unless ingredient.persisted? && ingredient.supplier_ingredients.exists? %>
    <label for="ingredient_unit_cost" class="flex flex-col gap-2">
      <span class="text-[13px] font-medium text-ink leading-none">
        <%= t("ingredients.form.unit_cost_label") %>
      </span>
      <span class="relative flex items-center">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted font-mono pointer-events-none">$</span>
        <%= form.number_field :unit_cost,
              id: "ingredient_unit_cost",
              value: (ingredient.unit_cost_cents.to_i.zero? ? nil : format("%.2f", ingredient.unit_cost.to_f)),
              step: "0.01",
              min: 0,
              inputmode: "decimal",
              required: ingredient.new_record?,
              placeholder: t("ingredients.form.unit_cost_placeholder"),
              class: "w-full bg-surface text-ink placeholder:text-muted border border-line hover:border-line-2 rounded-input pl-7 pr-16 py-2.5 text-[14px] leading-[1.3] font-mono transition-[border-color,box-shadow] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20" %>
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted font-mono text-[12px]">MXN</span>
      </span>
      <span class="text-[12px] text-muted">
        <%= ingredient.persisted? ? t("ingredients.form.unit_cost_no_supplier_hint") : t("ingredients.form.unit_cost_hint") %>
      </span>
    </label>
  <% end %>

  <label for="ingredient_notes" class="flex flex-col gap-2">
    <span class="text-[13px] font-medium text-ink leading-none">
      <%= t("ingredients.form.notes_label") %>
    </span>
    <%= form.text_area :notes,
          id: "ingredient_notes",
          rows: 3,
          placeholder: t("ingredients.form.notes_placeholder"),
          class: "w-full bg-surface text-ink placeholder:text-muted border border-line hover:border-line-2 rounded-input px-3.5 py-2.5 text-[14px] leading-[1.5] transition-[border-color,box-shadow] outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 resize-y" %>
  </label>

  <% unless autosave %>
    <div class="flex items-center justify-between gap-3 pt-2">
      <%= link_to t("ingredients.form.cancel"),
            ingredients_path,
            class: "inline-flex items-center justify-center gap-2 text-[13px] font-medium px-4 py-[10px] rounded-button bg-transparent text-ink-2 border border-line hover:border-line-2 transition-colors" %>
      <%= form.submit t("ingredients.form.submit_create"),
            class: "inline-flex items-center justify-center gap-2 text-[14px] font-semibold px-[22px] py-[10px] rounded-button bg-accent text-bg border border-accent hover:bg-accent-2 hover:border-accent-2 transition-colors shadow-cta" %>
    </div>
  <% end %>
<% end %>
