<% content_for :mail_kitchen_name, @kitchen_name %>
<%= t(".greeting", first_name: @client.first_name.presence || "") %>

<%= t(".lede", kitchen_name: @kitchen_name) %>

--
<%= t(".when_label") %>:
<% if @order.dispatch_asap? %>
<%= t(".asap_label") %>
<% else %>
<%= l(@order.delivery_date, format: :long) rescue @order.delivery_date %><% if @order.delivery_start_time && @order.delivery_end_time %>
<%= @order.delivery_start_time_hhmm %>–<%= @order.delivery_end_time_hhmm %><% end %>
<% end %>

<% if @order.delivery_address.present? %>
<%= t(".where_label") %>:
<%= [ @order.delivery_address, @order.colonia, @order.city ].compact_blank.join(", ") %>

<% end %>
<%= t(".items_label") %>:
<% @order.items.each do |item| -%>
  · <%= item.recipe&.name %> × <%= item.quantity %> — <%= humanized_money_with_symbol(Money.new(item.unit_price_cents.to_i * item.quantity.to_d, "MXN")) %>
<% if item.has_customizations? %>    <%= item.display_options.join(" · ") %>
<% end -%>
<% end -%>

<% if @order.packaging_cents.to_i.positive? || @order.discount_cents.to_i.positive? || @order.tip_cents.to_i.positive? -%>
<%= t(".subtotal_label") %>: <%= humanized_money_with_symbol(@order.subtotal) %>
<% if @order.packaging_cents.to_i.positive? -%>
<%= t(".packaging_label") %>: <%= humanized_money_with_symbol(@order.packaging) %>
<% end -%>
<% if @order.discount_cents.to_i.positive? -%>
<%= @order.discount_label.presence || t(".discount_label") %>: −<%= humanized_money_with_symbol(@order.discount) %>
<% end -%>
<% if @order.tip_cents.to_i.positive? -%>
<%= t(".tip_label") %>: <%= humanized_money_with_symbol(@order.tip) %>
<% end -%>
<% end -%>
<%= t(".total_label") %>: <%= humanized_money_with_symbol(@order.total) %>

<%= t(".review_lede") %>
<%= t(".review_cta") %>: <%= @review_url %>

<% if @whatsapp_link.present? %>
<%= t(".whatsapp_cta", kitchen_name: @kitchen_name) %>
<%= @whatsapp_link %>
<% end %>
