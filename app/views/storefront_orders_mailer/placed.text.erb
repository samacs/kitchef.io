<%= t(".greeting", first_name: @client.first_name.presence || "") %>

<%= t(".lede", kitchen_name: @kitchen_name) %>

--
<%= t(".when_label") %>:
<%= l(@order.delivery_date, format: :long) rescue @order.delivery_date %><% if @order.delivery_start_time && @order.delivery_end_time %>
<%= @order.delivery_start_time_hhmm %>–<%= @order.delivery_end_time_hhmm %><% end %>

<% if @order.delivery_address.present? %>
<%= t(".where_label") %>:
<%= [ @order.delivery_address, @order.colonia, @order.city ].compact_blank.join(", ") %>

<% end %>
<%= t(".items_label") %>:
<% @order.items.each do |item| -%>
  · <%= item.recipe&.name %> × <%= item.quantity %> — <%= humanized_money_with_symbol(Money.new(item.unit_price_cents.to_i * item.quantity.to_d, "MXN")) %>
<% end -%>

<%= t(".total_label") %>: <%= humanized_money_with_symbol(@order.total) %>

<% if @self_confirm_url.present? %>
<%= t(".self_confirm_lede") %>
<%= t(".self_confirm_cta") %>: <%= @self_confirm_url %>

<% end %>
<% if @whatsapp_link.present? %>
<%= t(".whatsapp_cta", kitchen_name: @kitchen_name) %>
<%= @whatsapp_link %>

<% end %>
<%= t(".status_link") %>:
<%= @status_url %>

--
<%= t(".footer", kitchen_name: @kitchen_name) %>
