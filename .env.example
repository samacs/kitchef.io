# Copy this file to `.env` and adjust the values for your local environment.
# `.env` is gitignored — never commit real credentials.

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=kitchef
POSTGRES_PASSWORD=kitchef
POSTGRES_DB=kitchef_development
POSTGRES_PORT=5432
POSTGRES_MAJOR=18
DATABASE_URL=postgres://kitchef:kitchef@localhost:5432/kitchef_development

# --- Valkey (Redis-compatible; used by Sidekiq, cache, Action Cable) ---------
VALKEY_PORT=6379
VALKEY_MAJOR=9
VALKEY_URL=redis://localhost:6379/0

# --- Rails -------------------------------------------------------------------
# Generate with `bin/rails credentials:edit` on first use.
RAILS_MASTER_KEY=

# Salt for signing prefixed IDs (acc_, cli_, etc.). Generate with SecureRandom.hex(32).
PREFIXED_IDS_SALT=kitchef-dev-salt-replace-in-prod

# --- Google OAuth (optional; enables sign-up via Google) ---------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Stripe (subscription billing) -------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# --- Resend (transactional email in production) -----------------------------
RESEND_API_KEY=re_

# --- Twilio (optional; WhatsApp delivery) ------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- AWS S3 (image storage in production) ------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=kitchef-dev-uploads

# --- Observability -----------------------------------------------------------
# Leave empty in development — initializers no-op when the DSN/API key is blank.
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Local SSL (lvh.me, generated per-machine with mkcert) -------------------
# These default to ./ssl/ — only override if you keep certs elsewhere.
# SSL_CERT_FILE=./ssl/lvh.me.pem
# SSL_KEY_FILE=./ssl/lvh.me.key
